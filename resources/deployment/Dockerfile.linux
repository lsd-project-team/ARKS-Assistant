ARG PYTHON_IMAGE
ARG DOTNET_IMAGE
ARG DOCKER_IMAGE
FROM ${DOTNET_IMAGE} AS roslyn
WORKDIR /build
COPY backend/tools/SourceAnalysis/ ./
RUN mkdir /empty-packages && dotnet build SourceAnalysis.csproj -c Release --nologo \
    -p:NuGetAudit=false -p:RestoreSources=/empty-packages -o /helper

FROM ${DOCKER_IMAGE} AS dockercli
FROM ${PYTHON_IMAGE}
ENV PYTHONUTF8=1 PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    DOTNET_ROOT=/usr/share/dotnet DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1 DOTNET_NOLOGO=1 \
    DOTNET_CLI_WORKLOAD_UPDATE_NOTIFY_DISABLE=true \
    ARKS_DOTNET_PATH=/usr/share/dotnet/dotnet \
    ARKS_ROSLYN_HELPER=/opt/arks/backend/tools/SourceAnalysis/bin/Release/net8.0/SourceAnalysis.dll \
    TRUNK_AGENT_DATA_DIR=/var/lib/arks TRUNK_AGENT_WORKSPACE=/workspace \
    PATH=/opt/arks/backend/.venv/bin:/usr/local/bin:/usr/bin:/bin
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates libicu72 libgssapi-krb5-2 libstdc++6 zlib1g libgomp1 openssh-client git \
    && rm -rf /var/lib/apt/lists/*
COPY --from=roslyn /usr/share/dotnet/dotnet /usr/share/dotnet/dotnet
COPY --from=roslyn /usr/share/dotnet/host /usr/share/dotnet/host
COPY --from=roslyn /usr/share/dotnet/shared/Microsoft.NETCore.App /usr/share/dotnet/shared/Microsoft.NETCore.App
COPY --from=dockercli /usr/local/bin/docker /usr/local/bin/docker
WORKDIR /opt/arks/backend
COPY backend/pyproject.toml backend/uv.lock ./
RUN python -m pip install --no-cache-dir uv==0.11.16 \
    && UV_PYTHON_DOWNLOADS=never uv sync --frozen --no-dev --no-install-project --no-cache
COPY backend/app ./app
COPY backend/migrations ./migrations
COPY backend/alembic.ini ./alembic.ini
COPY --from=roslyn /helper ./tools/SourceAnalysis/bin/Release/net8.0
COPY frontend/dist /opt/arks/frontend/dist
COPY resources/knowledge /opt/arks/resources/knowledge
COPY resources/deployment/healthcheck.py /opt/arks/healthcheck.py
RUN /usr/sbin/groupadd --gid 10001 arks \
    && /usr/sbin/useradd --uid 10001 --gid arks --no-create-home arks \
    && mkdir -p /var/lib/arks /workspace /home/arks /opt/arks/.tools/embedding-models \
    && chown 10001:10001 /var/lib/arks /workspace /home/arks /opt/arks/.tools/embedding-models
ENV HOME=/home/arks
USER 10001:10001
EXPOSE 8765
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD ["python", "/opt/arks/healthcheck.py"]
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8765", "--no-proxy-headers"]
