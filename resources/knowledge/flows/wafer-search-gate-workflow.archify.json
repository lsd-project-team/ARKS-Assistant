{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "ZX2200 四种搜晶路径、结束出口与供晶许可",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "subtitle": "按当前源码分别阅读各条件路径；各行不表示统一生产顺序"
  },
  "lanes": [
    {
      "id": "dispatch",
      "label": "四种搜索模式分别分派，不共用一个统一停止门"
    },
    {
      "id": "early",
      "label": "Single 提前 false：这条分支不经过后面的 StopSearch"
    },
    {
      "id": "single",
      "label": "Single 有点定位：跳过时重搜，不跳过才进入取晶中心"
    },
    {
      "id": "nine",
      "label": "Nine：入口先检查停止，缓存命中与重新计算不同"
    },
    {
      "id": "nine-empty",
      "label": "Nine 的普通 false 不设置换料；计数结束异常是另一出口"
    },
    {
      "id": "mapping",
      "label": "地图：只实现 Standard 单点，过桥或跳过回循环"
    },
    {
      "id": "map-end",
      "label": "地图无可达芯片：可缓存末尾参考点，否则请求换片"
    },
    {
      "id": "box",
      "label": "Box：按索引跳过非 Good 槽，定位跳过也会推进索引"
    },
    {
      "id": "change",
      "label": "地图缓存影响有效换料条件，原始标记不等于最终判断"
    },
    {
      "id": "permit",
      "label": "NextDie 正常返回后的发布：这里没有统一再次 StopSearch"
    },
    {
      "id": "stopped",
      "label": "StopSearch 遇停止：默认先请求顶针处理，再抛异常"
    }
  ],
