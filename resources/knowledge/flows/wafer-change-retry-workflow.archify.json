      "id": "dry",
      "label": "DryCycle：后处理 bool 返回值在这个分支被忽略"
    },
    {
      "id": "layer",
      "label": "启用料仓、非静态：先选层，机械换片不是每次必经"
    },
    {
      "id": "operation",
      "label": "料仓公共 Operation：false 只重复后处理，不重新选层"
    },
    {
      "id": "static",
      "label": "静态适配器缺所需槽：false 重开静态向导"
    },
    {
      "id": "manual",
      "label": "无料仓：后处理 false 回 ChangeMap，重新进行换料交互"
    },
    {
      "id": "unsupported",
      "label": "后处理不支持的模式与异常，不统一转换成 false"
    }
