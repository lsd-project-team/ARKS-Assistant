  "meta": {
    "title": "ZX2200 自动换料：路径选择与三个重试入口",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "subtitle": "按当前源码分别阅读各条件路径；各行不表示统一生产顺序"
