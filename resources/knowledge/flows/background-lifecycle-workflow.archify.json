{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "ZX2200 后台监控与退出",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "animation": "none",
    "viewBox": [
      1100,
      650
    ]
  },
  "lanes": [
    {
      "id": "runtime",
      "label": "设备后台：串行检查"
    },
    {
      "id": "consumer",
      "label": "独立线程：队列消费者"
    },
    {
      "id": "shutdown",
      "label": "退出：人工关闭与边界"
    }
  ],
  "mainPath": [
    "ready",
    "checks",
    "workers",
    "sleep"
  ],
  "nodes": [
    {
      "id": "ready",
      "lane": "runtime",
      "col": 0,
      "type": "frontend",
      "label": "主窗体加载通过",
      "sublabel": "MainForm_Load"
    },
    {
      "id": "checks",
      "lane": "runtime",
      "col": 1,
      "type": "security",
      "label": "依次检查设备状态",
      "sublabel": "门→尺→账户→温度→耗材→传感器",
      "width": 160
    },
    {
      "id": "workers",
      "lane": "runtime",
      "col": 2,
      "type": "backend",
      "label": "确保存储线程启动",
      "sublabel": "仅不存在或未存活时创建",
      "width": 160
    },
    {
      "id": "sleep",
      "lane": "runtime",
      "col": 3,
      "type": "backend",
      "label": "本轮休眠100ms",
      "sublabel": "ThreadFlag为真则下一轮",
      "width": 160
    },
    {
      "id": "image",
      "lane": "consumer",
      "col": 2,
      "type": "messagebus",
      "label": "图片队列消费",
      "sublabel": "Take → Save(Bmp) → Dispose",
      "width": 160
    },
    {
      "id": "database",
      "lane": "consumer",
      "col": 3,
      "type": "database",
      "label": "数据库队列消费",
      "sublabel": "Take → 类型判断 → Insert",
      "width": 160
    },
    {
      "id": "reaction",
      "lane": "consumer",
      "col": 1,
      "type": "security",
      "label": "暂停 / 停止 / 提示",
