  "cards": [
    {
      "dot": "amber",
      "title": "可追溯范围",
      "items": [
        "依据 auth-background / auth-form-close / auth-exit 等源码快照。",
        "详见 authorization-background-source-review.md；未实机验收。"
      ]
    },
    {
      "dot": "rose",
      "title": "不能据此保证",
      "items": [
        "后台每轮无总catch；100ms不是固定扫描周期。",
        "保存队列无显式排空；进程退出码0不等于保存成功。"
      ]
    }
  ]
