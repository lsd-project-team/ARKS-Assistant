      "width": 160
    },
    {
      "id": "closing",
      "lane": "shutdown",
      "col": 0,
      "type": "frontend",
      "label": "人工关闭请求",
      "sublabel": "非Stop则阻止关闭"
    },
    {
      "id": "cleanup",
      "lane": "shutdown",
      "col": 1,
      "type": "backend",
      "label": "保存与硬件关闭",
      "sublabel": "异常被吞掉；未排空队列",
      "width": 160
    },
    {
      "id": "exit",
      "lane": "shutdown",
      "col": 2,
      "type": "external",
      "label": "退出进程",
      "sublabel": "Environment.Exit(0)"
    }
  ],
  "edges": [
    {
      "from": "ready",
      "to": "checks",
      "label": "启动后台"
    },
    {
      "from": "checks",
      "to": "workers"
    },
    {
      "from": "workers",
      "to": "sleep"
    },
    {
      "from": "sleep",
      "to": "checks",
      "label": "循环条件仍真"
    },
    {
      "from": "checks",
      "to": "reaction",
      "label": "条件触发"
    },
    {
      "from": "workers",
      "to": "image",
      "label": "独立线程"
    },
    {
      "from": "workers",
      "to": "database",
      "label": "独立线程"
    },
    {
      "from": "closing",
      "to": "cleanup",
      "label": "Stop且窗体已关闭"
    },
    {
      "from": "cleanup",
      "to": "exit"
    }
