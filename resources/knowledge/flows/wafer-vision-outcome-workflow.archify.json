{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "ZX2200 供晶视觉：门控、报警与精度回退边界",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "subtitle": "依据当前生产源码分别比较正常、跳过、重试与异常出口"
  },
  "lanes": [
    {
      "id": "skip",
      "label": "MatchResult 离线/空跑入口：不执行在线采图和定位"
    },
    {
      "id": "wait",
      "label": "晶圆相机避让：八秒仅记日志重计时，不是整体超时失败"
    },
    {
      "id": "ink",
      "label": "有效定位且非过桥的墨点处理：数量规则与人工跳过"
    },
    {
      "id": "blank",
      "label": "定位或框架门失败：空白未到上限时自动跳过"
    },
    {
      "id": "alarm",
      "label": "视觉报警 Retry 表示提前换片；OK/Cancel 才回定位"
    },
    {
      "id": "precision",
      "label": "多次定位精度判断：未达标未到上限才移动重搜"
    },
    {
      "id": "accuracy-alarm",
      "label": "多次定位失败的 OK：读取 null，不是相机中心回退"
    },
    {
      "id": "bitmap",
      "label": "Nine 复用图片，PR Bitmap 重载正常结束会释放输入"
    }
  ],
  "nodes": [
    {
      "id": "offline",
      "lane": "skip",
      "col": 0,
      "type": "backend",
      "label": "离线或空跑",
      "sublabel": "MatchResult 的提前分支",
      "width": 180
    },
    {
      "id": "center-result",
      "lane": "skip",
      "col": 1,
      "type": "backend",
      "label": "相机中心单元素数组",
      "sublabel": "像素 (1224,1024,0)",
      "width": 180
    },
    {
      "id": "skip-true",
      "lane": "skip",
      "col": 2,
      "type": "backend",
      "label": "直接 true",
      "sublabel": "不是实际采图成功",
      "width": 180
    },
    {
      "id": "wafer-wait",
      "lane": "wait",
      "col": 0,
      "type": "backend",
      "label": "晶圆相机未允许动作",
      "sublabel": "仅 isCheckBondPos=true",
      "width": 180
    },
    {
      "id": "wait-log",
      "lane": "wait",
      "col": 1,
      "type": "backend",
      "label": "超过八秒记日志",
      "sublabel": "Restart；退出代码注释",
      "width": 180
    },
    {
      "id": "wait-continue",
      "lane": "wait",
      "col": 2,
      "type": "backend",
      "label": "StopSearch 后继续等",
      "sublabel": "停止可抛异常；无总体期限",
      "width": 180
    },
    {
      "id": "ink-result",
      "lane": "ink",
      "col": 0,
      "type": "backend",
      "label": "BlobResult 返回 true",
      "sublabel": "数量区间内可 false；PR 失败 true",
      "width": 180
    },
    {
      "id": "ink-choice",
      "lane": "ink",
      "col": 1,
      "type": "backend",
      "label": "自动 / 人工 Ignore",
      "sublabel": "OK 不跳过；Abort 抛异常",
      "width": 180
    },
    {
      "id": "ink-skip",
      "lane": "ink",
      "col": 2,
      "type": "backend",
      "label": "跳过并返相机中心",
