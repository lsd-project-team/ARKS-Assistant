      "width": 180
    },
    {
      "id": "empty-result",
      "lane": "blank",
      "col": 0,
      "type": "backend",
      "label": "无有效定位结果",
      "sublabel": "不是每次都弹人工报警",
      "width": 180
    },
    {
      "id": "empty-count",
      "lane": "blank",
      "col": 1,
      "type": "backend",
      "label": "自动跳过且未到上限",
      "sublabel": "下次计数仍小于上限",
      "width": 180
    },
    {
      "id": "empty-skip",
      "lane": "blank",
      "col": 2,
      "type": "backend",
      "label": "空白加一、跳过",
      "sublabel": "返回相机中心占位",
      "width": 180
    },
    {
      "id": "vision-alarm",
      "lane": "alarm",
      "col": 0,
      "type": "backend",
      "label": "VisionAlarmFunc",
      "sublabel": "非过桥、空白门控后进入",
      "width": 180
    },
    {
      "id": "alarm-retry",
      "lane": "alarm",
      "col": 1,
      "type": "backend",
      "label": "DialogResult.Retry",
      "sublabel": "isSkip 与提前换片标记 true",
      "width": 180
    },
    {
      "id": "single-change",
      "lane": "alarm",
      "col": 2,
      "type": "backend",
      "label": "Single 下轮入口消费",
