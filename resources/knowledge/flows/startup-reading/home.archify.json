{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "AllAxisGoHome 的正常返回路径",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "output": "resources/knowledge/flows/startup-reading/home.html",
    "legend": {
      "mode": "auto",
      "entries": {
        "frontend": {
          "label": "界面 / 入口"
        },
        "backend": {
          "label": "程序动作"
        },
        "security": {
          "label": "条件 / 返回"
        },
        "messagebus": {
          "label": "任务调用"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "execution",
      "label": "确认与回零"
    },
    {
      "id": "result",
      "label": "返回结果"
    }
  ],
  "nodes": [
    {
      "id": "home-confirm",
      "lane": "execution",
      "col": 0,
      "type": "security",
      "label": "确认回零?"
    },
    {
      "id": "home-prepare",
      "lane": "execution",
      "col": 1,
      "type": "backend",
      "label": "准备回零"
    },
    {
      "id": "home-check",
      "lane": "execution",
      "col": 2,
      "type": "security",
      "label": "轴回零成功?"
    },
    {
      "id": "home-success",
      "lane": "result",
      "col": 2,
      "type": "backend",
      "label": "设置回零标记"
    },
    {
      "id": "home-failed",
      "lane": "result",
      "col": 0,
      "type": "security",
      "label": "返回 false"
    }
  ],
  "edges": [
    {
      "id": "home-confirm-to-home-prepare",
      "from": "home-confirm",
      "to": "home-prepare",
      "label": "OK"
    },
    {
      "id": "home-confirm-to-home-failed",
      "from": "home-confirm",
      "to": "home-failed",
      "label": "取消",
      "variant": "security"
    },
    {
      "id": "home-prepare-to-home-check",
      "from": "home-prepare",
      "to": "home-check",
      "label": "OneKeyHome"
    },
    {
      "id": "home-check-to-home-success",
      "from": "home-check",
      "to": "home-success",
      "label": "true",
      "variant": "emphasis"
    },
    {
      "id": "home-check-to-home-failed",
      "from": "home-check",
      "to": "home-failed",
      "label": "false",
      "variant": "security"
    }
  ]
}
