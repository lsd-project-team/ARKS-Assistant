      "from": "calc",
      "to": "apply",
      "label": "XY / T / Z 偏移"
    },
    {
      "id": "pr-save",
      "from": "pr",
      "to": "save",
      "label": "图片队列",
      "role": "async",
      "variant": "dashed"
