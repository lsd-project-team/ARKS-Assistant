  "cards": [
    {
      "dot": "cyan",
      "title": "两种Retry不可混同",
      "items": [
        "动作Retry重选消息；Alarm Retry直接重做当前动作。",
        "Ignore标调度完成，不代表动作质量合格。"
      ]
    },
    {
      "dot": "amber",
      "title": "状态不是退出确认",
      "items": [
        "Pause/Continue不统一挂起或重建任务。",
        "普通Stop和Abort方法都不能证明所有线程退出。"
      ]
    }
  ]
