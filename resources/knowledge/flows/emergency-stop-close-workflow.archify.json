{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "ZX2200 急停、Stop 与任务关闭边界",
    "locale": "zh-CN",
    "quality_profile": "showcase"
  },
  "lanes": [
    { "id": "entry", "label": "急停入口" },
    { "id": "stop", "label": "机器停止" },
    { "id": "dispense", "label": "S1 任务" },
    { "id": "bond", "label": "S2 任务" },
    { "id": "wafer", "label": "供晶任务" },
    { "id": "result", "label": "关闭判定" }
  ],
  "nodes": [
    { "id": "emergency", "lane": "entry", "col": 0, "type": "security", "label": "急停入口", "sublabel": "EmergencyStop", "width": 145 },
    { "id": "axes", "lane": "stop", "col": 1, "type": "external", "label": "Parallel 停轴", "sublabel": "StopMove(false, true)", "width": 145 },
    { "id": "machineStop", "lane": "stop", "col": 2, "type": "backend", "label": "Machine.Stop", "sublabel": "状态与信号清理", "width": 145 },
    { "id": "stopState", "lane": "stop", "col": 3, "type": "security", "label": "Stop 状态与信号", "sublabel": "SetState / 单步 / 需料", "width": 145 },
    { "id": "s1", "lane": "dispense", "col": 4, "type": "backend", "label": "S1 AbortThread", "sublabel": "Dispose 点胶 Task", "width": 145 },
    { "id": "s2", "lane": "bond", "col": 4, "type": "backend", "label": "S2 AbortThread", "sublabel": "源码为空方法", "width": 145 },
    { "id": "wafer", "lane": "wafer", "col": 4, "type": "backend", "label": "AbortWaferSubThread", "sublabel": "仅注释，无取消", "width": 145 },
    { "id": "closed", "lane": "result", "col": 5, "type": "security", "label": "IsAllowTaskClosed", "sublabel": "只有 Running 阻断", "width": 145 }
  ],
  "edges": [
    { "id": "emergency-axes", "from": "emergency", "to": "axes", "label": "急停", "role": "main" },
    { "id": "axes-stop", "from": "axes", "to": "machineStop", "label": "停轴完成", "role": "main" },
    { "id": "stop-state", "from": "machineStop", "to": "stopState", "label": "进入 Stop", "role": "main" },
    { "id": "state-s1", "from": "stopState", "to": "s1", "label": "按顺序 Abort", "role": "main" },
    { "id": "s1-s2", "from": "s1", "to": "s2", "label": "S1 释放成功", "role": "return" },
    { "id": "s2-wafer", "from": "s2", "to": "wafer", "label": "继续 Abort", "role": "return" },
    { "id": "wafer-closed", "from": "wafer", "to": "closed", "label": "查询关闭", "role": "main" }
  ],
  "mainPath": ["emergency", "axes", "machineStop", "stopState", "s1", "s2", "wafer", "closed"],
  "cards": [
    { "dot": "amber", "title": "异常截断", "items": ["未完成的 S1 Task 调用 Dispose 可能抛异常，后续 S2 与供晶 Abort 不再调用。", "Machine.Stop 任一清理步骤抛异常都会中断剩余 Stop 清理；轴异常也可能让 Stop 和三个 Abort 都不执行。"] },
    { "dot": "cyan", "title": "关闭语义", "items": ["S2 AbortThread 为空、供晶 Abort 只有注释，Running 任务可继续存活。", "IsAllowTaskClosed 只拒绝 Running；未完成但尚未 Running 的 Task 仍可能放行关闭。证据：emergency-abort-review.md、machine-stop-signal-review.md、task-closure-review.md。"] }
  ]
}
