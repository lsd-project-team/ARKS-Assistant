{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "料仓握手：正常交互与异常等待",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "column_fit": "spread",
    "viewBox": [
      1400,
      710
    ]
  },
  "participants": [
    {
      "id": "bin-worker",
      "type": "backend",
      "label": "上下料仓任务"
    },
    {
      "id": "handshake",
      "type": "messagebus",
      "label": "四个 Signal 对象"
    },
    {
      "id": "transport-worker",
      "type": "backend",
      "label": "输送任务"
    },
    {
      "id": "machine-state",
      "type": "backend",
      "label": "MachineState"
    }
  ],
  "segments": [
    {
      "from": 153,
      "to": 406,
      "label": "场景 A：正常握手（上/下料对称，动作不同）"
    },
    {
      "from": 432,
      "to": 654,
      "label": "场景 B：料仓异常未 Set；之后另有 Stop"
    }
  ],
  "messages": [
    {
      "id": "bin-ready",
      "from": "bin-worker",
      "to": "handshake",
      "y": 180,
      "label": "就位后 Set 允许推料",
      "note": "binmissing-loader-worker / binmissing-unloader-worker；异常跳过此Set。"
    },
    {
      "id": "await-ready",
      "from": "transport-worker",
      "to": "handshake",
      "y": 230,
      "label": "Wait 允许推料",
      "note": "binwait-loader-consumer:375 / binwait-unloader-consumer:677。"
    },
    {
      "id": "ready-return",
      "from": "handshake",
      "to": "transport-worker",
      "y": 280,
      "label": "事件满足 → true",
      "variant": "return",
      "note": "binwait-wait:116–145；ManualReset不会因消费自动清除。"
    },
    {
      "id": "advance-bin",
      "from": "transport-worker",
      "to": "handshake",
      "y": 330,
      "label": "分派后 Reset 推料；Set 允许移动",
      "note": "NoStart走continue，不进入这里；Abort/Exception停止返回。上下料时序细节见专题。"
    },
    {
      "id": "bin-await-move",
      "from": "bin-worker",
      "to": "handshake",
      "y": 380,
      "label": "Wait 允许移动；随后换层",
      "note": "上料MoveToNextPlaceLayer；下料MoveToCurrentPlaceLayer。"
    },
    {
      "id": "missing-ready",
      "from": "transport-worker",
      "to": "handshake",
      "y": 460,
      "label": "生产者未 Set → Wait 轮询",
      "note": "条件：事件未置位且没有其他来源改变结果；100ms是单次轮询，不是整体超时。"
    },
    {
      "id": "poll-stop",
      "from": "handshake",
      "to": "machine-state",
      "y": 510,
      "label": "每轮读取是否 Stop",
      "note": "binwait-wait：循环仅检查Stop，不再次检查Pause。"
    },
    {
      "id": "stop-observed",
      "from": "machine-state",
      "to": "handshake",
      "y": 560,
      "label": "观察到 Stop（状态读取）",
      "variant": "return",
      "note": "不是推送通知，也不保证所有并发任务已观察同一次Stop；无Stop可继续等待。"
    },
    {
      "id": "wait-exits",
      "from": "handshake",
      "to": "transport-worker",
      "y": 610,
      "label": "Wait 返回 false → 当前任务退出",
      "variant": "return",
      "note": "binwait-loader-consumer / binwait-unloader-consumer。不是全机任务完成通知。"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "源码范围",
      "items": [
        "四信号：AllowMove 为 AutoReset；AllowPush 为 ManualReset",
        "上下料动作不同；两段是条件场景，不是一条必然连续实机记录",
        "源码与行号：bin-failure-handshake-recovery-review.md"
      ]
    },
    {
      "dot": "orange",
      "title": "异常边界",
      "items": [
        "料仓 catch 仅提示；没有显式 Stop 或补发信号",
        "生产者退出 + 未 Set + 设备仍 Working：等待无整体期限",
        "NoStart 保留允许推料信号，延时后重试"
      ]
    },
    {
      "dot": "emerald",
      "title": "恢复限制",
      "items": [
        "Stop 供等待循环观察；没有 join 全部任务",
        "Continue 仅改变状态，不重建已退出任务",
        "重新 Start 先复位信号，再检查是否仍有 Running 任务"
      ]
    }
  ]
}
