  "cards": [
    {
      "dot": "cyan",
      "title": "编排和执行分开理解",
      "items": [
        "Init 先按配置编排；图中类别只是已选动作的分组。",
        "每条消息单独执行或跳过；蘸胶插入顺序由翻转与 DipMode 决定。"
      ]
    },
    {
      "dot": "amber",
      "title": "收尾不等于全部成功",
      "items": [
        "Enable=false、内层 WaitStart=false 也可进入收尾。",
        "Finish 重置消息；无匹配动作也可返回 null；物理下料另由流道执行。"
      ]
    },
    {
      "dot": "amber",
      "title": "胶盘独立并发",
      "items": [
        "伸出→允许蘸胶→等蘸胶完成→缩回→等再次允许。",
        "区域等待超时可续等；部分 return 没有统一 finally。"
      ]
    }
  ]
