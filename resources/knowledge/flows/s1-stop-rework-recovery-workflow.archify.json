{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "ZX2200 S1 停止、重启与返工恢复",
    "locale": "zh-CN",
    "quality_profile": "showcase"
  },
  "lanes": [
    { "id": "task", "label": "S1 任务" },
    { "id": "gate", "label": "停止与返工控制" },
    { "id": "action", "label": "重新执行" },
    { "id": "outcome", "label": "结果与信号" }
  ],
  "nodes": [
    { "id": "start", "lane": "task", "col": 0, "type": "backend", "label": "S1.Start", "sublabel": "进入已配置点胶步骤", "width": 145 },
    { "id": "dispense", "lane": "task", "col": 1, "type": "external", "label": "点胶 DoWork", "sublabel": "步骤先被置为 true", "width": 145 },
    { "id": "wait", "lane": "gate", "col": 2, "type": "security", "label": "WaitSingleStep", "sublabel": "任务在单步等待", "width": 145 },
    { "id": "stop", "lane": "gate", "col": 3, "type": "security", "label": "Machine.Stop", "sublabel": "释放等待并清理信号", "width": 145 },
    { "id": "abort", "lane": "outcome", "col": 3, "type": "security", "label": "Abort / 任务结束", "sublabel": "当前消息仍未完成", "width": 145 },
    { "id": "restart", "lane": "task", "col": 4, "type": "backend", "label": "再次 Start", "sublabel": "替换旧 Task", "width": 145 },
    { "id": "retain", "lane": "task", "col": 5, "type": "backend", "label": "业务步骤仍为 true", "sublabel": "InjectSteps 不回滚已有值", "width": 145 },
    { "id": "signal", "lane": "outcome", "col": 5, "type": "messagebus", "label": "S1→S2 放行信号", "sublabel": "跳过新业务 DoWork", "width": 145 },
    { "id": "rework", "lane": "gate", "col": 4, "type": "security", "label": "SetProcessUnable", "sublabel": "返工时重置剩余步骤", "width": 145 },
    { "id": "redo", "lane": "action", "col": 4, "type": "external", "label": "重新执行点胶", "sublabel": "恢复后再次进入 DoWork", "width": 145 },
    { "id": "fail", "lane": "gate", "col": 5, "type": "security", "label": "WaitStart 返回 Fail", "sublabel": "Stop 门控结束任务", "width": 145 }
  ],
  "edges": [
    { "id": "start-dispense", "from": "start", "to": "dispense", "label": "取到步骤", "role": "main" },
    { "id": "dispense-wait", "from": "dispense", "to": "wait", "label": "进入单步等待", "role": "main" },
    { "id": "wait-stop", "from": "wait", "to": "stop", "label": "停止", "role": "main" },
    { "id": "stop-abort", "from": "stop", "to": "abort", "label": "释放等待", "role": "return" },
    { "id": "abort-restart", "from": "abort", "to": "restart", "label": "重启", "role": "branch" },
    { "id": "restart-retain", "from": "restart", "to": "retain", "label": "重建消息", "role": "main" },
    { "id": "retain-signal", "from": "retain", "to": "signal", "label": "GetNext=null", "role": "main" },
    { "id": "retain-rework", "from": "retain", "to": "rework", "label": "返工请求", "role": "branch" },
    { "id": "rework-redo", "from": "rework", "to": "redo", "label": "步骤变 false", "role": "return" },
    { "id": "redo-fail", "from": "redo", "to": "fail", "label": "Stop 后失败", "role": "error" }
  ],
  "mainPath": ["start", "dispense", "wait", "stop", "abort"],
  "cards": [
    { "dot": "amber", "title": "状态边界", "items": ["SetActionNodeReWork 只重置匹配消息，不回滚业务步骤字典；ProductFinish 也不清步骤完成值。", "重启可在没有新业务 DoWork 的情况下直接发送 S1→S2 放行信号。"] },
    { "dot": "cyan", "title": "证据范围", "items": ["native-s1-stop-recovery-review.md。", "重置后的检测 Retry、完整在线点胶、UI/SQL、设备和原工程构建仍未验收。"] }
  ]
}
