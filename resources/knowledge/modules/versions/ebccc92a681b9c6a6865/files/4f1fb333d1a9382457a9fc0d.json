ngleForVisionCenterAndComponentCenter { get; set; } = 0;\r\n\r\n\r\n        /// <summary>\r\n        /// P1模板定位点(焊后保存相对Module坐标)\r\n        /// </summary>\r\n        public AKRSPoint3D P1VisionMatchResultInModule { get; set; } = new AKRSPoint3D();\r\n\r\n        /// <summary>\r\n        /// P1 Reference名称\r\n        /// </summary>\r\n        public string P1ReferName { get; set; } = string.Empty;\r\n\r\n        /// <summary>\r\n        /// P1 Reference视觉位置(焊后保存相对Module坐标)\r\n        /// </summary>\r\n        public AKRSPoint3D P1ReferVisionPos { get; set; } = new AKRSPoint3D();\r\n        \r\n        /// <summary>\r\n        /// P1 Reference模板定位结果(焊后保存相对Module坐标)\r\n        /// </summary>\r\n        public AKRSPoint3D P1ReferVisionMatchResultInModule { get; set; } = new AKRSPoint3D();\r\n\r\n        /// <summary>\r\n        /// P2 PR名称\r\n        /// </summary>\r\n        public string P2PRName { get; set; }  = string.Empty;\r\n\r\n        /// <summary>\r\n        /// P2视觉位置\r\n        /// </summary>\r\n        public AKRSPoint3D P2VisionPos { get; set; } = new AKRSPoint3D();\r\n\r\n        /// <summary>\r\n        /// P2模板定位结果G0\r\n        /// </summary>\r\n        public AKRSPoint3D P2VisionMatchResultInModule { get; set; } = new AKRSPoint3D();\r\n\r\n        /// <summary>\r\n        /// P2 Reference名称\r\n        /// </summary>\r\n        public string P2ReferName { get; set; } = string.Empty;\r\n\r\n        /// <summary>\r\n        /// P2 ReferenceG0视觉位置   (焊后保存相对位置)\r\n        /// </summary>\r\n        public AKRSPoint3D P2ReferVisionPos { get; set; } = new AKRSPoint3D();\r\n\r\n        /// <summary>\r\n        /// P2 Reference模板定位结果G0\r\n        /// </summary>\r\n        public AKRSPoint3D P2ReferVisionMatchResultInModule { get; set; } = new AKRSPoint3D();\r\n\r\n        /// <summary>\r\n        /// P1 PR名称\r\n        /// </summary>\r\n        public string BacsideCrackDetectPRName { get; set; } = string.Empty;\r\n\r\n        /// <summary>\r\n        /// 识别CodeVision的PR名称\r\n        /// </summary>\r\n        public string CodeVisionPRName { get; set; } = string.Empty;\r\n\r\n        /// <summary>\r\n        /// 识别CodeVision的视觉位置\r\n        /// </summary>\r\n        public AKRSPoint3D CodeVisionPRPos { get; set; } = new AKRSPoint3D();\r\n\r\n        /// <summary>\r\n        /// 定位1使用情况\r\n        /// </summary>\r\n        public LocateUseConfig LocateUseConfig1 { get; set; } = new LocateUseConfig();\r\n\r\n        /// <summary>\r\n        /// 定位2使用情况\r\n        /// </summary>\r\n        public LocateUseConfig LocateUseConfig2 { get; set; } = new LocateUseConfig();\r\n    }\r\n}\r\n","lineCount":136,"compileIncluded":true,"assemblies":["AKRS.ZX2200"],"declarations":[{"symbolId":"14b12d8189a6f9b7e42e3146","fileId":"4f1fb333d1a9382457a9fc0d","start":31,"end":134,"syntaxKind":"ClassDeclaration","label":"AKRS.ZX2200.Infrastructure.Models.CommonModels.AdjustConfig","name":"AdjustConfig","kind":"NamedType"},{"symbolId":"ddb55bf0f26580fac087e14b","fileId":"4f1fb333d1a9382457a9fc0d","start":37,"end":37,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.Infrastructure.Models.CommonModels.AdjustConfig.P1PRName","name":"P1PRName","kind":"Property"},{"symbolId":"4c43fc68ed60dad7461d66e9","fileId":"4f1fb333d1a9382457a9fc0d","start":37,"end":37,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.ZX2200.Infrastructure.Models.CommonModels.AdjustConfig.get_P1PRName","name":"get_P1PRName","kind":"Method"},{"symbolId":"a6a0b566a17268f51effac3d","fileId":"4f1fb333d1a9382457a9fc0d","start":37,"end":37,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.ZX2200.Infrastructure.Models.CommonModels.AdjustConfig.set_P1PRName(System.String)","name":"set_P1PRName","kind":"Method"},{"symbolId":"f6cf038f952b39aaaba9d512","fileId":"4f1fb333d1a9382457a9fc0d","start":42,"end":42,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.Infrastructure.Models.CommonModels.AdjustConfig.P1VisionPos","name":"P1VisionPos","kind":"Property"},{"symbolId":"6e738c