{"id":"b5bd8f7a4749d46d3bafe0f9","path":"trunk/AKRS.ZX2200/SupportFeature/Parameters/Models/SearchResult.cs","moduleId":"4bfb2af86705bab1cd13ce82","sha256":"b3e6e9b3b16fc460fe83d94e9ac937ffd4f33169a60a539134b9f999192202ee","baselineSha256":"b3e6e9b3b16fc460fe83d94e9ac937ffd4f33169a60a539134b9f999192202ee","current":true,"exists":true,"encoding":"utf-8","code":"using System.Collections.Generic;\r\nusing AKRS.ZX2200.SupportFeature.Parameters.Model;\r\n\r\nnamespace AKRS.ZX2200.SupportFeature.Parameters.Models;\r\n\r\n/// <summary>\r\n/// 搜索结果模型\r\n/// </summary>\r\npublic class SearchResult\r\n{\r\n    /// <summary>\r\n    /// 搜索结果索引\r\n    /// </summary>\r\n    public int Index { get; set; }\r\n\r\n    /// <summary>\r\n    /// 组节点类型\r\n    /// </summary>\r\n    public TreeGroupChildNodesEnum GroupNodeType { get; set; }\r\n\r\n    /// <summary>\r\n    /// 参数组节点下的参数详细模型列表\r\n    /// </summary>\r\n    public List<ParameterDetailModel> ParamDetailNodes { get; set; }\r\n\r\n    /// <summary>\r\n    /// 当前选中的节点\r\n    /// </summary>\r\n    public ParameterDetailModel CurrentSelectedNode { get; set; }\r\n\r\n    /// <summary>\r\n    /// 所属集合类型参数的元素\r\n    /// </summary>\r\n    public object Element { get; set; }\r\n\r\n    /// <summary>\r\n    /// 展开\r\n    /// </summary>\r\n    /// <param name=\"originResult\"></param>\r\n    /// <returns></returns>\r\n    public static List<SearchResult> Flatten(List<SearchResult> originResult)\r\n    {\r\n        List<SearchResult> result = new();\r\n        int index = 1;\r\n        foreach (SearchResult sr in originResult)\r\n        {\r\n            if (sr.ParamDetailNodes != null)\r\n            {\r\n                foreach (ParameterDetailModel node in sr.ParamDetailNodes)\r\n                {\r\n                    result.Add(new SearchResult\r\n                    {\r\n                        Index = index++,\r\n                        GroupNodeType = sr.GroupNodeType,\r\n                        ParamDetailNodes = sr.ParamDetailNodes,\r\n                        CurrentSelectedNode = node,\r\n                        Element = sr.Element\r\n                    });\r\n                }\r\n            }\r\n        }\r\n\r\n        return result;\r\n    }\r\n}","lineCount":65,"compileIncluded":true,"assemblies":["AKRS.ZX2200"],"declarations":[{"symbolId":"ae54ab8e0d43679c5d1149c8","fileId":"b5bd8f7a4749d46d3bafe0f9","start":9,"end":65,"syntaxKind":"ClassDeclaration","label":"AKRS.ZX2200.SupportFeature.Parameters.Models.SearchResult","name":"SearchResult","kind":"NamedType"},{"symbolId":"57d0150c05214f47c47ee146","fileId":"b5bd8f7a4749d46d3bafe0f9","start":14,"end":14,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.SupportFeature.Parameters.Models.SearchResult.Index","name":"Index","kind":"Property"},{"symbolId":"b860fc99878c31642f90f9a4","fileId":"b5bd8f7a4749d46d3bafe0f9","start":14,"end":14,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.ZX2200.SupportFeature.Parameters.Models.SearchResult.get_Index","name":"get_Index","kind":"Method"},{"symbolId":"992fced3049e266a54a3ca3f","fileId":"b5bd8f7a4749d46d3bafe0f9","start":14,"end":14,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.ZX2200.SupportFeature.Parameters.Models.SearchResult.set_Index(System.Int32)","name":"set_Index","kind":"Method"},{"symbolId":"7ccdb166da5c29870aca0e74","fileId":"b5bd8f7a4749d46d3bafe0f9","start":19,"end":19,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.SupportFeature.Parameters.Models.SearchResult.GroupNodeType","name":"GroupNodeType","kind":"Property"},{"symbolId":"539883e0106e21b31c50c471","fileId":"b5bd8f7a4749d46d3bafe0f9","start":19,"end":19,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.ZX2200.SupportFeature.Parameters.Models.SearchResult.get_GroupNodeType","name":"get_GroupNodeType","kind":"Method"},{"symbolId":"2767e1178897b887e75c3a32","fileId":"b5bd8f7a4749d46d3bafe0f9","start":19,"end":19,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.ZX2200.SupportFeature.Parameters.Models.