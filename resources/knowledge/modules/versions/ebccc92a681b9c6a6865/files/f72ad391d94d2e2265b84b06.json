ortFeature.Compensate.MotionAreaCompensate.RoundGroup.get_PointCount","name":"get_PointCount","kind":"Method"},{"symbolId":"a7020d7c3429820550fc1eee","fileId":"f72ad391d94d2e2265b84b06","start":17,"end":17,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.ZX2200.SupportFeature.Compensate.MotionAreaCompensate.RoundGroup.set_PointCount(System.Int32)","name":"set_PointCount","kind":"Method"},{"symbolId":"c6a2fcd82fdba414110ab2d7","fileId":"f72ad391d94d2e2265b84b06","start":18,"end":18,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.SupportFeature.Compensate.MotionAreaCompensate.RoundGroup.DataList","name":"DataList","kind":"Property"},{"symbolId":"dfd4b873497a0a89a7f410a6","fileId":"f72ad391d94d2e2265b84b06","start":18,"end":18,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.ZX2200.SupportFeature.Compensate.MotionAreaCompensate.RoundGroup.get_DataList","name":"get_DataList","kind":"Method"},{"symbolId":"bd2f5318eb8ff6a1a6f8509d","fileId":"f72ad391d94d2e2265b84b06","start":18,"end":18,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.ZX2200.SupportFeature.Compensate.MotionAreaCompensate.RoundGroup.set_DataList(System.Collections.Generic.List{AKRS.ZX2200.SupportFeature.Statistics.DefectStatisticsEntity})","name":"set_DataList","kind":"Method"},{"symbolId":"4d1b19d4e75df422014f2a25","fileId":"f72ad391d94d2e2265b84b06","start":24,"end":69,"syntaxKind":"ClassDeclaration","label":"AKRS.ZX2200.SupportFeature.Compensate.MotionAreaCompensate.CompensateDataService","name":"CompensateDataService","kind":"NamedType"},{"symbolId":"b8bdd140be6a38d13f25f68b","fileId":"f72ad391d94d2e2265b84b06","start":26,"end":26,"syntaxKind":"VariableDeclarator","label":"AKRS.ZX2200.SupportFeature.Compensate.MotionAreaCompensate.CompensateDataService._pointPerRound","name":"_pointPerRound","kind":"Field"},{"symbolId":"203f21dfb3f916a28a6e32f7","fileId":"f72ad391d94d2e2265b84b06","start":28,"end":28,"syntaxKind":"VariableDeclarator","label":"AKRS.ZX2200.SupportFeature.Compensate.Motio