{"id":"f72ad391d94d2e2265b84b06","path":"trunk/AKRS.ZX2200/SupportFeature/Compensate/MotionAreaCompensate/CompensateDataService.cs","moduleId":"4bfb2af86705bab1cd13ce82","sha256":"b42fdfdc748c8cc6564a6ac12cee096b19235b538fcebf06b89ed0d53aa0ec43","baselineSha256":"b42fdfdc748c8cc6564a6ac12cee096b19235b538fcebf06b89ed0d53aa0ec43","current":true,"exists":true,"encoding":"utf-8","code":"using System;\r\nusing System.Collections.Generic;\r\nusing System.Linq;\r\nusing AKRS.ZX2200.Main.Machine.Product;\r\nusing AKRS.ZX2200.SupportFeature.Statistics;\r\n\r\nnamespace AKRS.ZX2200.SupportFeature.Compensate.MotionAreaCompensate\r\n{\r\n    /// <summary>\r\n    /// 轮次数据分组实体\r\n    /// </summary>\r\n    public class RoundGroup\r\n    {\r\n        public int TuIndex { get; set; }\r\n        public int SubIndex { get; set; }\r\n        public DateTime RoundTime { get; set; }\r\n        public int PointCount { get; set; }\r\n        public List<DefectStatisticsEntity> DataList { get; set; }\r\n    }\r\n\r\n    /// <summary>\r\n    /// 补偿数据查询服务\r\n    /// </summary>\r\n    public class CompensateDataService\r\n    {\r\n        private readonly int _pointPerRound;\r\n        // 补偿计算对应的缺陷名称，和统计界面下拉框里的名称保持一致\r\n        private const string DefectName = \"贴片精度\"; // ← 替换成你实际的缺陷项名称\r\n\r\n        public CompensateDataService()\r\n        {\r\n            var config = ProductDomain.GetInstance().ProductConfig.SubstrateConfig;\r\n            _pointPerRound = config.RowCount * config.ColumnCount;\r\n        }\r\n\r\n        /// <summary>\r\n        /// 获取指定时间点之后的所有轮次分组\r\n        /// </summary>\r\n        public List<RoundGroup> GetRoundsAfterTime(DateTime startTime)\r\n        {\r\n            // 直接复用项目现有统计查询方法，和统计界面数据完全同源\r\n            List<DefectStatisticsEntity> allData = StatisticsDomain.GetInstance().QueryDefect(\r\n                DefectName,\r\n                startTime,\r\n                DateTime.MaxValue); // 结束时间设为最大值，即查开始时间之后的所有数据\r\n\r\n            if (allData == null || allData.Count == 0)\r\n                return new List<RoundGroup>();\r\n\r\n            // 按 TuIndex + SubIndex + 日期 分组，识别每一轮\r\n            return allData\r\n                .GroupBy(x => new { x.TuIndex, x.SubIndex, x.DateTime.Date })\r\n                .Select(g => new RoundGroup\r\n                {\r\n                    TuIndex = g.Key.TuIndex,\r\n                    SubIndex = g.Key.SubIndex,\r\n                    RoundTime = g.Min(x => x.DateTime),\r\n                    PointCount = g.Count(),\r\n                    DataList = g.OrderBy(x => x.ModuleIndex).ToList()\r\n                })\r\n                .OrderBy(x => x.RoundTime)\r\n                .ToList();\r\n        }\r\n\r\n        /// <summary>\r\n        /// 获取单轮数据点数\r\n        /// </summary>\r\n        public int GetPointPerRound() => _pointPerRound;\r\n    }\r\n}\r\n","lineCount":71,"compileIncluded":true,"assemblies":["AKRS.ZX2200"],"declarations":[{"symbolId":"d26e14b8f579ed712196bbb1","fileId":"f72ad391d94d2e2265b84b06","start":12,"end":19,"syntaxKind":"ClassDeclaration","label":"AKRS.ZX2200.SupportFeature.Compensate.MotionAreaCompensate.RoundGroup","name":"RoundGroup","kind":"NamedType"},{"symbolId":"65480f52baa0a3802e172b27","fileId":"f72ad391d94d2e2265b84b06","start":14,"end":14,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.SupportFeature.Compensate.MotionAreaCompensate.RoundGroup.TuIndex","name":"TuIndex","kind":"Property"},{"symbolId":"6ef87ecca95fd559d3a43f30","fileId":"f72ad391d94d2e2265b84b06","start":14,"end":14,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.ZX2200.SupportFeature.Compensate.MotionAreaCompensate.RoundGroup.get_TuIndex","name":"get_TuIndex","kind":"Method"},{"symbolId":"874a77287170ba7b1fe1a0f9","fileId":"f72ad391d94d2e2265b84b06","start":14,"end":14,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.ZX2200.SupportFeature.Compensate.MotionAreaCompensate.RoundGroup.set_TuIndex(System.Int32)","name":"set_TuIndex","kind":"Method"},{"symbolId":"08fc233c591b1a