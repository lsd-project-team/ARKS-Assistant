{"id":"faa1cf79d566f26cafe18423","path":"trunk/AKRS.ZX2200/TransportSystem/Models/DatasetModels/StockBin/UnloaderBin.cs","moduleId":"f5d98dcbed588b315dfd7f6b","sha256":"21dd84ed1a3e590d0adb85d7a5bf20ac748fc70ecffbbb1070e68e97a407b69b","baselineSha256":"21dd84ed1a3e590d0adb85d7a5bf20ac748fc70ecffbbb1070e68e97a407b69b","current":true,"exists":true,"encoding":"utf-8","code":"using AKRS.ZX2200.Models;\r\n\r\nusing Newtonsoft.Json;\r\nusing System.Collections.Generic;\r\n\r\nnamespace AKRS.ZX2200.TransportSystem.Models.DatasetModels.StockBin\r\n{\r\n    using System;\r\n    using AKRS.ZX2200.Infrastructure.Models.BaseModels;\r\n    using AKRS.ZX2200.Infrastructure.Models.CommonModels;\r\n    using AKRS.ZX2200.Infrastructure.Models.Enums;\r\n    using AKRS.ZX2200.SupportFeature.Parameters.Model;\r\n    using System;\r\n\r\n    /// <summary>\r\n    /// 下料盒\r\n    /// </summary>\r\n    [Serializable]\r\n    public class UnloaderBin : BaseDsSetting\r\n    {\r\n        /// <summary>\r\n        /// 构造函数\r\n        /// </summary>\r\n        public UnloaderBin()\r\n        {\r\n            this.ResetAssistantStates();\r\n        }\r\n\r\n        /// <summary>\r\n        /// 第一层料片高度\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"第一层料片高度\", (string)null, false, \"mm\")]\r\n        public double FirstTabletLevel { get; set; }\r\n\r\n        /// <summary>\r\n        /// 最后一层料片高度\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"最后一层料片高度\", (string)null, false, \"mm\")]\r\n        public double LastTabletLevel { get; set; }\r\n\r\n        /// <summary>\r\n        /// 层数\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"层数\", (string)null, false)]\r\n        public double LayerNum { get; set; }\r\n\r\n        /// <summary>\r\n        /// 料片间距\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"料片间距\", (string)null, false, \"mm\")]\r\n        public double TabletPitch { get; set; }\r\n\r\n        /// <summary>\r\n        /// A料盒位置(Y向)\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"A料盒位置(Y向)\", (string)null, -10000, 10000, \"mm\")]\r\n        public double BinAPosY { get; set; }\r\n\r\n        /// <summary>\r\n        /// B料盒位置(Y向)\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"B料盒位置(Y向)\", (string)null, -10000, 10000, \"mm\")]\r\n        public double BinBPosY { get; set; }\r\n\r\n        /// <summary>\r\n        /// 推杆退料位(X向)\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"推杆推料位(X向)\", (string)null, -10000, 10000, \"mm\")]\r\n        public double PushPos { get; set; }\r\n\r\n        /// <summary>\r\n        /// Unloader\r\n        /// </summary>\r\n        public AssistantState Unloader { get; set; }\r\n\r\n        /// <summary>\r\n        /// Unloader是否示教完成\r\n        /// </summary>\r\n        [JsonIgnore]\r\n        public bool IsAssistantSucceed => this.GetAssistantResult();\r\n\r\n        /// <summary>\r\n        /// Unloader是否示教完成\r\n        /// </summary>\r\n        /// <returns>return</returns>\r\n        private bool GetAssistantResult()\r\n        {\r\n            List<AssistantState> list = this.GetAssistantStates();\r\n            foreach (var item in list)\r\n            {\r\n                if (item == null)\r\n                { \r\n                return false;\r\n                }\r\n\r\n                if (item.State == AssistantStateEnum.UnAble)\r\n                {\r\n                    return false;\r\n                }\r\n            }\r\n\r\n            return true;\r\n        }\r\n\r\n        /// <summary>\r\n        /// 获取Unloader所有示教的状态\r\n        /// </summary>\r\n        /// <returns>return</returns>\r\n        public List<AssistantState> GetAssistantStates()\r\n        {\r\n            List<AssistantState> list = new List<AssistantState>();\r\n            list.Add(this.Unloader);\r\n\r\n            return list;\r\n        }\r\n\r\n        /// <summary>\r\n        /// 初始化Unloader示教状态\r\n        /// </summary>\r\n        public void ResetAssistantStates()\r\n        {\r\n            this.Unloader = new AssistantState() { Name = \"Unloader\", State = AssistantStateEnum.UnAble };\r\n        }\r\n    }\r\n}\r\n","lineCount":126,"compileIncluded":true,"assemblies":["AKRS.ZX2200"],"declarations":[{"symbolId":"6fa272a3973abc8625db94e0","fileId":"faa1cf79d566f26cafe18423","start":18,"end":124,"syntaxKind":"ClassDeclaration","label":"AKRS.ZX2200.TransportSystem.Models.DatasetModels.StockBin.UnloaderBin","name":"UnloaderBin","kind":"NamedType"},{"symbolId":"86c97e333637e54c5601393b","fileId":"faa1cf79d566f26cafe18423","start":24,"end":27,"syntaxKind":"ConstructorDeclaration","label":"AKRS.ZX2200.TransportSystem.Models.DatasetModels.StockBin.UnloaderBin.#ctor","name":".ctor","kind":"Method"},{"symbolId":"e456b2836703078fc1acf6de","fileId":"faa1cf79d566f26cafe18423","start":32,"end":33,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.TransportSystem.Models.DatasetModels.StockBin.UnloaderBin.FirstTabletLevel","name":"FirstTabletLevel","kind":"Property"},{"symbolId":"a762aaab8240e0978e85f1c3","fileId":"faa1cf79d566f26cafe18423","start":33,"end":33,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.ZX2200.TransportSystem.Models.DatasetModels.StockBin.UnloaderBin.get_FirstTabletLevel","name":"get_FirstTabletLevel","kind":"Method"},{"symbolId":"fba3194ce594d5c533d8d132","fileId":"faa1cf79d566f26cafe18423","start":33,"end":33,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.ZX2200.TransportSystem.Models.DatasetModels.StockBin.UnloaderBin.set_FirstTabletLevel(System.Double)","name":"set_FirstTabletLevel","kind":"Method"},{"symbolId":"ccd74b59ac4c4ecb5210aa0c","fileId":"faa1cf79d566f26cafe18423","start":38,"end":39,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.TransportSystem.Models.DatasetModels.StockBin.UnloaderBin.LastTabletLevel","name":"LastTabletLevel","kind":"Property"},{"symbolId":"0d8816a0b2a64d9f7bdedeb6","fileId":"faa1cf79d566f26cafe18423","start":39,"end":39,"syntaxKind":"GetAccessorDecla