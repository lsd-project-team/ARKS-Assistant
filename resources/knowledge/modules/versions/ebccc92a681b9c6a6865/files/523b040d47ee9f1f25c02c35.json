{"id":"523b040d47ee9f1f25c02c35","path":"trunk/AKRS.ZX2200/SupportFeature/Parameters/Models/ParamGroupModel.cs","moduleId":"4bfb2af86705bab1cd13ce82","sha256":"9ad143b40bb053b06b06688979f89736b08a29c5f023143df55c9c068a5ba497","baselineSha256":"9ad143b40bb053b06b06688979f89736b08a29c5f023143df55c9c068a5ba497","current":true,"exists":true,"encoding":"utf-8","code":"using AKRS.ZX2200.SupportFeature.Parameters.Model;\r\nusing System.Collections.Generic;\r\n\r\nnamespace AKRS.ZX2200.SupportFeature.Parameters.Models;\r\n\r\n/// <summary>\r\n/// 树节点模型\r\n/// </summary>\r\npublic class ParamGroupModel\r\n{\r\n    /// <summary>\r\n    /// 节点ID\r\n    /// </summary>\r\n    public int ID { get; set; } \r\n\r\n    /// <summary>\r\n    /// 父节点ID\r\n    /// </summary>\r\n    public int? ParentID { get; set; } \r\n\r\n    /// <summary>\r\n    /// 节点名称\r\n    /// </summary>\r\n    public string DisplayName { get; set; }\r\n\r\n    /// <summary>\r\n    /// 节点值\r\n    /// </summary>\r\n    public object Tag { get; set; }\r\n\r\n    /// <summary>\r\n    /// 是否是集合类型\r\n    /// </summary>\r\n    public bool IsCollection { get; set; }\r\n\r\n    /// <summary>\r\n    /// 节点类型\r\n    /// </summary>\r\n    public TreeGroupChildNodesEnum? NodeEnum { get; set; }\r\n\r\n    /// <summary>\r\n    /// 子节点集合\r\n    /// </summary>\r\n    public List<ParamGroupModel> Children { get; set; } = new List<ParamGroupModel>();\r\n\r\n    /// <summary>\r\n    /// 展开子节点\r\n    /// </summary>\r\n    /// <param name=\"nodes\"></param>\r\n    /// <returns></returns>\r\n    public static List<ParamGroupModel> Flatten(List<ParamGroupModel> nodes)\r\n    {\r\n        List<ParamGroupModel> flatList = new();\r\n        int currentId = 1;\r\n        FlattenNodes(nodes, null, flatList, ref currentId);\r\n        return flatList;\r\n    }\r\n\r\n    /// <summary>\r\n    /// 递归展开节点\r\n    /// </summary>\r\n    /// <param name=\"nodes\"></param>\r\n    /// <param name=\"parentId\"></param>\r\n    /// <param name=\"flatList\"></param>\r\n    /// <param name=\"currentId\"></param>\r\n    private static void FlattenNodes(List<ParamGroupModel> nodes, int? parentId, List<ParamGroupModel> flatList, ref int currentId)\r\n    {\r\n        foreach (ParamGroupModel node in nodes)\r\n        {\r\n            node.ID = currentId++;\r\n            node.ParentID = parentId;\r\n\r\n            flatList.Add(node);\r\n\r\n            if (node.Children != null && node.Children.Count > 0)\r\n            {\r\n                FlattenNodes(node.Children, node.ID, flatList, ref currentId);\r\n            }\r\n        }\r\n    }\r\n}","lineCount":81,"compileIncluded":true,"assemblies":["AKRS.ZX2200"],"declarations":[{"symbolId":"9b158579dab596ea7c0100d8","fileId":"523b040d47ee9f1f25c02c35","start":9,"end":81,"syntaxKind":"ClassDeclaration","label":"AKRS.ZX2200.SupportFeature.Parameters.Models.ParamGroupModel","name":"ParamGroupModel","kind":"NamedType"},{"symbolId":"fc20932b74fa6537a2e6e644","fileId":"523b040d47ee9f1f25c02c35","start":14,"end":14,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.SupportFeature.Parameters.Models.ParamGroupModel.ID","name":"ID","kind":"Property"},{"symbolId":"4e6a1a9e877153de247365bd","fileId":"523b040d47ee9f1f25c02c35","start":14,"end":14,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.ZX2200.SupportFeature.Parameters.Models.ParamGroupModel.get_ID","name":"get_ID","kind":"Method"},{"symbolId":"de8adbf7d0f801236c758825","fileId":"523b040d47ee9f1f25c02c35","start":14,"end":14,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.ZX2200.SupportFeature.Parameters.Models.ParamGroupModel.set_ID(System.Int32)","name":"set_ID","kind":"Method"},{"symbolId":"c3955464fa66d6b5ffd49e46","fileId":"523b040d47ee9f1f25c02c35","start":19,"end":19,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.SupportFeature.Parameters.Models.ParamGroupModel.ParentID","name":"ParentID","kind":"Property"},{"symbolId":"96cf8f9d1409d6c65cf5dbf0","fileId":"523b040d47ee9f1f25c02c35","start":19,"e