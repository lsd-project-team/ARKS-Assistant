{"id":"b1e5181e48c978685d7f3dee","path":"trunk/AKRS.Galaxy2.Dispense/EndpointSetting.cs","moduleId":"ffa6a8b64dc2b44002014aa0","sha256":"f916969e89df6c9dfb1f1767d26445bd032cd908213b0b4cb2165cf68f72c1ad","baselineSha256":"f916969e89df6c9dfb1f1767d26445bd032cd908213b0b4cb2165cf68f72c1ad","current":true,"exists":true,"encoding":"utf-8","code":"namespace AKRS.Galaxy2.Dispense\r\n{\r\n    /// <summary>\r\n    /// 端点信息。\r\n    /// </summary>\r\n    public struct EndpointSetting\r\n\t{\r\n        /// <summary>\r\n        /// 最大速度，即目标速度。\r\n        /// </summary>\r\n        public int MaxSpeed { get; set; }\r\n\r\n        /// <summary>\r\n        /// 结束速度，即运动到线段的终点时的速度。\r\n        /// </summary>\r\n        public int EndSpeed { get; set; }\r\n\r\n        /// <summary>\r\n        /// 加速度，或加速的时间，或加速的百分比，根据控制卡而定。\r\n        /// </summary>\r\n        public double Acc { get; set; }\r\n\r\n        /// <summary>\r\n        /// 线段表示的路径的行走耗时。\r\n        /// </summary>\r\n        public int Time { get; set; }\r\n\r\n        /// <summary>\r\n        /// 点胶前延迟时间\r\n        /// </summary>\r\n        public int PreDelay { get; set; }\r\n\r\n        /// <summary>\r\n        /// 点胶后延迟时间\r\n        /// </summary>\r\n        public int PostDelay { get; set; }\r\n\r\n        /// <summary>\r\n        /// 高度补偿。\r\n        /// </summary>\r\n        public int AltitudeCompensation;\r\n\r\n        /// <summary>\r\n        /// dummied\r\n        /// </summary>\r\n        private EndpointFlags flags;\r\n\r\n        /// <summary>\r\n        /// 构造函数\r\n        /// </summary>\r\n        /// <param name=\"maxSpeed\">最大速度</param>\r\n        /// <param name=\"endSpeed\">结束速度</param>\r\n        /// <param name=\"acc\">加速度</param>\r\n        /// <param name=\"altitudeCompensation\">高度补偿</param>\r\n        /// <param name=\"time\">线段表示的路径的行走耗时</param>\r\n        /// <param name=\"dummied\">dummied</param>\r\n        /// <param name=\"preDelay\">点胶前延迟时间</param>\r\n        /// <param name=\"postDelay\">点胶后延迟时间</param>\r\n\t\tpublic EndpointSetting(int maxSpeed, int endSpeed, double acc, int altitudeCompensation, int time, bool dummied, int preDelay, int postDelay)\r\n\t\t{\r\n\t\t\tthis.MaxSpeed = maxSpeed;\r\n\t\t\tthis.EndSpeed = endSpeed;\r\n\t\t\tthis.Acc = acc;\r\n\t\t\tthis.AltitudeCompensation = altitudeCompensation;\r\n\t\t\tthis.Time = time;\r\n\r\n\t\t\tthis.PreDelay = preDelay;\r\n\t\t\tthis.PostDelay = postDelay;\r\n\r\n            this.flags = EndpointFlags.AltitudeCompensation;\r\n\r\n            if (dummied)\r\n            {\r\n                this.flags |= EndpointFlags.Dummied;\r\n            }\r\n        }\r\n\r\n        /// <summary>\r\n        /// 获取或设置测高标志。\r\n        /// </summary>\r\n        public bool HeightMeasurement\r\n        {\r\n            get => (this.flags & EndpointFlags.HeightMeasurement) != 0;\r\n\r\n            set\r\n            {\r\n                if (value)\r\n                {\r\n                    this.flags |= EndpointFlags.HeightMeasurement;\r\n                }\r\n                else\r\n                {\r\n                    this.flags &= ~EndpointFlags.HeightMeasurement;\r\n                }\r\n            }\r\n        }\r\n\r\n        /// <summary>\r\n        /// 获取或设置空过标志。\r\n        /// </summary>\r\n        public bool Dummied\r\n        {\r\n            get => (this.flags & EndpointFlags.Dummied) != 0;\r\n\r\n            set\r\n            {\r\n                if (value)\r\n                {\r\n                    this.flags |= EndpointFlags.Dummied;\r\n                }\r\n                else\r\n                {\r\n                    this.flags &= ~EndpointFlags.Dummied;\r\n                }\r\n            }\r\n        }\r\n    }\r\n}\r\n","lineCount":119,"compileIncluded":true,"assemblies":["AKRS.Galaxy2.Dispense"],"declarations":[{"symbolId":"dab64c1af47557cd91110d32","fileId":"b1e5181e48c978685d7f3dee","start":6,"end":117,"syntaxKind":"StructDeclaration","label":"AKRS.Galaxy2.Dispense.EndpointSetting","name":"EndpointSetting","kind":"NamedType"},{"symbolId":"a54e6ad0775f7712463aa83f","fileId":"b1e5181e48c978685d7f3dee","start":11,"end":11,"syntaxKind":"PropertyDeclaration","label":"AKRS.Galaxy2.Dispense.EndpointSetting.MaxSpeed","name":"MaxSpeed","kind":"Property"},{"symbolId":"47668bb1b4fffab24f4c1bba","fileId":"b1e5181e48c978685d7f3dee","start":11,"end":11,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.Galaxy2.Dispense.EndpointSetting.get_MaxSpeed","name":"get_MaxSpeed","kind":"Method"},{"symbolId":"5fadb19785544a1f71ce604e","fileId":"b1e5181e48c978685d7f3dee","start":11,"end":11,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.Galaxy2.Dispense.EndpointSetting.set_MaxSpeed(System.Int32)","name":"set_MaxSpeed","kind":"Method"},{"symbolId":"5d9dcfbfd536bd106f346ee7","fileId":"b1e5181e48c978685d7f3dee","start":16,"end":16,"syntaxKind":"PropertyDeclaration","label":"AKRS.Galaxy2.Dispense.EndpointSetting.EndSpeed","name":"EndSpeed","kind":"Property"},{"symbolId":"91202637cfa7ae45cf651950","fileId":"b1e5181e48c978685d7f3dee","start":16,"end":16,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.Galaxy2.Dispense.EndpointSetting.get_EndSpeed","name":"get_EndSpeed","kind":"Method"},{"symbolId":"24e4ce21ede4b20d5f46eb05","fileId":"b1e5181e48c978685d7f3dee","start":16,"end":16,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.Galaxy2.Dispense.EndpointSetting.set_EndSpeed(System.Int32)","name":"set_EndSpeed","kind":"Method"},{"symbolId":"fa1a29d605f859a7536f0094","fileId":"b1e5181e48c978685d7f3dee","start":21,"end":21,"syntaxKind":"PropertyDeclaration","label":"AKRS.Galaxy2.Dispense.EndpointSetting.Acc","name":"Acc","kind":"Property"},{"symbolId":"2c7db7328f184e4b94cd7101","fileId":"b1e5181e48c978685d7f3dee","start":21,"end":21,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.Galaxy2.Dispense.EndpointSetting.get_Acc","name":"get_Acc","kind":"Method"},{"symbolId":"1341c047671c25882c7e18bd","fileId":"b1e5181e48c978685d7f3dee","start":21,"end":21,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.Galaxy2.Dispense.EndpointSetting.set_Acc(System.Double)","name":"set_Acc","kind":"Method"},{"symbolId":"2b723b3dc3bf746efdb6884a","fileId":"b1e5181e48c978685d7f3dee","start":26,"end":26,"syntaxKind":"PropertyDeclaration","label":"AKRS.Galaxy2.Dispense.EndpointSetting.Time","name":"Time","kind":"Property"},{"symbolId":"96ccacda715a72d1b7407cf5","fileId":"b1e5181e48c978685d7f3dee","start":26,"end":26,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.Galaxy2.Dispense.EndpointSetting.get_Time","name":"get_Time","kind":"Method"},{"symbolId":"e44924b9ca9941e2be81994d","fileId":"b1e5181e48c978685d7f3dee","start":26,"end":26,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.Galaxy2.Dispense.EndpointSetting.set_Time(System.Int32)","name":"set_Time","kind":"Method"},{"symbolId":"e6f66955805ea51526defb89","fileId":"b1e5181e48c978685d7f3dee","start":31,"end":31,"syntaxKind":"PropertyDeclaration","label":"AKRS.Galaxy2.Dispense.EndpointSetting.PreDelay","name":"PreDelay","kind":"Property"},{"symbolId":"16c15816640c884343caecc9","fileId":"b1e5181e48c978685d7f3dee","start":31,"end":31,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.Galaxy2.Dispense.EndpointSetting.get_PreDelay","name":"get_PreDelay","kind":"Method"},{"symbolId":"a7b9e9554430543bcdb83332","fileId":"b1e5181e48c978685d7f3dee","start":31,"end":31,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.Galaxy2.Dispense.EndpointSetting.set_PreDelay(System.Int32)","name":"set_PreDelay","kind":"Method"},{"symbolId":"2ef1c32c5484069b63aeccff","fileId":"b1e5181e48c978685d7f3dee","start":36,"end":36,"syntaxKind":"PropertyDeclaration","label":"AKRS.Galaxy2.Dispense.EndpointSetting.PostDelay","name":"PostDelay","kind":"Property"},{"symbolId":"6424b02cd45bb1021cd2b937","fileId":"b1e5181e48c978685d7f3dee","start":36,"end":36,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.Galaxy2.Dispense.EndpointSetting.get_PostDelay","name":"get_PostDelay","kind":"Method"},{"symbolId":"efde2cf8ea8108f97d