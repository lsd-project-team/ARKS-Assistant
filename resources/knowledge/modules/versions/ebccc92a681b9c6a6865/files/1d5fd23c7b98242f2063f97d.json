{"id":"1d5fd23c7b98242f2063f97d","path":"trunk/AKRS.ZX2200/BondSystem/Models/Repositories/Nozzle/Nozzle.cs","moduleId":"a0a224c4ebd2e1afce11fca5","sha256":"39cf74dfda75ca9c211d12e6dfc78b835fc35b35ff25fc0a5a1f4993dc52f3cc","baselineSha256":"39cf74dfda75ca9c211d12e6dfc78b835fc35b35ff25fc0a5a1f4993dc52f3cc","current":true,"exists":true,"encoding":"utf-8","code":"using System;\r\nusing System.Collections.Generic;\r\nusing System.Text;\r\nusing AKRS.Galaxy2.Infrastructure.CommonModel;\r\nusing AKRS.ZX2200.BondSystem.Models.Enums;\r\nusing AKRS.ZX2200.Consumables;\r\nusing AKRS.ZX2200.Models;\r\n\r\nusing Newtonsoft.Json;\r\n\r\nnamespace AKRS.ZX2200.BondSystem.Models.Repositories.Nozzle\r\n{\r\n    using AKRS.ZX2200.Infrastructure.Models.BaseModels;\r\n    using AKRS.ZX2200.Infrastructure.Models.CommonModels;\r\n    using AKRS.ZX2200.Infrastructure.Models.Enums;\r\n    using AKRS.ZX2200.SupportFeature.Consumables;\r\n    using AKRS.ZX2200.SupportFeature.Parameters;\r\n    using AKRS.ZX2200.SupportFeature.Parameters.Model;\r\n\r\n    /// <summary>\r\n    /// 吸嘴\r\n    /// </summary>\r\n    [Serializable]\r\n    public class Nozzle : BaseDsSetting\r\n    {\r\n        /// <summary>\r\n        /// 构造函数\r\n        /// </summary>\r\n        /// <param name=\"name\">吸嘴名称</param>\r\n        public Nozzle(string name)\r\n        {\r\n            this.Name = name;\r\n            this.FrequencyConsumables = new FrequencyConsumables(name);\r\n            this.ResetAssistantStates();\r\n        }\r\n\r\n        /// <summary>\r\n        /// Nozzle\r\n        /// </summary>\r\n        public Nozzle()\r\n        {\r\n            this.ResetAssistantStates();\r\n        }\r\n\r\n        /// <summary>\r\n        /// 吸嘴类型枚举\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"吸嘴类型\", (string)null)]\r\n        public NozzleTypeEnum NozzleType { get; set; } = NozzleTypeEnum.PickAndPlace;\r\n\r\n        /// <summary>\r\n        /// 吸嘴尺寸枚举\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"吸嘴尺寸\", (string)null, false)]\r\n        public NozzleSizeEnum NozzleSize { get; set; }\r\n\r\n\r\n        /// <summary>\r\n        /// 吸嘴几何数据（长、宽、半径）\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"吸嘴几何尺寸\", (string)null, false)]\r\n        public AKRSPoint3D ToolGeometry { get; set; } = new AKRSPoint3D();\r\n\r\n        /// <summary>\r\n        /// 吸嘴形状枚举\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"吸嘴形状\", (string)null)]\r\n        public NozzleShapeEnum NozzleShape { get; set; }\r\n\r\n\r\n        /// <summary>\r\n        /// 此吸嘴和BMC平台标准吸嘴的高度补偿  表示吸嘴比BMC吸嘴长了多少\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"吸嘴测高结果\", (string)null, false)]\r\n        public double MeasureHeightOffset { get; set; } = 0;\r\n\r\n        /// <summary>\r\n        /// 吸嘴校准角度\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"吸嘴校准角度\", (string)null, false)]\r\n        public double AlignAngle { get; set; } = 0;\r\n\r\n        /// <summary>\r\n        /// 漏晶检测值\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"漏晶检测值\", (string)null)]\r\n        public int AfterPickupVacuumCheckValue { get; set; } = 4000;\r\n\r\n        /// <summary>\r\n        /// 回带检测值\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"回带检测值\", (string)null)]\r\n        public int AfterBondingVacuumCheckValue { get; set; } = 4000;\r\n\r\n        /// <summary>\r\n        /// 吸嘴漏晶检测延时\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"吸嘴漏晶检测延时\", (string)null, 0, 10000000, UnitHelper.ms)]\r\n        public int AfterPickupVacuumCheckDelay { get; set; }\r\n\r\n        /// <summary>\r\n        /// 吸嘴回带检测延时\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"吸嘴回带检测延时\", (string)null, 0, 10000000, UnitHelper.ms)]\r\n        public int AfterBondingVacuumCheckDelay { get; set; }\r\n\r\n        /// <summary>\r\n        /// 在吸嘴架上的槽位号\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"在吸嘴架上的槽位号\", (string)null, false)]\r\n        public int SlotIdentification { get; set; } = -1;\r\n\r\n        /// <summary>\r\n        /// 吸嘴在此BondHead上的旋转半径 偏移数据\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"吸嘴XY校准数据\", (string)null, false)]\r\n        public AKRSPoint2D NozzleOffset { get; set; } = new AKRSPoint2D();\r\n\r\n        /// <summary>\r\n        /// 矩形吸嘴的角跟焊头旋转中心的偏移\r\n        /// </summary>\r\n        public AKRSPoint2D RectangleNozzleCornerOffset { get; set; } = new AKRSPoint2D();\r\n\r\n        /// <summary>\r\n        /// 吸嘴PR模板名称\r\n        /// </summary>\r\n        public string NozzlePRName => this.GetNozzlePRName();\r\n\r\n        /// <summary>\r\n        /// 吸嘴使用次数\r\n        /// </summary>\r\n        public int NozzleUseCount { get; set; } = 0;\r\n\r\n        /// <summary>\r\n        /// GetDieMatchName\r\n        /// </summary>\r\n        /// <returns>result</returns>\r\n        private string GetNozzlePRName()\r\n        {\r\n            return this.Name + \"NozzlePR\";\r\n        }\r\n\r\n        /// <summary>\r\n        /// 吸嘴测高模式枚举\r\n        /// </summary>\r\n        public HeightMeasurementFunctionEnum NozzleHeightMeasurementFunction { get; set; } =\r\n            HeightMeasurementFunctionEnum.WithTDSensor;\r\n\r\n        /// <summary>\r\n        /// 吸嘴测高方式枚举\r\n        /// </summary>\r\n        public ZDeterminationMethodEnum ZDeterminationMethod { get; set; } = ZDeterminationMethodEnum.MiniBMC;\r\n\r\n        /// <summary>\r\n        /// XY轴测定方法枚举\r\n        /// </summary>\r\n        public XYDeterminationMethodEnum XYDeterminationMethod { get; set; }\r\n\r\n        /// <summary>\r\n        /// 吸嘴旋转中心位置,关于G0\r\n        /// </summary>\r\n        public AKRSPoint3D RotateCenterPos { get; set; } = new AKRSPoint3D();\r\n\r\n\r\n        /// <summary>\r\n        /// 吸嘴中心对准相机中心的位置,关于G0\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"吸嘴中心对准相机中心的位置\", (string)null, false)]\r\n        public AKRSPoint3D NozzleToUplookCenterPos { get; set; } = new AKRSPoint3D();\r\n\r\n        /// <summary>\r\n        /// 是否对吸嘴进行重新编程，暂时不用\r\n        /// </summary>\r\n        public bool IsReprogramTool { get; set; } = false;\r\n\r\n        /// <summary>\r\n        /// 是否启用吸嘴测高数据，针对深腔吸嘴，暂时不用\r\n        /// </summary>\r\n        public bool IsHeightMeasurement { get; set; }\r\n\r\n\r\n        /// <summary>\r\n        /// 用反射输出此吸嘴所有属性值 \r\n        /// </summary>\r\n        /// <returns>属性值</returns>\r\n        public override string ToString()\r\n        {\r\n            StringBuilder stringBuilder = new StringBuilder();\r\n\r\n            // 遍历吸嘴属性\r\n            foreach (System.Reflection.PropertyInfo p in this.GetType().GetProperties())\r\n            {\r\n                stringBuilder.Append(p.Name + \": \" + p.GetValue(this) + \"\\r\\n\");\r\n            }\r\n\r\n            return stringBuilder.ToString();\r\n        }\r\n\r\n        /// <summary>\r\n        /// ToolHeight\r\n        /// </summary>\r\n        public AssistantState ToolHeight { get; set; }\r\n\r\n        /// <summary>\r\n        /// ToolAlignment\r\n        /// </summary>\r\n        public AssistantState ToolAlignment { get; set; }\r\n\r\n        /// <summary>\r\n        /// ToolGeometryAssistant\r\n        /// </summary>\r\n        public AssistantState ToolGeometryAssistant { get; set; }\r\n\r\n        /// <summary>\r\n        /// 使用频率\r\n        /// </summary>\r\n        public FrequencyConsumables FrequencyConsumables { get; set; }\r\n\r\n        /// <summary>\r\n        /// 吸嘴是否示教完成\r\n        /// </summary>\r\n        [JsonIgnore]\r\n        public bool IsAssistantSucceed => this.GetAssistantResult();\r\n\r\n        /// <summary>\r\n        /// 吸嘴是否示教完成\r\n        /// </summary>\r\n        /// <returns>return</returns>\r\n        private bool GetAssistantResult()\r\n        {\r\n            List<AssistantState> list = this.GetAssistantStates();\r\n            foreach (var item in list)\r\n            {\r\n                if (item == null)\r\n                {\r\n                    return false;\r\n                }\r\n\r\n                if (item.State == AssistantStateEnum.UnAble)\r\n                {\r\n                    return false;\r\n                }\r\n            }\r\n\r\n            return true;\r\n        }\r\n\r\n        /// <summary>\r\n        /// 获取吸嘴所有示教的状态\r\n        /// </summary>\r\n        /// <returns>return</returns>\r\n        public List<AssistantState> GetAssistantStates()\r\n        {\r\n            List<AssistantState> list = new List<AssistantState>();\r\n            list.Add(this.ToolHeight);\r\n            list.Add(this.ToolAlignment);\r\n            list.Add(this.ToolGeometryAssistant);\r\n\r\n            return list;\r\n        }\r\n\r\n        /// <summary>\r\n        /// 初始化吸嘴示教状态\r\n        /// </summary>\r\n        public void ResetAssistantStates()\r\n        {\r\n            this.ToolHeight = new AssistantState() { Name = \"Tool height\", State = AssistantStateEnum.UnAble };\r\n            this.ToolAlignment = new AssistantState() { Name = \"Tool alignment\", State = AssistantStateEnum.UnAble };\r\n            this.ToolGeometryAssistant = new AssistantState() { Name = \"Tool geometry\", State = AssistantStateEnum.UnAble };\r\n        }\r\n    }\r\n}\r\n","lineCount":273,"compileIncluded":true,"assemblies":["AKRS.ZX2200"],"declarations":[{"symbolId":"334c23a3c31e8b4a7af85292","fileId":"1d5fd23c7b98242f2063f97d","start":23,"end":271,"syntaxKind":"ClassDeclaration","label":"AKRS.ZX2200.BondSystem.Models.Repositories.Nozzle.Nozzle","name":"Nozzle","kind":"NamedType"},{"symbolId":"ee305207ee40cc8d6070fa11","fileId":"1d5fd23c7b98242f2063f97d","start":30,"end":35,"syntaxKind":"ConstructorDeclaration","label":"AKRS.ZX2200.BondSystem.Models.Repositories.Nozzle.Nozzle.#ctor(System.String)","name":".ctor","kind":"Method"},{"symbolId":"ddcebdbf77f44f3e1f544e97","fileId":"1d5fd23c7b98242f2063f97d","start":40,"end":43,"syntaxKind":"ConstructorDeclaration","label":"AKRS.ZX2200.BondSystem.Models.Repositories.Nozzle.Nozzle.#ctor","name":".ctor","kind":"Method"},{"symbolId":"712c4bd115946bfb31fb5704","fileId":"1d5fd23c7b98242f2063f97d","start":48,"end":49,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.BondSystem.Models.Repositories.Nozzle.Nozzle.NozzleType","name":"NozzleType","kind":"Property"},{"symbolId":"c3ae88914bbbc2b1bfaeb81b","fileId":"1d5fd23c7b98242f2063f97d","start":49,"end":49,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.ZX2200.BondSystem.Models.Repositories.Nozzle.Nozzle.get_NozzleType","name":"get_NozzleType","kind":"Method"},{"symbolId":"b46716d2a2587415972c5d8c","fileId":"1d5fd23c7b98242f2063f97d","start":49,"end":49,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.ZX2200.BondSystem.Models.Repositories.Nozzle.Nozzle.set_NozzleType(AKRS.ZX2200.BondSystem.Models.Enums.NozzleTypeEnum)","name":"set_NozzleType","kind":"Method"},{"symbolId":"b363627d2c64cbbffec47061","fileId":"1d5fd23c7b98242f2063f97d","start":54,"end":55,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.BondSystem.Models.Repositories.Nozzle.Nozzle.NozzleSize","name":"NozzleSize","kind":"Property"},{"symbolId":"e4cb5141e0bbb34d418c4e91","fileId":"1d5fd23c7b98242f2063f97d","start":55,"end":55,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.ZX2200.BondSystem.Models.Repositories.Nozzle.Nozzle.get_NozzleSize","name":"get_NozzleSize","kind":"Method"},{"symbolId":"bd0636062c1273a905766fc1","fileId":"1d5fd23c7b98242f2063f97d","start":55,"end":55,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.ZX2200.BondSystem.Models.Repositories.Nozzle.Nozzle.set_NozzleSize(AKRS.ZX2200.BondSystem.Models.Enums.NozzleSizeEnum)","name":"set_NozzleSize","kind":"Method"},{"symbolId":"9d513285368dffb5ea9478b3","fileId":"1d5fd23c7b98242f2063f97d","start":61,"end":62,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.BondSystem.Models.Repositories.Nozzle.Nozzle.ToolGeometry","name":"ToolGeometry","kind":"Property"},{"symbolId":"93b2f7f83f876bd24ba380e5","fileId":"1d5fd23c7b98242f2