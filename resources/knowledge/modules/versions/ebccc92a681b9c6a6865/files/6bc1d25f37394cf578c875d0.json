{"id":"6bc1d25f37394cf578c875d0","path":"trunk/AKRS.ZX2200/DispenseSystem/Models/Repositories/Pattern/EpoxyApplication.cs","moduleId":"a3696dc5340b17ca1e9eb76c","sha256":"521085379fd47662ed25f7f7ae3372e22d8d58330b9ba6a9391fa5c39abce0ad","baselineSha256":"521085379fd47662ed25f7f7ae3372e22d8d58330b9ba6a9391fa5c39abce0ad","current":true,"exists":true,"encoding":"utf-8","code":"using AKRS.ZX2200.DispenseSystem.Models.DispensePara;\r\nusing DevExpress.XtraEditors;\r\nusing System;\r\nusing System.Collections.Generic;\r\n\r\nnamespace AKRS.ZX2200.DispenseSystem.Models.Repositories.Pattern\r\n{\r\n    using AKRS.ZX2200.DispenseSystem.Models.Enums;\r\n    using AKRS.ZX2200.DispenseSystem.Services;\r\n    using AKRS.ZX2200.Infrastructure.Controls.Currency;\r\n    using AKRS.ZX2200.Infrastructure.Models.BaseModels;\r\n    using AKRS.ZX2200.SupportFeature.Parameters.Model;\r\n\r\n    using Newtonsoft.Json;\r\n\r\n    /// <summary>\r\n    /// 点胶时参数\r\n    /// </summary>\r\n    [Serializable]\r\n    public class EpoxyApplication : BaseDsSetting\r\n    {\r\n        /// <summary>\r\n        /// 点胶时候的模式\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"点胶模式\", (string)null)]\r\n        public DispensingTypeEnum DispensingType { get; set; }\r\n        \r\n        /// <summary>\r\n        /// 点胶模式\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"点胶类型\", (string)null)]\r\n        public EpoxyApplicationTypeEnum EpoxyApplicationStrategy { get; set; }\r\n\r\n        /// <summary>\r\n        /// 点位集合\r\n        /// </summary>\r\n        public List<EpoxyApplicationLocation[]> DispensePatternParas { get; set; } = new List<EpoxyApplicationLocation[]>();\r\n\r\n        /// <summary>\r\n        /// 画胶图形是否可用\r\n        /// 主要是为了防止加速度，减速度，速度为0\r\n        /// </summary>\r\n        [JsonIgnore]\r\n        public bool EpoxyIsReasonable => this.IsDataReasonAble();\r\n\r\n        #region 点胶\r\n\r\n        /// <summary>\r\n        /// 准备开始点胶的高度\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"准备开始点胶高度\", \"点胶\", 0, 50, \"mm\")]\r\n        public double SecurityHeightForEpoxyApplication { get; set; } = 5;\r\n\r\n        /// <summary>\r\n        /// 点胶压力值\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"点胶时正压\", \"点胶\", 0, 500, \"kp\")]\r\n        public double DispensePressure { get; set; } = 100;\r\n\r\n        /// <summary>\r\n        /// 点胶真空值\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"点胶时负压\", \"点胶\", 0, 500, \"kp\")]\r\n        public double Vacuum { get; set; }\r\n\r\n        /// <summary>\r\n        /// 轴速度的百分比，所有轴都会乘上这个速度\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"画胶速度百分比\", \"点胶\", 1, 500, \"%\")]\r\n        public double SpindleSpeedPercentage { get; set; } = 50;\r\n\r\n        /// <summary>\r\n        /// 点胶到位延迟\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"点胶到位延迟\", \"点胶\")]\r\n        public bool IsDispenserLeadTimeOpen { get; set; } = true;\r\n\r\n        /// <summary>\r\n        /// 点胶到位延迟\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"点胶到位延迟时间\", \"点胶\", 0, 5000, \"ms\")]\r\n        public int DispenserLeadTime { get; set; } = 0;\r\n\r\n        /// <summary>\r\n        /// 点胶缓慢下降的速度\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"点胶前下降速度\", \"点胶\", 1, 500, \"mm/s\")]\r\n        public double SlowTravelSpeedBeforeDispensing { get; set; } = 10;\r\n\r\n        /// <summary>\r\n        /// 提前开胶时间\r\n        /// </summary>\r\n        // [TreeProgramListArgs(\"提前开胶距离\", \"点胶\", 0, 50, \"mm\")]\r\n        public int AdvanceOpenDistance { get; set; } = 0;\r\n\r\n        /// <summary>\r\n        /// 提前开胶时间\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"提前开胶距离\", \"点胶\", 0, 50, \"mm\")]\r\n        public double AdvanceOpenDistanceNew { get; set; } = 0;\r\n\r\n        #endregion\r\n\r\n        #region 偏移\r\n\r\n        /// <summary>\r\n        /// 针对于Module原点的偏移值X\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"偏移X\", \"偏移\", \"mm\")]\r\n        public double OffsetX { get; set; } = 0;\r\n\r\n        /// <summary>\r\n        /// 针对于Module原点的偏移值X\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"偏移Y\", \"偏移\", \"mm\")]\r\n        public double OffsetY { get; set; } = 0;\r\n\r\n        /// <summary>\r\n        /// 画胶时Z轴距离基板的距离\r\n        /// 不可为负数，前端矫正\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"偏移高度\", \"偏移\", \"mm\")]\r\n        public double OffsetZ { get; set; } = 0;\r\n\r\n        /// <summary>\r\n        /// 在预点胶上进行点胶时的高度偏移\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"预点胶高度补偿\", \"偏移\", \"mm\")]\r\n        public double PrePlantOffSetZ { get; set; } = 1;\r\n\r\n        #endregion\r\n\r\n        #region 一段断尾\r\n\r\n        /// <summary>\r\n        /// 第一段是否打开\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"一段断尾是否打开\", \"一段断尾\")]\r\n        public bool TearOff1Open { get; set; } = false;\r\n\r\n        /// <summary>\r\n        /// 一段断尾高度\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"一段断尾高度\", \"一段断尾\", 0, 50, \"mm\")]\r\n        public double TearOff1Height { get; set; } = 2;\r\n\r\n        /// <summary>\r\n        /// 一段断尾速度\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"一段断尾速度\", \"一段断尾\", 0, 500, \"mm/s\")]\r\n        public double TearOff1Speed { get; set; } = 10;\r\n\r\n        /// <summary>\r\n        /// 一段短尾延迟\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"一段短尾延迟\", \"一段断尾\", 0, 5000, \"ms\")]\r\n        public int TearOff1Delay { get; set; } = 10;\r\n\r\n        #endregion\r\n\r\n        #region 二段断尾\r\n\r\n        /// <summary>\r\n        /// 第二段是否打开\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"二段断尾是否打开\", \"二段断尾\")]\r\n        public bool TearOff2Open { get; set; } = false;\r\n\r\n        /// <summary>\r\n        /// 二段断尾高度\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"二段断尾高度\", \"二段断尾\", 0, 50, \"mm\")]\r\n        public double TearOff2Height { get; set; } = 4;\r\n\r\n        /// <summary>\r\n        /// 二段断尾速度\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"二段断尾速度\", \"二段断尾\", 0, 500, \"mm/s\")]\r\n        public double TearOff2Speed { get; set; } = 0;\r\n\r\n        /// <summary>\r\n        /// 二段短尾延迟\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"二段短尾延迟\", \"二段断尾\", 0, 5000, \"ms\")]\r\n        public int TearOff2Delay { get; set; } = 10;\r\n\r\n        #endregion\r\n\r\n        #region 图形形状\r\n\r\n        /// <summary>\r\n        /// 画胶图形的X方向的大小\r\n        /// 单位为mm\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"图形长\", \"图形形状\", 0, 100, \"mm\")]\r\n        public double SizeX { get; set; } = 1;\r\n\r\n        /// <summary>\r\n        /// 画胶图形Y方向的大小\r\n        /// 单位为mm\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"图形宽\", \"图形形状\", 0, 100, \"mm\")]\r\n        public double SizeY { get; set; } = 1;\r\n\r\n        /// <summary>\r\n        /// 芯片的X方向的大小\r\n        /// 单位为mm\r\n        /// </summary>\r\n        public double ComponentSizeX { get; set; } = 2;\r\n\r\n        /// <summary>\r\n        /// 芯片的Y方向的大小\r\n        /// 单位为mm\r\n        /// </summary>\r\n        public double ComponentSizeY { get; set; } = 2;\r\n\r\n        /// <summary>\r\n        /// 画胶图像的角度\r\n        /// 单位为度\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"图形角度\", \"图形形状\", \"度\")]\r\n        public double Angle { get; set; } = 0;\r\n\r\n        #endregion\r\n\r\n        #region 蘸胶参数\r\n\r\n        /// <summary>\r\n        /// 蘸胶下降高度\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"蘸胶下降高度\", \"蘸胶参数\", 0, 5, \"mm\")]\r\n        public double PrintSlowDownHeight { get; set; } = 2;\r\n\r\n        /// <summary>\r\n        /// 蘸胶下降速度\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"蘸胶下降速度\", \"蘸胶参数\", 0, 500, \"mm/s\")]\r\n        public double PrintSlowDownSpeed { get; set; } = 100;\r\n\r\n        /// <summary>\r\n        /// 蘸胶停留\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"蘸胶停留\", \"蘸胶参数\", 0, 5000, \"ms\")]\r\n        public int PrintDelayTime { get; set; } = 100;\r\n\r\n        /// <summary>\r\n        /// 蘸胶参数\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"蘸胶深度\", \"蘸胶参数\", -5, 5, \"mm\")]\r\n        public double PrintOffsetZ { get; set; } = 0;\r\n\r\n        /// <summary>\r\n        /// 蘸胶上升高度\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"蘸胶上升高度\", \"蘸胶参数\", 0, 5, \"mm\")]\r\n        public double PrintSlowUpHeight { get; set; } = 2;\r\n\r\n        /// <summary>\r\n        /// 蘸胶上升速度\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"蘸胶上升速度\", \"蘸胶参数\", 0, 5000, \"mm/s\")]\r\n        public double PrintSlowUpSpeed { get; set; } = 100;\r\n\r\n        /// <summary>\r\n        /// 蘸胶上升后延时\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"蘸胶上升后延时\", \"蘸胶参数\", 0, 5000, \"ms\")]\r\n        public int PrintSlowUpDelayTime { get; set; } = 100;\r\n\r\n        /// <summary>\r\n        /// 蘸胶吸嘴的名称\r\n        /// </summary>\r\n        public string PrintNozzleName { get; set; } = \"Null\";\r\n\r\n        #endregion\r\n\r\n        /// <summary>\r\n        /// 数据是否合理\r\n        /// 主要避免速度为0和过大\r\n        /// </summary>\r\n        /// <returns>结果</returns>\r\n        public bool IsDataReasonAble()\r\n        {\r\n            for (int i = 0; i < this.DispensePatternParas.Count; i++)\r\n            {\r\n                for (int j = 0; j < this.DispensePatternParas[i].Length; j++)\r\n                {\r\n                    if (this.DispensePatternParas[i][j].Acc == 0)\r\n                    {\r\n                        this.DispensePatternParas[i][j].Acc = 100;\r\n                    }\r\n\r\n                    if (this.DispensePatternParas[i][j].Dec == 0)\r\n                    {\r\n                        this.DispensePatternParas[i][j].Dec = 100;\r\n                    }\r\n\r\n                    if (this.DispensePatternParas[i][j].Speed == 0)\r\n                    {\r\n                        this.DispensePatternParas[i][j].Speed = 10;\r\n                    }\r\n                }\r\n            }\r\n\r\n            for (int i = 0; i < this.DispensePatternParas.Count; i++)\r\n            {\r\n                for (int j = 0; j < this.DispensePatternParas[i].Length; j++)\r\n                {\r\n                    if (j != this.DispensePatternParas[i].Length - 1)\r\n                    {\r\n                        if (!DispenserMoveHelper.IsEpoxyDataReasonable(this.DispensePatternParas[i][j].Acc))\r\n                        {\r\n                            AKRSXtraMessageBox.Show($\"线{i + 1} ,点{j + 1} 加速度 超过极限 10000\");\r\n                            return false;\r\n                        }\r\n\r\n                        if (!DispenserMoveHelper.IsEpoxyDataReasonable(this.DispensePatternParas[i][j].Dec))\r\n                        {\r\n                            AKRSXtraMessageBox.Show($\"线{i + 1} ,点{j + 1} 减速度 超过极限 10000\");\r\n                            return false;\r\n                        }\r\n\r\n                        if (!DispenserMoveHelper.IsEpoxyDataReasonableSpeed(this.DispensePatternParas[i][j].Speed))\r\n                        {\r\n                            AKRSXtraMessageBox.Show($\"线{i + 1} ,点{j + 1} 速度超过极限 1000\");\r\n                            return false;\r\n                        }\r\n                    }\r\n                }\r\n            }\r\n\r\n            return true;\r\n        }\r\n    }\r\n}\r\n","lineCount":336,"compileIncluded":true,"assemblies":["AKRS.ZX2200"],"declarations":[{"symbolId":"5d3c2e00a5433546322bb42c","fileId":"6bc1d25f37394cf578c875d0","start":19,"end":334,"syntaxKind":"ClassDeclaration","label":"AKRS.ZX2200.DispenseSystem.Models.Repositories.Pattern.EpoxyApplication","name":"EpoxyApplication","kind":"NamedType"},{"symbolId":"b5901cf5bf223d57d19154e3","fileId":"6bc1d25f37394cf578c875d0","start":25,"end":26,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.DispenseSystem.Models.Repositories.Pattern.EpoxyApplication.DispensingType","name":"DispensingType","kind":"Property"},{"symbolId":"0c247c7d752c2db38f1a7d81","fileId":"6bc1d25f37394cf578c875d0","start":26,"end":26,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.ZX2200.DispenseSystem.Models.Repositories.Pattern.EpoxyApplication.get_DispensingType","name":"get_DispensingType","kind":"Method"},{"symbolId":"92ed0bfbcb43275e4252cfb4","fileId":"6bc1d25f37394cf578c875d0","start":26,"end":26,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.ZX2200.DispenseSystem.Models.Repositories.Pattern.EpoxyApplication.set_DispensingType(AKRS.ZX2200.DispenseSystem.Models.Enums.DispensingTypeEnum)","name":"set_DispensingType","kind":"Method"},{"symbolId":"bff3d88e31efc3c1855bfa11","fileId":"6bc1d25f37394cf578c875d0","start":31,"end":32,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.DispenseSystem.Models.Repositories.Pattern.EpoxyApplication.EpoxyApplicationStrategy","name":"EpoxyApplicationStrategy","kind":"Property"},{"symbolId":"51165389697bd22903f9b689","fileId":"6bc1d25f37394cf578c875d0","start":32,"end":32,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.ZX2200.DispenseSystem.Models.Repositories.Pattern.EpoxyApplication.get_EpoxyApplicationStrategy","name":"get_EpoxyApplicationStrategy","kind":"Method"},{"symbolId":"16dfe4ef9bd319c345508946","fileId":"6bc1d25f37394cf578c875d0","start":32,"end":32,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.ZX2200.DispenseSystem.Models.Repositories.Pattern.EpoxyApplication.set_EpoxyApplicationStrategy(AKRS.ZX2200.DispenseSystem.Models.Enums.EpoxyApplicationTypeEnum)","name":"set_EpoxyApplicationStrategy","kind":"Method"},{"symbolId":"561b467e9574ec94f74f9635","fileId":"6bc1d25f37394cf578c875d0","start":37,"end":37,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.DispenseSystem.Models.Repositories.Pattern.EpoxyApplication.DispensePatternParas","name":"DispensePatternParas","kind":"Property"},{"symbolId":"da4b3056dc