os","name":"P3VisionRelativePos","kind":"Property"},{"symbolId":"6c89e8eb4091beaa497f24b2","fileId":"cb73c638cbc53c56bf1175d9","start":76,"end":76,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.ZX2200.TransportUnitSystem.Module.Config.LocateConfig.get_P3VisionRelativePos","name":"get_P3VisionRelativePos","kind":"Method"},{"symbolId":"99cb4a6e46e7f56a8eff2677","fileId":"cb73c638cbc53c56bf1175d9","start":76,"end":76,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.ZX2200.TransportUnitSystem.Module.Config.LocateConfig.set_P3VisionRelativePos(AKRS.Galaxy2.Infrastructure.CommonModel.AKRSPoint3D)","name":"set_P3VisionRelativePos","kind":"Method"},{"symbolId":"c7f3981459806406ac2f4480","fileId":"cb73c638cbc53c56bf1175d9","start":81,"end":82,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.TransportUnitSystem.Module.Config.LocateConfig.P4PRName","name":"P4PRName","kind":"Property"},{"symbolId":"b8a208da7496aff0a5a7bab3","fileId":"cb73c638cbc53c56bf1175d9","start":88,"end":89,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.TransportUnitSystem.Module.Config.LocateConfig.P4VisionRelativePos","name":"P4VisionRelativePos","kind":"Property"},{"symbolId":"b0426ed62b9febdd9e8a7541","fileId":"cb73c638cbc53c56bf1175d9","start":89,"end":89,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.ZX2200.TransportUnitSystem.Module.Config.LocateConfig.get_P4VisionRelativePos","name":"get_P4VisionRelativePos","kind":"Method"},{"symbolId":"70e22753401b21d9ff8c71e9","fileId":"cb73c638cbc53c56bf1175d9","start":89,"end":89,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.ZX2200.TransportUnitSystem.Module.Config.LocateConfig.set_P4VisionRelativePos(AKRS.Galaxy2.Infrastructure.CommonModel.AKRSPoint3D)","name":"set_P4VisionRelativePos","kind":"Method"},{"symbolId":"78a4c9cac0dbf73006568f6b","fileId":"cb73c638cbc53c56bf1175d9","start":94,"end":95,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.TransportUnitSystem.Module.Config.LocateConfig.DistanceCheck","name":"DistanceCheck","kind":"Property"},{"symbolId":"9cf8adeefe01a05fd0a61a59","fileId":"cb73c638cbc53c56bf1175d9","start":95,"end":95,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.ZX2200.TransportUnitSystem.Module.Config.LocateConfig.get_DistanceCheck","name":"get_DistanceCheck","kind":"Method"},{"symbolId":"2b7e509b3e8ed9e3ecc94ec7","fileId":"cb73c638cbc53c56bf1175d9","start":95,"end":95,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.ZX2200.TransportUnitSystem.Module.Config.LocateConfig.set_DistanceCheck(System.Boolean)","name":"set_DistanceCheck","kind":"Method"},{"symbolId":"d934c74e24edd6ccf8f2e3e7","fileId":"cb73c638cbc53c56bf1175d9","start":100,"end":101,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.TransportUnitSystem.Module.Config.LocateConfig.DistanceTolerance","name":"DistanceTolerance","kind":"Property"},{"symbolId":"7e4b01f238191b51f9998e22","fileId":"cb73c638cbc53c56bf1175d9","start":101,"end":101,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.ZX2200.TransportUnitSystem.Module.Config.LocateConfig.get_DistanceTolerance","name":"get_DistanceTolerance","kind":"Method"},{"symbolId":"13457fab8422fb9903de9084","fileId":"cb73c638cbc53c56bf1175d9","start":101,"end":101,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.ZX2200.TransportUnitSystem.Module.Config.LocateConfig.set_DistanceTolerance(System.Double)","name":"set_DistanceTolerance","kind":"Method"},{"symbolId":"72d3bd8c0961bd9be55939ff","fileId":"cb73c638cbc53c56bf1175d9","start":106,"end":107,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.TransportUnitSystem.Module.Config.LocateConfig.IsSymmetric","name":"IsSymmetric","kind":"Property"},{"symbolId":"bfb93e68d33a4991f438234d","fileId":"cb73c638cbc53c56bf1175d9","start":107,"end":107,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.ZX2200.TransportUnitSystem.Module.Config.LocateConfig.get_IsSymmetric","name":"get_IsSymmetric","kind":"Method"},{"symbolId":"9b798344ef24e5839e6c8044","fileId":"cb73c638cbc53c56bf1175d9","start":1