{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "ZX2200 S1 分段交互、Pause/Stop 与完成事件边界",
    "locale": "zh-CN",
    "quality_profile": "showcase"
  },
  "lanes": [
    { "id": "scheduler", "label": "分段调度" },
    { "id": "wait", "label": "交互等待" },
    { "id": "stop", "label": "Stop 结果" },
    { "id": "pause", "label": "Pause / Continue" },
    { "id": "fault", "label": "异常出口" }
  ],
  "nodes": [
    { "id": "divide", "lane": "scheduler", "col": 0, "type": "backend", "label": "InitDivide", "sublabel": "生成 22 条消息", "width": 145 },
    { "id": "groups", "lane": "scheduler", "col": 1, "type": "backend", "label": "后组 → 前组", "sublabel": "12 条 → Interaction → 9 条", "width": 160 },
    { "id": "interactive", "lane": "wait", "col": 2, "type": "security", "label": "InteractiveAction", "sublabel": "Allow.Set → done.Wait", "width": 160 },
    { "id": "waitFalse", "lane": "stop", "col": 4, "type": "security", "label": "Wait=false", "sublabel": "Stop 释放等待", "width": 145 },
    { "id": "actionSuccess", "lane": "stop", "col": 5, "type": "backend", "label": "动作仍 Success", "sublabel": "返回值被外层忽略", "width": 145 },
    { "id": "finish", "lane": "scheduler", "col": 5, "type": "backend", "label": "Finish / 重置", "sublabel": "停止用例正常退出", "width": 145 },
    { "id": "completed", "lane": "wait", "col": 3, "type": "messagebus", "label": "done.Set 被消费", "sublabel": "完成事件可在 Pause 中消费", "width": 165 },
    { "id": "pauseGate", "lane": "pause", "col": 3, "type": "security", "label": "下一层 Pause 门", "sublabel": "继续前仍可阻塞", "width": 150 },
    { "id": "continue", "lane": "pause", "col": 4, "type": "backend", "label": "Continue", "sublabel": "前组动作与 BondRelease", "width": 150 },
    { "id": "fault", "lane": "fault", "col": 4, "type": "external", "label": "Task Faulted", "sublabel": "WorkStop 回调异常", "width": 145 }
  ],
  "edges": [
    { "id": "divide-groups", "from": "divide", "to": "groups", "label": "真实排序", "role": "main" },
    { "id": "groups-interactive", "from": "groups", "to": "interactive", "label": "进入交互", "role": "main" },
    { "id": "interactive-stop", "from": "interactive", "to": "waitFalse", "label": "Stop / Pause 后 Stop", "role": "branch" },
    { "id": "wait-action", "from": "waitFalse", "to": "actionSuccess", "label": "原动作继续", "role": "return" },
    { "id": "action-finish", "from": "actionSuccess", "to": "finish", "label": "外层完成", "role": "main" },
    { "id": "interactive-complete", "from": "interactive", "to": "completed", "label": "done.Set", "role": "main" },
    { "id": "completed-pause", "from": "completed", "to": "pauseGate", "label": "外层标记完成", "role": "main" },
    { "id": "pause-continue", "from": "pauseGate", "to": "continue", "label": "继续", "role": "return" },
    { "id": "interactive-fault", "from": "interactive", "to": "fault", "label": "WorkStop throw", "role": "error" }
  ],
  "mainPath": ["divide", "groups", "interactive", "completed", "pauseGate", "continue"],
  "cards": [
    { "dot": "amber", "title": "Stop 与 Pause 的区别", "items": ["进入已有 done.Wait 后，Pause 本身不会打断等待；随后 Stop 才让 Wait 返回 false。", "等待返回值在原 InteractiveAction 中被丢弃，Stop 用例仍观察到动作 Success，不能等同业务成功。"] },
    { "dot": "rose", "title": "异常边界", "items": ["完成事件已消费后，finally 的 WorkStop 回调若抛异常，真实 Task 变为 Faulted，当前交互未完成。", "测试回调只用于同步和注入，不等同真实 UI、输送或硬件故障。"] },
    { "dot": "cyan", "title": "证据范围", "items": ["native-s1-segment-interaction-review.md；22 条调度消息和原 Wait/Finish/Stop 逻辑已绑定。", "未执行物理输送、在线视觉/测高/点胶、S2、SQL、完整构建和设备运行。"] }
  ]
}
