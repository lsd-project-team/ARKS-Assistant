{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "ZX2200 S1 步骤提前提交、Abort/Fail 与任务关闭查询",
    "locale": "zh-CN",
    "quality_profile": "showcase"
  },
  "lanes": [
    { "id": "task", "label": "S1 动作" },
    { "id": "state", "label": "步骤状态" },
    { "id": "wait", "label": "等待门" },
    { "id": "result", "label": "返回结果" },
    { "id": "query", "label": "关闭查询" }
  ],
  "nodes": [
    { "id": "enter", "lane": "task", "col": 1, "type": "backend", "label": "S1DispenseAction", "sublabel": "进入第 13 条消息", "width": 150 },
    { "id": "commit", "lane": "state", "col": 2, "type": "backend", "label": "S1FinishedStep=true", "sublabel": "早于所有退出路径", "width": 165 },
    { "id": "singleGate", "lane": "wait", "col": 3, "type": "security", "label": "WaitSingleStep", "sublabel": "只看单步字段与事件", "width": 165 },
    { "id": "abort", "lane": "result", "col": 4, "type": "security", "label": "Abort", "sublabel": "单步等待返回 false", "width": 150 },
    { "id": "final", "lane": "result", "col": 5, "type": "backend", "label": "finally / nodeStop", "sublabel": "当前消息仍 pending", "width": 155 },
    { "id": "closeQuery", "lane": "query", "col": 4, "type": "backend", "label": "IsAllowTaskClosed", "sublabel": "汇总活跃任务", "width": 165 },
    { "id": "ui", "lane": "query", "col": 5, "type": "frontend", "label": "恢复停止界面", "sublabel": "不读取 Task.Exception", "width": 155 },
    { "id": "predispense", "lane": "task", "col": 0, "type": "external", "label": "预点胶 Off/Off", "sublabel": "返回 Success", "width": 155 },
    { "id": "waitStart", "lane": "wait", "col": 1, "type": "security", "label": "WaitStart=false", "sublabel": "设备已 Stop", "width": 155 },
    { "id": "fail", "lane": "result", "col": 2, "type": "security", "label": "Fail", "sublabel": "仍未执行物理点胶", "width": 155 }
  ],
  "edges": [
    { "id": "enter-commit", "from": "enter", "to": "commit", "label": "先提交步骤", "role": "main" },
    { "id": "commit-wait", "from": "commit", "to": "singleGate", "label": "进入单步门", "role": "main" },
    { "id": "wait-abort", "from": "singleGate", "to": "abort", "label": "公开字段关闭", "role": "return" },
    { "id": "abort-final", "from": "abort", "to": "final", "label": "收尾继续", "role": "return" },
    { "id": "final-query", "from": "final", "to": "closeQuery", "label": "停止时查询", "role": "main" },
    { "id": "query-ui", "from": "closeQuery", "to": "ui", "label": "可关闭", "role": "main" },
    { "id": "predispense-wait", "from": "predispense", "to": "waitStart", "label": "Stop 后等待", "role": "main" },
    { "id": "wait-fail", "from": "waitStart", "to": "fail", "label": "返回 Fail", "role": "return" }
  ],
  "mainPath": ["enter", "commit", "singleGate", "abort", "final"],
  "cards": [
    { "dot": "amber", "title": "状态分离", "items": ["步骤字典先被置为 true，但当前第 13 条消息仍未完成；GetNext 仍可返回该节点，而 IsDoWork 已因步骤标记拒绝重做。", "Abort/Fail 都没有取得插补坐标、执行物理点胶或发送传料信号。"] },
    { "dot": "rose", "title": "等待与故障", "items": ["WaitSingleStep 不直接读取 MachineState；已有等待要靠 IsSingleStepWork=false 才返回。", "finally 刷新委托为 null 或抛异常时，动作返回值被异常覆盖，Task 可 Faulted。"] },
    { "dot": "cyan", "title": "关闭查询边界", "items": ["IsAllowTaskClosed 只汇总任务是否仍活跃，不读取 Task.Exception、Wait 或业务完成状态。", "native-s1-step-commit-review.md；真实 UI、在线轴、SQL、完整构建和设备闭环仍未验收。"] }
  ]
}
