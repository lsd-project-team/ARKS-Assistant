  "cards": [
    {
      "dot": "cyan",
      "title": "选择与重做",
      "items": [
        "按配置排序；点胶 / 检测映射为 if / else if。",
        "空结果也可能是动作名未匹配；Retry 重取未完成项。",
        "检测可重置早期消息；Fail 也可禁用焊点后返回 Success。"
      ]
    },
    {
      "dot": "amber",
      "title": "不可省略的边界",
      "items": [
        "等料预点胶失败直接退出；禁用 S1 则绕过动作。",
        "分段 Wait、定位 bool 未检查；异常不保证 Stop。",
        "仅未 Stop 才放行；底层动作与现场结果未全部验收。"
      ]
    }
  ]
