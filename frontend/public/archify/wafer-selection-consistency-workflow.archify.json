  "nodes": [
    { "id": "load", "lane": "ui", "col": 0, "type": "frontend", "label": "Load 名称列表", "sublabel": "晶圆优先，适配器回退", "width": 145 },
    { "id": "select", "lane": "ui", "col": 1, "type": "frontend", "label": "名称切换事件", "sublabel": "null / 空值直接返回", "width": 145 },
    { "id": "lookup", "lane": "model", "col": 2, "type": "security", "label": "查找配置对象", "sublabel": "同名优先晶圆类型", "width": 145 },
    { "id": "temp", "lane": "model", "col": 3, "type": "backend", "label": "创建 tempTablet", "sublabel": "先替换临时对象", "width": 145 },
    { "id": "bind", "lane": "model", "col": 4, "type": "backend", "label": "刷新网格 DataSource", "sublabel": "绑定新数组或单对象", "width": 145 },
    { "id": "save", "lane": "persist", "col": 5, "type": "database", "label": "Save tempTablet", "sublabel": "不重新校验名称", "width": 145 },
    { "id": "success", "lane": "outcome", "col": 5, "type": "backend", "label": "保存当前临时对象", "sublabel": "名称可能已失配", "width": 145 },
    { "id": "missing", "lane": "outcome", "col": 3, "type": "security", "label": "查找失败 / 保留旧对象", "sublabel": "提示但不清空 tempTablet", "width": 145 }
  ],
  "edges": [
    { "id": "load-select", "from": "load", "to": "select", "label": "用户选择", "role": "main" },
