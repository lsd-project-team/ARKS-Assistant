    { "id": "consumer", "label": "后台消费者" },
    { "id": "database", "label": "数据库" }
  ],
  "nodes": [
    { "id": "input", "lane": "producer", "col": 0, "type": "frontend", "label": "OnException / UI", "sublabel": "传入 Message", "width": 145 },
    { "id": "dedupe", "lane": "producer", "col": 1, "type": "security", "label": "lastMessage 比较", "sublabel": "只比较上一条成功消息", "width": 145 },
    { "id": "post", "lane": "sdk", "col": 2, "type": "external", "label": "LogHelper.Post", "sublabel": "先广播 SDK Trace", "width": 145 },
    { "id": "entity", "lane": "buffer", "col": 3, "type": "backend", "label": "OperateLogEntity", "sublabel": "构造真实实体", "width": 145 },
    { "id": "queue", "lane": "buffer", "col": 4, "type": "messagebus", "label": "BlockingCollection", "sublabel": "容量 500，Add 可能阻塞", "width": 145 },
    { "id": "consumerNode", "lane": "consumer", "col": 5, "type": "backend", "label": "后台保存线程", "sublabel": "取实体并 Insert", "width": 145 },
    { "id": "sql", "lane": "database", "col": 5, "type": "database", "label": "DBService / SQL", "sublabel": "消费者未在本轮启动", "width": 145 }
  ],
  "edges": [
    { "id": "input-dedupe", "from": "input", "to": "dedupe", "label": "SaveEntity", "role": "main" },
    { "id": "dedupe-post", "from": "dedupe", "to": "post", "label": "新消息", "role": "main" },
    { "id": "post-entity", "from": "post", "to": "entity", "label": "Post 返回", "role": "main" },
    { "id": "entity-queue", "from": "entity", "to": "queue", "label": "Add", "role": "main" },
    { "id": "queue-consumer", "from": "queue", "to": "consumerNode", "label": "取出实体", "role": "main" },
    { "id": "consumer-sql", "from": "consumerNode", "to": "sql", "label": "Insert", "role": "main" }
  ],
  "mainPath": ["input", "dedupe", "post", "entity", "queue", "consumerNode", "sql"],
  "cards": [
    { "dot": "amber", "title": "并发与失败边界", "items": ["队列满时 SDK Trace 已广播，但 Add 尚未返回，lastMessage 尚未更新。", "两个并发调用可以同时通过旧值门控并各自 Post，形成重复实体；Add 失败时新消息仍可能重复广播。"] },
    { "dot": "cyan", "title": "证据范围", "items": ["native-statistics-producer-review.md。", "真实数据库消费者、SQL 写入、Fody 自动织入和生产 UI 异常路径未验收。"] }
