{"id":"48beea03c35db226b717d32a","path":"trunk/AKRS.ZX2200/DispenseSystem/Models/Repositories/Dispenser/Dispenser.cs","moduleId":"a3696dc5340b17ca1e9eb76c","sha256":"99983451d8b5d5fb5e3f827d6cd889a931a8975284d8943eee3d7e5129bd9b57","baselineSha256":"99983451d8b5d5fb5e3f827d6cd889a931a8975284d8943eee3d7e5129bd9b57","current":true,"exists":true,"encoding":"utf-8","code":"using AKRS.ZX2200.Models;\r\n\r\nnamespace AKRS.ZX2200.DispenseSystem.Models.Repositories.Dispenser\r\n{\r\n    using System;\r\n    using System.Collections.Generic;\r\n\r\n    using AKRS.Galaxy2.Infrastructure.CommonModel;\r\n    using AKRS.ZX2200.Consumables;\r\n    using AKRS.ZX2200.DispenseSystem.Models.Enums;\r\n    using AKRS.ZX2200.Infrastructure.Models.BaseModels;\r\n    using AKRS.ZX2200.Infrastructure.Models.CommonModels;\r\n    using AKRS.ZX2200.Infrastructure.Models.Enums;\r\n    using AKRS.ZX2200.SupportFeature.Consumables;\r\n    using AKRS.ZX2200.SupportFeature.Parameters.Model;\r\n\r\n    using Newtonsoft.Json;\r\n\r\n    /// <summary>\r\n    /// 点胶头\r\n    /// </summary>\r\n    [Serializable]\r\n    public class Dispenser : BaseDsSetting\r\n    {\r\n        /// <summary>\r\n        /// 点胶器类型\r\n        /// </summary>\r\n        public DispenserTypeEnum DispenserType { get; set; }\r\n        \r\n        /// <summary>\r\n        /// 流动速度\r\n        /// </summary>\r\n        public bool EpoxyFlowRate { get; set; }\r\n\r\n\r\n        /// <summary>\r\n        /// 标定前是不是需要去预点胶\r\n        /// 这个仅在做程式的时候去使用\r\n        /// </summary>\r\n        public bool PreDispenseBeforeCalibration { get; set; }\r\n\r\n\r\n        /// <summary>\r\n        /// 预点胶参数\r\n        /// </summary>\r\n        public PreDispense PreDispense { get; set; } = new PreDispense();\r\n\r\n        #region Dispenser Calibration\r\n\r\n        /// <summary>\r\n        /// 搜索模式\r\n        /// </summary>\r\n        public DispenseSearchMethodEnum DispenseSearchMethod { get; set; }\r\n\r\n        /// <summary>\r\n        /// 点胶测高方式\r\n        /// 这个仅在页面进行展示\r\n        /// </summary>\r\n        public DispenseDeterminationZTypeEnum DispenseDeterminationZType { get; set; }\r\n\r\n        /// <summary>\r\n        /// 点胶标定方式\r\n        /// </summary>\r\n        public MeasureDistanceDispenserAndVisionTypeEnum MeasureDistanceDispenserAndVisionType { get; set; }\r\n\r\n\r\n        #endregion\r\n\r\n\r\n        #region 已使用参数\r\n\r\n        /// <summary>\r\n        /// 点胶头相对于相机中心的差值\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"点胶头相对于相机中心的差值\", (string)null)]\r\n        public AKRSPoint3D DispensingNeedleOffset { get; set; } = new AKRSPoint3D(0, -62, 15);\r\n\r\n        #endregion\r\n\r\n        /// <summary>\r\n        /// 构造方法\r\n        /// </summary>\r\n        public Dispenser()\r\n        {\r\n            this.ResetAssistantStates();\r\n\r\n            this.DispenseTimes.Name = this.Name;\r\n        }\r\n\r\n        /// <summary>\r\n        /// 焊材\r\n        /// </summary>\r\n        public FrequencyConsumables DispenseTimes { get; set; } = new FrequencyConsumables(\"点胶头\");\r\n\r\n        /// <summary>\r\n        /// DispenserAssistant\r\n        /// </summary>\r\n        public AssistantState DispenserAssistant { get; set; }\r\n\r\n        /// <summary>\r\n        /// 点胶器是否示教完成\r\n        /// </summary>\r\n        [JsonIgnore]\r\n        public bool IsAssistantSucceed => this.GetAssistantResult();\r\n\r\n        /// <summary>\r\n        /// 点胶器是否示教完成\r\n        /// </summary>\r\n        /// <returns>return</returns>\r\n        private bool GetAssistantResult()\r\n        {\r\n            List<AssistantState> list = this.GetAssistantStates();\r\n            foreach (var item in list)\r\n            {\r\n                if (item == null)\r\n                {\r\n                    return false;\r\n                }\r\n\r\n                if (item.State == AssistantStateEnum.UnAble)\r\n                {\r\n                    return false;\r\n                }\r\n            }\r\n\r\n            return true;\r\n        }\r\n\r\n        /// <summary>\r\n        /// 获取点胶器所有示教的状态\r\n        /// </summary>\r\n        /// <returns>return</returns>\r\n        public List<AssistantState> GetAssistantStates()\r\n        {\r\n            List<AssistantState> list = new List<AssistantState>();\r\n            list.Add(this.DispenserAssistant);\r\n\r\n            return list;\r\n        }\r\n\r\n        /// <summary>\r\n        /// 初始化点胶器示教状态\r\n        /// </summary>\r\n        public void ResetAssistantStates()\r\n        {\r\n            this.DispenserAssistant = new AssistantState() { Name = \"Dispenser\", State = AssistantStateEnum.UnAble };\r\n        }\r\n    }\r\n}\r\n","lineCount":150,"compileIncluded":true,"assemblies":["AKRS.ZX2200"],"declarations":[{"symbolId":"818fb6b22ce9307973f1ff5f","fileId":"48beea03c35db226b717d32a","start":22,"end":148,"syntaxKind":"ClassDeclaration","label":"AKRS.ZX2200.DispenseSystem.Models.Repositories.Dispenser.Dispenser","name":"Dispenser","kind":"NamedType"},{"symbolId":"0f49bc95ffe29556ce7f51b2","fileId":"48beea03c35db226b717d32a","start":28,"end":28,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.DispenseSystem.Models.Repositories.Dispenser.Dispenser.DispenserType","name":"DispenserType","kind":"Property"},{"symbolId":"9bf5ebc6a0a6dac686111a44","fileId":"48beea03c35db226b717d32a","start":28,"end":28,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.ZX2200.DispenseSystem.Models.Repositories.Dispenser.Dispenser.get_DispenserType","name":"get_DispenserType","kind":"Method"},{"symbolId":"7a3ae5cd6df530a4ce74ff15","fileId":"48beea03c35db226b717d32a","start":28,"end":28,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.ZX2200.DispenseSystem.Models.Repositories.Dispenser.Dispenser.set_DispenserType(AKRS.ZX2200.DispenseSystem.Models.Enums.DispenserTypeEnum)","name":"set_DispenserType","kind":"Method"},{"symbolId":"4c577aa082110455d62cc50e","fileId":"48beea03c35db226b717d32a","start":33,"end":33,"syntaxK