{"id":"08df0e613fa27eac05edba90","path":"trunk/AKRS.ZX2200/CalibSystem/GlobalCalibration/GlobalCalibrationData.cs","moduleId":"678813d5595d02f20be4d42d","sha256":"84f0db2c5c783a765f9a5f60ff43cf66099a50e498723e240879ae7f3ad8a91e","baselineSha256":"84f0db2c5c783a765f9a5f60ff43cf66099a50e498723e240879ae7f3ad8a91e","current":true,"exists":true,"encoding":"utf-8","code":"using System;\r\nusing System.Collections.Generic;\r\nusing System.Linq;\r\nusing AKRS.ZX2200.Infrastructure.Service;\r\nusing Newtonsoft.Json;\r\n\r\nnamespace AKRS.ZX2200.CalibSystem.GlobalCalibration;\r\n\r\npublic class GlobalCalibrationData\r\n{\r\n    #region private fields\r\n\r\n    private double worldX;\r\n    private double worldY;\r\n    private double axisX;\r\n    private double axisY;\r\n    private double scanAxisX;\r\n    private double scanAxisY;\r\n\r\n    #endregion\r\n\r\n    /// <summary>\r\n    /// 世界坐标X（标定板阵列点坐标系）\r\n    /// </summary>\r\n    public double WorldX\r\n    {\r\n        get => this.worldX;\r\n        set => this.worldX = RoundToFixedDecimal(value);\r\n    }\r\n\r\n    /// <summary>\r\n    /// 世界坐标Y（标定板阵列点坐标系）\r\n    /// </summary>\r\n    public double WorldY\r\n    {\r\n        get => this.worldY;\r\n        set => this.worldY = RoundToFixedDecimal(value);\r\n    }\r\n\r\n    /// <summary>\r\n    /// 轴坐标X（与标定板定位理论对应轴坐标）\r\n    /// </summary>\r\n    public double AxisX\r\n    {\r\n        get => this.axisX;\r\n        set => this.axisX = RoundToFixedDecimal(value);\r\n    }\r\n\r\n    /// <summary>\r\n    /// 轴坐标Y（与标定板定位理论对应轴坐标）\r\n    /// </summary>\r\n    public double AxisY\r\n    {\r\n        get => this.axisY;\r\n        set => this.axisY = RoundToFixedDecimal(value);\r\n    }\r\n\r\n    /// <summary>\r\n    /// 扫描时轴坐标X（扫描时轴坐标）\r\n    /// </summary>\r\n    public double ScanAxisX\r\n    {\r\n        get => this.scanAxisX;\r\n        set => this.scanAxisX = RoundToFixedDecimal(value);\r\n    }\r\n\r\n    /// <summary>\r\n    /// 扫描时轴坐标Y（扫描时轴坐标）\r\n    /// </summary>\r\n    public double ScanAxisY\r\n    {\r\n        get => this.scanAxisY;\r\n        set => this.scanAxisY = RoundToFixedDecimal(value);\r\n    }\r\n\r\n    /// <summary>\r\n    /// X方向差值（扫描轴坐标与理论轴坐标之差）\r\n    /// </summary>\r\n    [JsonIgnore]\r\n    public double OffsetX => MathService.DoubleEqual(0, this.ScanAxisX, this.ScanAxisY) ? 0 : RoundToFixedDecimal(this.ScanAxisX - this.AxisX);\r\n\r\n    /// <summary>\r\n    /// Y方向差值（扫描轴坐标与理论轴坐标之差）\r\n    /// </summary>\r\n    [JsonIgnore]\r\n    public double OffsetY => MathService.DoubleEqual(0, this.ScanAxisX, this.ScanAxisY) ? 0 : RoundToFixedDecimal(this.ScanAxisY - this.AxisY);\r\n\r\n    /// <summary>\r\n    /// 排序，左下角到右上角的顺序，S型路径\r\n    /// </summary>\r\n    /// <param name=\"dataList\"></param>\r\n    /// <returns></returns>\r\n    public static List<GlobalCalibrationData> Sort(List<GlobalCalibrationData> dataList)\r\n    {\r\n        // 按WorldY从小到大排序，再按WorldX从小到大排序\r\n        List<GlobalCalibrationData> sortedList =\r\n            dataList.OrderBy(data => data.WorldY).ThenBy(data => data.WorldX).ToList();\r\n        List<double> yCoordinates = sortedList.Select(data => data.WorldY).Distinct().ToList();\r\n        List<GlobalCalibrationData> sSortedList = new();\r\n        for (int i = 0; i < yCoordinates.Count; i++)\r\n        {\r\n            List<GlobalCalibrationData> currentRow = sortedList.Where(data => data.WorldY == yCoordinates[i]).ToList();\r\n            if (i % 2 == 1)\r\n            {\r\n                currentRow.Reverse();\r\n            }\r\n\r\n            sSortedList.AddRange(currentRow);\r\n        }\r\n\r\n        return sSortedList;\r\n    }\r\n\r\n    /// <summary>\r\n    /// 四舍五入到指定小数位数\r\n    /// </summary>\r\n    /// <param name=\"value\"></param>\r\n    /// <param name=\"decimalPlaces\"></param>\r\n    /// <returns></returns>\r\n    private static double RoundToFixedDecimal(double value, int decimalPlaces = 8)\r\n    {\r\n        return Math.Round(value, decimalPlaces);\r\n    }\r\n}","lineCount":124,"compileIncluded":true,"assemblies":["AKRS.ZX2200"],"declarations":[{"symbolId":"50d7d9e2956d87bcc2ae1b83","fileId":"08df0e613fa27eac05edba90","start":9,"end":124,"syntaxKind":"ClassDeclaration","label":"AKRS.ZX2200.CalibSystem.GlobalCalibration.GlobalCalibrationData","name":"GlobalCalibrationData","kind":"NamedType"},{"symbolId":"6ee2c48fe11daf2364e3d74e","fileId":"08df0e613fa27eac05edba90","start":13,"end":13,"syntaxKind":"VariableDeclarator","label":"AKRS.ZX2200.CalibSystem.GlobalCalibration.GlobalCalibrationData.worldX","name":"worldX","kind":"Field"},{"symbolId":"54b8b1b9bf1b1fb536f75699","fileId":"08df0e613fa27eac05edba90","start":14,"end":14,"syntaxKind":"VariableDeclarator","label":"AKRS.ZX2200.CalibSystem.GlobalCalibration.GlobalCalibrationData.worldY","name":"worldY","kind":"Field"},{"symbolId":"eb320ae60f9217213a0b84e6","fileId":"08df0e613fa27eac05edba90","start":15,"end":15,"syntaxKind":"VariableDeclarator","label":"AKRS.ZX2200.CalibSystem.GlobalCalibration.GlobalCalibrationData.axisX","name":"axisX","kind":"Field"},{"symbolId":"14cfb92d9687669cf4132a0a","fileId":"08df0e613fa27eac05edba90","start":16,"end":16,"syntaxKind":"VariableDeclarator","label":"AKRS.ZX2200.CalibSystem.GlobalCalibration.GlobalCalibrationData.axisY","name":"axisY","kind":"Field"},{"symbolId":"aaec43f1643dbdcf0fe6f85c","fileId":"08df0e613fa27eac05edba90","start":17,"end":17,"syntaxKind":"VariableDeclarator","label":"AKRS.ZX2200.CalibSystem.GlobalCalibration.GlobalCalibrationData.scanAxisX","name":"scanAxisX","kind":"Field"},{"symbolId":"8d9b72d85c49b4f3d04e38bf","fileId":"08df0e613fa27eac05edba90","start":18,"end":18,"syntaxKind":"VariableDeclarator","label":"AKRS.ZX2200.CalibSystem.GlobalCalibration.GlobalCalibrationData.scanAxisY","name":"scanAxisY","kind":"Field"},{"symbolId":"0008c8d8c41159c27a4fadab","fileId":"08df0e613fa27eac05edba90","start":25,"end":29,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.CalibSystem.GlobalCalibration.GlobalCalibrationData.WorldX","name":"WorldX","kind":"Property"},{"symbolId":"5851f684ca374a03ce612f75","fileId":"08df0e613fa27eac05edba90","start":27,"end":27,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.ZX2200.CalibSystem.GlobalCalibration.GlobalCalibrationData.get_WorldX","name":"get_WorldX","kind":"Method"},{"symbolId":"efbb1df8ef573a3a630784f6","fileId":"08df0e613fa27eac05edba90","start":28,"end":28,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.ZX2200.CalibSystem.GlobalCalibration.GlobalCalibrationData.set_WorldX(System.Double)","name":"set_WorldX","kind":"Method"},{"symbolId":"69d0f94f91c24a5f2bde6a03","fileId":"08df0e613fa27eac05edba90","start":34,"end":38,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.CalibSystem.GlobalCalibration.GlobalCalibrationData.WorldY","name":"WorldY","kind":"Property"},{"symbolId":"0d5cac61b3fd230f637c9fdb","fileId":"08df0e613fa27eac05edba90","start":36,"end":36,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.ZX2200.CalibSystem.GlobalCalibration.GlobalCalibrationData.get_WorldY","name":"get_WorldY","kind":"Method"},{"symbolId":"17d5df74560bcfa84841b84f","fileId":"08df0e613fa27eac05edba90","start":37,"end":37,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.ZX2200.CalibSystem.GlobalCalibration.GlobalCalibrationData.set_WorldY(System.Double)","name":"set_WorldY","kind":"Method"},{"symbolId":"6ba11fbfa7e561e97687317a","fileId":"08df0e613fa27eac05edba90","start":43,"end":47,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.CalibSystem.GlobalCalibration.GlobalCalibrationData.AxisX","name":"AxisX","kind":"Property"},{"symbolId":"24d9a7385ec6fea057653118","fileId":"08df0e613fa27eac05edba90","start":45,"end":45,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.ZX2200.CalibSystem.GlobalCalibration.GlobalCalibrationData.get_AxisX","name":"get_AxisX","kind":"Method"},{"symbolId":"0b5ba221bfc981b1bd522409","fileId":"08df0e613fa27eac05edba90","start":46,"end":46,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.ZX2200.CalibSyst