.Machine.Models.SignalPool.LoaderAllowPushSignal","name":"LoaderAllowPushSignal","kind":"Property"},{"symbolId":"dc7fe4d53005b5aaea6e9a0a","fileId":"2f31f78ff8f8fc400125b638","start":79,"end":79,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.Galaxy2.Machine.Models.SignalPool.get_LoaderAllowPushSignal","name":"get_LoaderAllowPushSignal","kind":"Method"},{"symbolId":"f51a77c1436bb9b6d49f22c6","fileId":"2f31f78ff8f8fc400125b638","start":79,"end":79,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.Galaxy2.Machine.Models.SignalPool.set_LoaderAllowPushSignal(AKRS.Galaxy2.Machine.Models.Signal)","name":"set_LoaderAllowPushSignal","kind":"Method"},{"symbolId":"388d9ae965facb45c0ecf74e","fileId":"2f31f78ff8f8fc400125b638","start":84,"end":84,"syntaxKind":"PropertyDeclaration","label":"AKRS.Galaxy2.Machine.Models.SignalPool.AllowDispense1TransferToDispense2Signal","name":"AllowDispense1TransferToDispense2Signal","kind":"Property"},{"symbolId":"eaf327e333923de803784c0e","fileId":"2f31f78ff8f8fc400125b638","start":84,"end":84,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.Galaxy2.Machine.Models.SignalPool.get_AllowDispense1TransferToDispense2Signal","name":"get_AllowDispense1TransferToDispense2Signal","kind":"Method"},{"symbolId":"6eed8843f880b59e8d51c33a","fileId":"2f31f78ff8f8fc400125b638","start":84,"end":84,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.Galaxy2.Machine.Models.SignalPool.set_AllowDispense1TransferToDispense2Signal(AKRS.Galaxy2.Machine.Models.Signal)","name":"set_AllowDispense1TransferToDispense2Signal","kind":"Method"},{"symbolId":"05317e4fb07da24f54dc9706","fileId":"2f31f78ff8f8fc400125b638","start":89,"end":89,"syntaxKind":"PropertyDeclaration","label":"AKRS.Galaxy2.Machine.Models.SignalPool.AllowDispenseTransferToBondSignal","name":"AllowDispenseTransferToBondSignal","kind":"Property"},{"symbolId":"c8ef181ee476a01290cdfd0c","fileId":"2f31f78ff8f8fc400125b638","start":89,"end":89,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.Galaxy2