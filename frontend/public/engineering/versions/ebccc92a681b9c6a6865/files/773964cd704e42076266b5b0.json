{"id":"773964cd704e42076266b5b0","path":"trunk/AKRS.ZX2200/BondSystem/Models/ActionNodes/Commons/PrecisionAcquisitionData.cs","moduleId":"a0a224c4ebd2e1afce11fca5","sha256":"67d9b4a5d0a321e43ed332c0344e664a3f9d7d87afeb2bff20aeb1d4c21d7a09","baselineSha256":"67d9b4a5d0a321e43ed332c0344e664a3f9d7d87afeb2bff20aeb1d4c21d7a09","current":true,"exists":true,"encoding":"utf-8","code":"using AKRS.Galaxy2.Infrastructure.CommonModel;\r\nusing AKRS.ZX2200.Infrastructure.Utils;\r\nusing DevExpress.DashboardCommon.Native;\r\nusing System;\r\nusing System.Collections.Generic;\r\nusing System.Linq;\r\nusing System.Text;\r\nusing System.Threading.Tasks;\r\n\r\nnamespace AKRS.ZX2200.BondSystem.Models.ActionNodes.Commons\r\n{\r\n    public class PrecisionAcquisitionDataContainer : SingletonNoSave<PrecisionAcquisitionDataContainer>\r\n    {\r\n        public List<PrecisionAcquisitionData> DataList { get; set; } = new List<PrecisionAcquisitionData>();\r\n\r\n        public PrecisionAcquisitionData Data { get; set; } = new PrecisionAcquisitionData();\r\n\r\n        public void CreateDataObject() \r\n        {\r\n            Data = new PrecisionAcquisitionData();\r\n        }\r\n\r\n        private int dataCount = 0;\r\n        \r\n        public void AddData()\r\n        {\r\n            dataCount++;\r\n\r\n            DataList.Add(Data);\r\n            this.CreateDataObject();\r\n        }\r\n\r\n        /// <summary>\r\n        /// 保存到Excel\r\n        /// </summary>\r\n        /// <param name=\"fileName\"></param>\r\n        public void SaveData(string fileName) \r\n        {\r\n            // 100 行保存一次\r\n            if (dataCount % 1000 == 0) \r\n            {\r\n                // 保存\r\n                FileHelper.Export2(DataList, fileName);\r\n            }\r\n        }\r\n    }\r\n\r\n    /// <summary>\r\n    /// 精度分析的过程数据采集\r\n    /// </summary>\r\n    public class PrecisionAcquisitionData\r\n    {\r\n        public string DTime { get; set; } = DateTime.Now.ToString(\"dd HH:mm:ss\");\r\n\r\n        public int ColumnIndex { get; set; }\r\n\r\n        \r\n        public int RowIndex { get; set; }\r\n\r\n        /**************************SubstrateCamerActionNode*************************/\r\n\r\n        /// <summary>\r\n        /// 放到中转台前芯片的角度 可能是焊后看出来的角度  温漂1 的激光干涉尺读数\r\n        /// </summary>\r\n        public double 放中转台前芯片的角度 { get; set; }\r\n\r\n        /// <summary>\r\n        /// 旋转带来的偏移量  温漂1 的定位结果\r\n        /// </summary>\r\n        public AKRSPoint2D 放中转台前的旋转偏移量 { get; set; } = new AKRSPoint2D();\r\n\r\n        /// <summary>\r\n        /// 放中转台位置  -- 温漂2 的定位结果\r\n        /// </summary>\r\n        public AKRSPoint4D 放中转台的位置 { get; set; } = new AKRSPoint4D();\r\n\r\n        public double 移动到中转台后的激光干涉尺读数 { get; set; }\r\n\r\n\r\n        public AKRSPoint3D 中转台拍照位置 { get; set; } = new AKRSPoint3D();\r\n\r\n        public AKRSPoint4D 移动到中转台拍照位后的编码器读数 { get; set; }\r\n\r\n        public double 移动到中转台拍照位后的干涉尺读数 { get; set; }\r\n\r\n        public AKRSPoint4D 中转台定位结果 { get; set; } = new AKRSPoint4D();\r\n\r\n        public AKRSPoint2D 取片焊头旋转后带来的偏移量 { get; set; } = new AKRSPoint2D();\r\n\r\n        public AKRSPoint3D 实际取片位置 { get; set; } = new AKRSPoint3D();\r\n\r\n        public AKRSPoint3D 中转台芯片偏移 { get; set; } = new AKRSPoint3D();\r\n\r\n        public AKRSPoint4D 运动到的预取晶位置 { get; set; } = new AKRSPoint4D();\r\n\r\n        public double 运动到预取晶位置的干涉尺读数 { get; set; }\r\n\r\n\r\n\r\n\r\n\r\n        public AKRSPoint4D 固晶位置 { get; set; } = new AKRSPoint4D();\r\n        public AKRSPoint4D 固晶编码器位置 { get; set; } = new AKRSPoint4D();\r\n        public double 移动到固晶位置后的干涉尺读数 { get; set; }\r\n\r\n\r\n        public AKRSPoint3D 焊后拍照位置G0 { get; set; } = new AKRSPoint3D();\r\n        public double 移动到焊后位置后的干涉尺读数 { get; set; }\r\n\r\n        public AKRSPoint4D 焊后定位拍照结果 { get; set; } = new AKRSPoint4D();\r\n        public AKRSPoint4D 焊后定位结果 { get; set; } = new AKRSPoint4D();\r\n    }\r\n}\r\n","lineCount":114,"compileIncluded":true,"assemblies":["AKRS.ZX2200"],"declarations":[{"symbolId":"6b45dfed63afaddbd6d16bd9","fileId":"773964cd704e42076266b5b0","start":12,"end":46,"syntaxKind":"ClassDeclaration","label":"AKRS.ZX2200.BondSystem.Models.ActionNodes.Commons.PrecisionAcquisitionDataContainer","name":"PrecisionAcquisitionDataContainer","kind":"NamedType"},{"symbolId":"83ab938481370203ddde5f3e","fileId":"773964cd704e42076266b5b0","start":14,"end":14,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.BondSystem.Models.ActionNodes.Commons.PrecisionAcquisitionDataContainer.DataList","name":"DataList","kind":"Property"},{"symbolId":"902f3ba6ab90738827296fd3","fileId":"773964cd704e42076266b5b0","start":14,"end":14,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.ZX2200.BondSystem.Models.ActionNodes.Commons.PrecisionAcquisitionDataContainer.get_DataList","name":"get_DataList","kind":"Method"},{"symbolId":"5a21877d7909ef71b946b006","fileId":"773964cd704e42076266b5b0","start":14,"end":14,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.ZX2200.BondSystem.Models.ActionNodes.Commons.PrecisionAcquisitionDataContainer.set_DataList(System.Collections.Generic.List{AKRS.ZX2200.BondSystem.Models.ActionNodes.Commons.PrecisionAcquisitionData})","name":"set_DataList","kind":"Method"},{"symbolId":"7e88c156605520f53961e68f","fileId":"773964cd704e42076266b5b0","start":16,"end":16,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.BondSystem.Models.ActionNodes.Commons.PrecisionAcquisitionDataContainer.Data","name":"Data","kind":"Property"},{"symbolId":"13cbd77f06f1f37d7b808c5a","fileId":"773964cd704e42076266b5b0","start":16,"end":16,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.ZX2200.BondSystem.Models.ActionNodes.Commons.PrecisionAcquisitionDataContainer.get_Data","name":"get_Data","kind":"Method"},{"symbolId":"d7d9f41ceddb1fce63c917c1","fileId":"773964cd704e42076266b5b0","start":16,"end":16,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.ZX2200.BondSystem.Models.ActionNodes.Commons.PrecisionAcquisitionDataContainer