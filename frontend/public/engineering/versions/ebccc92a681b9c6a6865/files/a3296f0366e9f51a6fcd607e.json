{"id":"a3296f0366e9f51a6fcd607e","path":"trunk/AKRS.ZX2200/TransportUnitSystem/Module/Config/OppositeConfig.cs","moduleId":"b629c57892dad9b04315dc8b","sha256":"46f9fb896656f6cb1a4a50b7bc2c8a9a46a7a39d747d5cf8020177aac68334b2","baselineSha256":"46f9fb896656f6cb1a4a50b7bc2c8a9a46a7a39d747d5cf8020177aac68334b2","current":true,"exists":true,"encoding":"utf-8","code":"using AKRS.Galaxy2.Infrastructure.CommonModel;\r\nusing System;\r\nusing System.Collections.Generic;\r\nusing System.Linq;\r\nusing System.Text;\r\nusing System.Threading.Tasks;\r\n\r\nnamespace AKRS.ZX2200.TransportUnitSystem.Module.Config\r\n{\r\n    using AKRS.ZX2200.BondSystem.Models.Repositories.PostBondInspection;\r\n    using AKRS.ZX2200.SupportFeature.Parameters.Model;\r\n\r\n    using Newtonsoft.Json;\r\n\r\n    /// <summary>\r\n    /// 异性配置文件\r\n    /// </summary>\r\n    public class OppositeSexConfig : BaseConfig\r\n    {\r\n        /// <summary>\r\n        /// 名称\r\n        /// </summary>\r\n        public string Name { get; set; }\r\n\r\n        /// <summary>\r\n        /// 是否点胶\r\n        /// </summary>\r\n        public bool Dispense { get; set; }\r\n\r\n        /// <summary>\r\n        /// 是否贴片\r\n        /// </summary>\r\n        public bool BondComponent { get; set; }\r\n\r\n        /// <summary>\r\n        /// 是否胶检\r\n        /// </summary>\r\n        public bool EpoxyCheck { get; set; }\r\n\r\n        /// <summary>\r\n        /// 是否焊后\r\n        /// </summary>\r\n        public bool AfterBond { get; set; }\r\n\r\n        /// <summary>\r\n        /// 点胶名称\r\n        /// </summary>\r\n        public string DispenseName { get; set; }\r\n\r\n        /// <summary>\r\n        /// 贴片名称\r\n        /// </summary>\r\n        public string BondComponentName { get; set; }\r\n\r\n        /// <summary>\r\n        /// 胶检名称\r\n        /// </summary>\r\n        public string EpoxyCheckName { get; set; }\r\n\r\n        /// <summary>\r\n        /// 焊后名称\r\n        /// </summary>\r\n        public string AfterBondName { get; set; }\r\n\r\n        /// <summary>\r\n        /// 视觉否示教成功\r\n        /// </summary>\r\n        public bool IsPrAssistant { get; set; } = true;\r\n\r\n        /// <summary>\r\n        /// 测高是否示教成功\r\n        /// </summary>\r\n        public bool IsMeasureHeightAssistant { get; set; } = true;\r\n\r\n        /// <summary>\r\n        /// 胶量检测是否成功\r\n        /// </summary>\r\n        [JsonIgnore]\r\n        public bool IsEpoxyCheckAssistant => this.GetIsEpoxyCheckAssistant();\r\n\r\n        /// <summary>\r\n        /// 焊后检测是否成功\r\n        /// </summary>\r\n        [JsonIgnore]\r\n        public bool IsAfterBondAssistant => this.GetIsIsAfterBondAssistant();\r\n\r\n        /// <summary>\r\n        /// 胶量检测是否示教成功\r\n        /// </summary>\r\n        /// <returns>结果</returns>\r\n        public bool GetIsEpoxyCheckAssistant()\r\n        {\r\n            if (!this.EpoxyCheck)\r\n            {\r\n                return true;\r\n            }\r\n            else\r\n            {\r\n                PostBondInspection postBondInspection =\r\n                    (PostBondInspection)PostBondInspectionRepository.GetInstance().Find(this.EpoxyCheckName);\r\n                if (postBondInspection == null)\r\n                {\r\n                    return false;\r\n                }\r\n\r\n                return postBondInspection.IsAssistantSucceed;\r\n            }\r\n        }\r\n\r\n        /// <summary>\r\n        /// 胶量检测是否示教成功\r\n        /// </summary>\r\n        /// <returns>结果</returns>\r\n        public bool GetIsIsAfterBondAssistant()\r\n        {\r\n            if (!this.AfterBond)\r\n            {\r\n                return true;\r\n            }\r\n            else\r\n            {\r\n                PostBondInspection postBondInspection =\r\n                    (PostBondInspection)PostBondInspectionRepository.GetInstance().Find(this.AfterBondName);\r\n                if (postBondInspection == null)\r\n                {\r\n                    return false;\r\n                }\r\n\r\n                return postBondInspection.IsAssistantSucceed;\r\n            }\r\n        }\r\n\r\n        /// <summary>\r\n        /// 位置补偿\r\n        /// </summary>\r\n        public AKRSPoint3D PositionCompensate { get; set; } = new AKRSPoint3D();\r\n\r\n        /// <summary>\r\n        /// 角度补偿\r\n        /// </summary>\r\n        public double AngleCompensate { get; set; }\r\n\r\n        /// <summary>\r\n        /// 点胶位置\r\n        /// </summary>\r\n        public AKRSPoint3D DispensePositionCompensate { get; set; } = new AKRSPoint3D();\r\n\r\n        /// <summary>\r\n        /// 点胶角度补偿\r\n        /// </summary>\r\n        public double DispenseAngleCompensate { get; set; }\r\n\r\n        /// <summary>\r\n        /// 是不是镜像\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"镜像焊点\")]\r\n        public bool IsMirror { get; set; } = false;\r\n    }\r\n}\r\n","lineCount":160,"compileIncluded":true,"assemblies":["AKRS.ZX2200"],"declarations":[{"symbolId":"0e870e5ea04395d1c51075b2","fileId":"a3296f0366e9f51a6fcd607e","start":18,"end":158,"syntaxKind":"ClassDeclaration","label":"AKRS.ZX2200.TransportUnitSystem.Module.Config.OppositeSexConfig","name":"OppositeSexConfig","kind":"NamedType"},{"symbolId":"f6c33332fe37add2e88d6ca7","fileId":"a3296f0366e9f51a6fcd607e","start":23,"end":23,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.TransportUnitSystem.Module.Config.OppositeSexConfig.Name","name":"Name","kind":"Property"},{"symbolId":"4bb16a7910179aee28a53a5c","fileId":"a3296f0366e9f51a6fcd607e","start":23,"end":23,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.ZX2200.TransportUnitSystem.Module.Config.OppositeSexConfig.get_Name","name":"get_Name","kind":"Method"},{"symbolId":"d87e412522829b1d2b75f52c","fileId":"a3296f0366e9f51a6fcd607e","start":23,"end":23,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.ZX2200.TransportUnitSystem.Module.Config.OppositeSexConfig.set_Name(System.String)","name":"set_Name","kind":"Metho