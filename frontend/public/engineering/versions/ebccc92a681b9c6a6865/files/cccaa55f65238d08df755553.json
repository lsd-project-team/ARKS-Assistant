/// <summary>\r\n        /// 加热温度\r\n        /// </summary>\r\n        public int HeaterTemperature { get; set; } = 100;\r\n\r\n        /// <summary>\r\n        /// 报警温度\r\n        /// </summary>\r\n        public int AlarmTemperature { get; set; } = 5;\r\n\r\n        /// <summary>\r\n        /// 补偿温度\r\n        /// </summary>\r\n        public double CompensateTemperature { get; set; } = 0;\r\n\r\n        /// <summary>\r\n        /// 补偿斜率\r\n        /// </summary>\r\n        public double CompensateSlope { get; set; } = 1.0;\r\n\r\n        /// <summary>\r\n        /// 预热时间\r\n        /// </summary>\r\n        public int PreheatTime { get; set; } = 5;\r\n\r\n        /// <summary>\r\n        /// 检测真空时间\r\n        /// </summary>\r\n        public int CheckVacuumTime { get; set; } = 1000;\r\n\r\n        /// <summary>\r\n        /// 挡料气缸相关设置的名称\r\n        /// </summary>\r\n        public string BondinsertSettingName { get; set; } = string.Empty;\r\n\r\n        /// <summary>\r\n        /// 挡料气缸相关设置的对象\r\n        /// </summary>\r\n        [JsonIgnore]\r\n        public BondinsertSetting BondinsertSetting =>\r\n            (BondinsertSetting)BondinsertSettingRepository.GetInstance().Find(this.BondinsertSettingName);\r\n\r\n\r\n        /// <summary>\r\n        /// 结果\r\n        /// </summary>\r\n        /// <returns>是否为Null</returns>\r\n        public bool IsSettingNull()\r\n        {\r\n            if (TransportBeltSetting == null)\r\n            {\r\n                AKRSXtraMessageBox.Show(\"Bond SubSection Transport BeltSetting is Null\");\r\n                return false;\r\n            }\r\n\r\n            if (BondinsertSetting == null)\r\n            {\r\n                AKRSXtraMessageBox.Show(\"Bond SubSection BeltSetting is Null\");\r\n                return false;\r\n            }\r\n\r\n            return true;\r\n        }\r\n    }\r\n\r\n    /// <summary>\r\n    /// 载具大小\r\n    /// </summary>\r\n    public enum BondMaxSubSectionSizeEnum\r\n    {\r\n        /// <summary>\r\n        /// 中\r\n        /// </summary>\r\n        [Description(\"中\")]\r\n        Middle,\r\n\r\n        /// <summary>\r\n        /// 中\r\n        /// </summary>\r\n        [Description(\"中前\")]\r\n        MiddleAndFront,\r\n\r\n        /// <summary>\r\n        /// 大\r\n        /// </summary>\r\n        [Description(\"中右\")]\r\n        MaxRight,\r\n\r\n        /// <summary>\r\n        /// 大\r\n        /// </summary>\r\n        [Description(\"全部\")]\r\n        All\r\n    }\r\n}\r\n","lineCount":148,"compileIncluded":true,"assemblies":["AKRS.ZX2200"],"declarations":[{"symbolId":"a631992e93bcd4b52b58a19e","fileId":"cccaa55f65238d08df755553","start":34,"end":116,"syntaxKind":"ClassDeclaration","label":"AKRS.ZX2200.TransportSystem.Models.Programs.BondSubSectionProgram","name":"BondSubSectionProgram","kind":"NamedType"},{"symbolId":"85cb728dd9fad7c4031da41e","fileId":"cccaa55f65238d08df755553","start":39,"end":39,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.TransportSystem.Models.Programs.BondSubSectionProgram.TransportBeltSettingName","name":"TransportBeltSettingName","kind":"Property"},{"symbolId":"17ebd1c6ec9b9d923322d009","fileId":"cccaa55f65238d08df755553","start":39,"end":39,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.ZX2200.TransportSystem.Models.Programs.BondSubSectionProgram.get_TransportBeltSettingName","name":"get_TransportBeltSettingName","kind":"Method"},{"symbolId":"5b69ee2afb1ad40d12073c3d","fileId":"cccaa55f65238d08df755553","start":39,"end":39,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.ZX2200.TransportSystem.Models.Programs.BondSubSectionProgram.set_TransportBeltSettingName(System.String)","name":"set_TransportBeltSettingName","kind":"Method"},{"symbolId":"910c5d7c7c01e5e87e9b0e79","fileId":"cccaa55f65238d08df755553","start":44,"end":46,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.TransportSystem.Models.Programs.BondSubSectionProgram.TransportBeltSetting","name":"TransportBeltSetting","kind":"Property"},