{"id":"f0931ff69b3fc8648ee3c443","path":"trunk/AKRS.Galaxy2.AxisCompensate/AxisCompensate/SegmentedCompensation.cs","moduleId":"970a734c03a493dd71885e68","sha256":"7c4d3d3197fe8a98d012524989fc1faca53e77c60f4702ddc20c447058d39433","baselineSha256":"7c4d3d3197fe8a98d012524989fc1faca53e77c60f4702ddc20c447058d39433","current":true,"exists":true,"encoding":"utf-8","code":"using System;\r\nusing System.Collections.Generic;\r\nusing System.Linq;\r\nusing System.Text;\r\nusing System.Threading.Tasks;\r\n\r\nnamespace AKRS.Galaxy2.AxisCompensate.AxisCompensate\r\n{\r\n    using System.Security.Cryptography.X509Certificates;\r\n\r\n    /// <summary>\r\n    /// 轴的标定\r\n    /// </summary>\r\n    public class SegmentedCompensation\r\n    {\r\n        /// <summary>\r\n        /// 标定的集合\r\n        /// </summary>\r\n        public List<double>[] CalibrationList { get; set; } = new List<double>[80];\r\n\r\n        /// <summary>\r\n        /// 间距\r\n        /// </summary>\r\n        public double Spacing { get; set; } = 3;\r\n\r\n        /// <summary>\r\n        /// 起始的位置\r\n        /// </summary>\r\n        public double StartPos { get; set; } = 0;\r\n\r\n        /// <summary>\r\n        /// 轴的位置\r\n        /// </summary>\r\n        /// <param name=\"axisPos\">轴目标位置</param>\r\n        /// <returns>轴补偿之后的位置</returns>\r\n        public double GetOffset(double axisPos)\r\n        {\r\n            // 判断X轴是否在此补偿区域\r\n            if (axisPos < this.StartPos || axisPos > this.StartPos + this.Spacing * this.CalibrationList.Length)\r\n            {\r\n                return axisPos;\r\n            }\r\n\r\n            // 如果在此补偿区域，将进行补偿\r\n            return axisPos;\r\n        }\r\n    }\r\n}\r\n","lineCount":49,"compileIncluded":true,"assemblies":["AKRS.Galaxy2.AxisCompensate"],"declarations":[{"symbolId":"69965aac3a511b47c309ef3b","fileId":"f0931ff69b3fc8648ee3c443","start":14,"end":47,"syntaxKind":"ClassDeclaration","label":"AKRS.Galaxy2.AxisCompensate.AxisCompensate.SegmentedCompensation","name":"SegmentedCompensation","kind":"NamedType"},{"symbolId":"05b6ef01ecef30a28e260b4e","fileId":"f0931ff69b3fc8648ee3c443","start":19,"end":19,"syntaxKind":"PropertyDeclaration","label":"AKRS.Galaxy2.AxisCompensate.AxisCompensate.SegmentedCompensation.CalibrationList","name":"CalibrationList","kind":"Property"},{"symbolId":"5cba37d7b6a844d52e6c8d8a","fileId":"f0931ff69b3fc8648ee3c443","start":19,"end":19,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.Galaxy2.AxisCompensate.AxisCompensate.SegmentedCompensation.get_CalibrationList","name":"get_CalibrationList","kind":"Method"},{"symbolId":"ab1173b5fb7f27f218ff026e","fileId":"f0931ff69b3fc8648ee3c443","start":19,"end":19,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.Galaxy2.AxisCompensate.AxisCompensate.SegmentedCompensation.set_CalibrationList(System.Collections.Generic.List{System.Double}[])","name":"set_CalibrationList","kind":"Method"},{"symbolId":"9d53697088ecc43c5465d4c3","fileId":"f0931ff69b3fc8648ee3c443","start":24,"end":24,"syntaxKind":"PropertyDeclaration","label":"AKRS.Galaxy2.AxisCompensate.AxisCompensate.SegmentedCompensation.Spacing","name":"Spacing","kind":"Property"},{"symbolId":"47ac3f1255d9ff9221a10c98","fileId":"f0931ff69b3fc8648ee3c443","start":24,"end":24,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.Galaxy2.AxisCompensate.AxisCompensate.SegmentedCompensation.get_Spacing","name":"get_Spacing","kind":"Method"},{"symbolId":"815b2fe073f319432c3891cb","fileId":"f0931ff69b3fc8648ee3c443","start":24,"end":24,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.Galaxy2.AxisCompensate.AxisCompensate.SegmentedCompensation.set_Spacing(System.Double)","name":"set_Spacing","kind":"Method"},{"symbolId":"2041ed793abeb3358fe8fe4e","fileId":"f0931ff69b3fc8648ee3c443","start":29,"end":29,"syntaxKind":"PropertyDeclaration","label":"AKRS.Galaxy2.AxisCompensate.AxisCompensate.SegmentedCompensation.StartPos","name":"StartPos","kind":"Property"},{"symbolId":"ce34b51e268ddc73c2fbf63f","fileId":"f093