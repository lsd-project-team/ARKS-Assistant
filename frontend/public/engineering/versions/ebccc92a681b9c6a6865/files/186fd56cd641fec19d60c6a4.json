{"id":"186fd56cd641fec19d60c6a4","path":"trunk/AKRS.ZX2200/BondSystem/Models/DeviceParams/NozzleShelfParam.cs","moduleId":"a0a224c4ebd2e1afce11fca5","sha256":"70f887b4b6ade304a2f0ecf0c5c62ead0a6634b4969ae00c72834e857a28173e","baselineSha256":"70f887b4b6ade304a2f0ecf0c5c62ead0a6634b4969ae00c72834e857a28173e","current":true,"exists":true,"encoding":"utf-8","code":"using System;\r\nusing AKRS.Galaxy2.Infrastructure.CommonModel;\r\nusing AKRS.ZX2200.Infrastructure.AOP.Module;\r\nusing AKRS.ZX2200.Infrastructure.Models.Enums;\r\nusing AKRS.ZX2200.SupportFeature.Parameters;\r\nusing AKRS.ZX2200.SupportFeature.Parameters.Model;\r\nusing PropertyChanged;\r\n\r\nnamespace AKRS.ZX2200.BondSystem.Models.DeviceParams\r\n{\r\n    /// <summary>\r\n    /// 吸嘴架设备参数，都是关于G0\r\n    /// </summary>\r\n    [Serializable]\r\n    [AddINotifyPropertyChangedInterface]\r\n    public class NozzleShelfParam : PropertyChangeAop\r\n    {\r\n        /// <summary>\r\n        /// 吸嘴槽数量\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"吸嘴槽数量\", \"\", true, \"个\", RoleEnum.Admin)]\r\n        public int SlotNum { get; set; } = 7;\r\n\r\n        /// <summary>\r\n        /// 吸嘴架换吸嘴位\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"吸嘴架换吸嘴位\", \"吸嘴架\", UnitHelper.mm, RoleEnum.Admin)]\r\n        public AKRSPoint3D ToolChangePosition { get; set; }\r\n\r\n        /// <summary>\r\n        /// 换吸嘴Y向二段速距离\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"换吸嘴Y向二段速距离\", \"吸嘴架\", 1, 50, UnitHelper.mm, RoleEnum.Admin)]\r\n        public double ChangeToolDistanceY { get; set; } = 30;\r\n\r\n        /// <summary>\r\n        /// 换吸嘴Z向二段速距离\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"换吸嘴Z向二段速距离\", \"吸嘴架\", 1, 50, UnitHelper.mm, RoleEnum.Admin)]\r\n        public double ChangeToolDistanceZ { get; set; }\r\n\r\n        /// <summary>\r\n        /// 吸嘴进入槽位慢速速度\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"吸嘴进入槽位慢速速度(Y向)\", \"吸嘴架\", 0, 200, UnitHelper.speed, RoleEnum.Admin)]\r\n        public double SlowTravelToSlotSpeed { get; set; } = 5;\r\n\r\n        /// <summary>\r\n        /// 吸嘴离开槽位慢速速度\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"吸嘴离开槽位慢速速度(Y向)\", \"吸嘴架\", 0, 200, UnitHelper.speed, RoleEnum.Admin)]\r\n        public double SlowTravelAwayFromSlotSpeed { get; set; } = 5;\r\n\r\n        /// <summary>\r\n        /// 吸嘴慢速下压速度\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"吸嘴慢速下压速度(Z向)\", \"吸嘴架\", 0, 250, UnitHelper.speed, RoleEnum.Admin)]\r\n        public double SlowTravelDownSpeed { get; set; } = 5;\r\n\r\n        /// <summary>\r\n        /// 吸嘴慢速上抬速度\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"吸嘴慢速上抬速度(Z向)\", \"吸嘴架\", 0, 250, UnitHelper.speed, RoleEnum.Admin)]\r\n        public double SlowTravelUpSpeed { get; set; } = 5;\r\n\r\n        /// <summary>\r\n        /// 吸嘴架换吸嘴位角度,暂时不用统一的角度，改成一个槽位对应一个角度\r\n        /// </summary>\r\n        public double ToolChangePositionTheta { get; set; }\r\n\r\n        /// <summary>\r\n        /// 吸嘴槽间距\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"吸嘴槽间距\", \"吸嘴架\", false, UnitHelper.mm, RoleEnum.Admin)]\r\n        public double SlotPitch { get; set; }\r\n\r\n        /// <summary>\r\n        /// 吸嘴归还位置\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"吸嘴归还位置\", (TreeGroupChildNodesEnum[])null)]\r\n        public AKRSPoint3D[] PlaceNozzlePos { get; set; } = new AKRSPoint3D[7]\r\n                                                                 {\r\n                                                                     new AKRSPoint3D(),\r\n                                                                     new AKRSPoint3D(),\r\n                                                                     new AKRSPoint3D(),\r\n                                                                     new AKRSPoint3D(),\r\n                                                                     new AKRSPoint3D(),\r\n                                                                     new AKRSPoint3D(),\r\n                                                                     new AKRSPoint3D(),\r\n                                                                 };\r\n\r\n        /// <summary>\r\n        /// 还吸嘴角度\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"还吸嘴角度\", (TreeGroupChildNodesEnum[])null, UnitHelper.degree, RoleEnum.Admin)]\r\n        public double[] PlaceNozzleAngle { get; set; } = new double[7];\r\n\r\n        /// <summary>\r\n        /// 取吸嘴位置\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"取吸嘴位置\", (TreeGroupChildNodesEnum[])null, UnitHelper.mm, RoleEnum.Admin)]\r\n        public AKRSPoint3D[] PickNozzlePos { get; set; } = new AKRSPoint3D[7]\r\n                                                                 {\r\n                                                                     new AKRSPoint3D(),\r\n                                                                     new AKRSPoint3D(),\r\n                                                                     new AKRSPoint3D(),\r\n                                                                     new AKRSPoint3D(),\r\n                                                                     new AKRSPoint3D(),\r\n                                                                     new AKRSPoint3D(),\r\n                                                                     new AKRSPoint3D(),\r\n                                                                 };\r\n\r\n        /// <summary>\r\n        /// 取吸嘴角度\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"取吸嘴角度\", (TreeGroupChildNodesEnum[])null, UnitHelper.degree, RoleEnum.Admin)]\r\n        public double[] PickNozzleAngle { get; set; } = new double[7];\r\n\r\n        /// <summary>\r\n        /// 吸嘴架标定治具几何数据\r\n        /// todo:由机械给出，写死\r\n        /// </summary>\r\n        public AKRSPoint2D TCCaliToolGeometry { get; set; } = new AKRSPoint2D();\r\n\r\n        /// <summary>\r\n        /// 吸嘴架治具高度和吸嘴槽高度差值\r\n        /// todo:试出来，写死\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"吸嘴架治具高度和吸嘴槽高度差值\", (TreeGroupChildNodesEnum[])null, UnitHelper.mm, RoleEnum.Admin)]\r\n        public double TCCaliToolHeightOffset { get; set; } = 6.6126;\r\n\r\n        /// <summary>\r\n        /// 取放吸嘴位置高度偏差\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"取放吸嘴位置高度偏差\", (TreeGroupChildNodesEnum[])null, UnitHelper.mm, RoleEnum.Admin)]\r\n        public double PlacePickPosHeightOffset { get; set; } = 0;\r\n\r\n        /// <summary>\r\n        /// 吸嘴架标定治具和焊头中心的偏移\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"吸嘴架标定治具和焊头中心的偏移\",\"\",false, UnitHelper.mm, RoleEnum.Admin)]\r\n        public AKRSPoint3D CaliToolToBondheadCenterOffset { get; set; } = new AKRSPoint3D();\r\n\r\n        /// <summary>\r\n        /// 槽1视觉位\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"槽1视觉位\", \"\", false, UnitHelper.mm, RoleEnum.Admin)]\r\n        public AKRSPoint3D Slot1VisionPos { get; set; } = new AKRSPoint3D();\r\n\r\n        /// <summary>\r\n        /// 槽1视觉位\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"槽7视觉位\", \"\", false, UnitHelper.mm, RoleEnum.Admin)]\r\n        public AKRSPoint3D Slot7VisionPos { get; set; } = new AKRSPoint3D();\r\n\r\n        /// <summary>\r\n        /// 槽1视觉位\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"吸嘴架测高结果\", \"\", false, UnitHelper.mm, RoleEnum.Admin)]\r\n        public AKRSPoint3D NozzleShelfHeight { get; set; } = new AKRSPoint3D();\r\n\r\n        /// <summary>\r\n        /// 参数是否为空\r\n        /// </summary>\r\n        /// <returns>结果</returns>\r\n        public bool IsEmpty()\r\n        {\r\n            foreach (var pos in this.PickNozzlePos)\r\n            {\r\n                if (pos.IsEmpty)\r\n                {\r\n                    return true;\r\n                }\r\n            }\r\n\r\n            foreach (var pos in this.PlaceNozzlePos)\r\n            {\r\n                if (pos.IsEmpty)\r\n                {\r\n                    return true;\r\n                }\r\n            }\r\n\r\n            return false;\r\n        }\r\n    }\r\n}\r\n","lineCount":188,"compileIncluded":true,"assemblies":["AKRS.ZX2200"],"declarations":[{"symbolId":"3cdfddcb327a7e6acf0698fd","fileId":"186fd56cd641fec19d60c6a4","start":14,"end":186,"syntaxKind":"ClassDeclaration","label":"AKRS.ZX2200.BondSystem.Models.DeviceParams.NozzleShelfParam","name":"NozzleShelfParam","kind":"NamedType"},{"symbolId":"663889f889b774ac1003604d","fileId":"186fd56cd641fec19d60c6a4","start":21,"end":22,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.BondSystem.Models.DeviceParams.NozzleShelfParam.SlotNum","name":"SlotNum","kind":"Property"},{"symbolId":"b2e6fc6e521d72e39c7be2d6","fileId":"186fd56cd641fec19d60c6a4","start":22,"end":22,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.ZX2200.BondSystem.Models.DeviceParams.NozzleShelfParam.get_SlotNum","name":"get_SlotNum","kind":"Method"},{"symbolId":"9a03736d4ca225ae4b9c1ee2","fileId":"186fd56cd641fec19d60c6a4","start":22,"end":22,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.ZX2200.BondSystem.Models.DeviceParams.NozzleShelfParam.set_SlotNum(System.Int32)","name":"set_SlotNum","kind":"Method"},{"symbolId":"19384f1353b6eb080ed87c9e","fileId":"186fd56cd641fec19d60c6a4","start":27,"end":28,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.BondSystem.Models.DeviceParams.NozzleShelfParam.ToolChangePosition","name":"ToolChangePosition","kind":"Property"},{"symbolId":"98230c3fa93079bd0828c49d","fileId":"186fd56cd641fec19d60c6a4","start":28,"end":28,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.ZX2200.BondSystem.Models.DeviceParams.NozzleShelfParam.get_ToolChangePosition","name":"get_ToolChangePosition","kind":"Method"},{"symbolId":"d5633f822817f56ea5412c5f","fileId":"186fd56cd641fec19d60c6a4","start":28,"end":28,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.ZX2200.BondSystem.Mod