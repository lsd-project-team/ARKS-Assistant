{"id":"fd7e2dd699c939f856767d86","path":"trunk/AKRS.ZX2200/TransportUnitSystem/Model/VisionResult.cs","moduleId":"b629c57892dad9b04315dc8b","sha256":"ac0567ac9c60c181cf5293afc9ea6541b326da1517746be92bab2e9d65f7d2d3","baselineSha256":"ac0567ac9c60c181cf5293afc9ea6541b326da1517746be92bab2e9d65f7d2d3","current":true,"exists":true,"encoding":"utf-8","code":"using AKRS.Galaxy2.Infrastructure.CommonModel;\r\nusing AKRS.Galaxy2.PR.Models.MatchResults;\r\n\r\nnamespace AKRS.ZX2200.TransportUnitSystem.Model\r\n{\r\n    using System.Drawing;\r\n\r\n    /// <summary>\r\n    /// 视觉定位的结果\r\n    /// </summary>\r\n    public class VisionResult\r\n    {\r\n        /// <summary>\r\n        /// 定位是否成功\r\n        /// </summary>\r\n        public bool IsVisionSuccess { get; set; } = false;\r\n\r\n        /// <summary>\r\n        /// 定位结果\r\n        /// </summary>\r\n        public MatchResult MatchResult { get; set; }\r\n\r\n        /// <summary>\r\n        /// 定位结果在自己坐标系的坐标\r\n        /// </summary>\r\n        public AKRSPoint3D ResultPoint3D { get; set; }\r\n\r\n        /// <summary>\r\n        /// 定位结果在G0中的坐标\r\n        /// </summary>\r\n        public AKRSPoint3D ResultPoint3DInG0 { get; set; }\r\n\r\n        /// <summary>\r\n        /// G0中的拍照位\r\n        /// </summary>\r\n        public AKRSPoint3D VisionPoint3DInG0 { get; set; }\r\n\r\n        /// <summary>\r\n        /// 拍照时的点位(机械坐标系)\r\n        /// </summary>\r\n        public AKRSPoint3D VisionPos { get; set; }\r\n\r\n        /// <summary>\r\n        /// 图片\r\n        /// </summary>\r\n        public Bitmap Bitmap { get; set; }\r\n\r\n        /// <summary>\r\n        /// 是否更新过\r\n        /// </summary>\r\n        public bool IsUpData { get; set; } = false;\r\n\r\n        /// <summary>\r\n        /// 保存信息\r\n        /// </summary>\r\n        /// <param name=\"matchResult\">定位结果</param>\r\n        /// <param name=\"resultPoint3D\">定位结果在自己坐标系的坐标</param>\r\n        /// <param name=\"resultPoint3DInG0\">定位结果在G0中的坐标</param>\r\n        /// <param name=\"visionPoint3DInG0\">G0中的拍照位</param>\r\n        public void SaveInfo(MatchResult matchResult, AKRSPoint3D resultPoint3D, AKRSPoint3D resultPoint3DInG0, AKRSPoint3D visionPoint3DInG0)\r\n        {\r\n            this.MatchResult = new MatchResult(matchResult.CenterX, matchResult.CenterY, matchResult.Angle);\r\n            this.ResultPoint3D = resultPoint3D;\r\n            this.ResultPoint3DInG0 = resultPoint3DInG0;\r\n            this.VisionPoint3DInG0 = visionPoint3DInG0;\r\n            this.IsVisionSuccess = true;\r\n            this.IsUpData = true;\r\n        }\r\n\r\n        /// <summary>\r\n        /// 保存信息\r\n        /// </summary>\r\n        /// <param name=\"visionPoint3DInMachine\">机械位置</param>\r\n        /// <param name=\"bitmap\">获取的图片</param>\r\n        public void SaveInfo(AKRSPoint3D visionPoint3DInMachine, Bitmap bitmap)\r\n        {\r\n            this.VisionPos = visionPoint3DInMachine;\r\n            this.Bitmap = bitmap;\r\n        }\r\n    }\r\n}\r\n","lineCount":82,"compileIncluded":true,"assemblies":["AKRS.ZX2200"],"declarations":[{"symbolId":"eb8547e6fa990ece906a5aa1","fileId":"fd7e2dd699c939f856767d86","start":11,"end":80,"syntaxKind":"ClassDeclaration","label":"AKRS.ZX2200.TransportUnitSystem.Model.VisionResult","name":"VisionResult","kind":"NamedType"},{"symbolId":"4dcc64d3eda72e24e20446f3","fileId":"fd7e2dd699c939f856767d86","start":16,"end":16,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.TransportUnitSystem.Model.VisionResult.IsVisionSuccess","name":"IsVisionSuccess","kind":"Property"},{"symbolId":"a9d6789f7c7bf75c8681ab3d","fileId":"fd7e2dd699c939f856767d86","start":16,"end":16,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.ZX2200.TransportUnitSystem.Model.VisionResult.get_IsVisionSuccess","name":"get_IsVisionSuccess","kind":"Method"},{"symbolId":"01a5b6788ce657d220682ab9","fileId":"fd7e2dd699c939f856767d86","start":16,"end":16,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.ZX2200.TransportUnitSy