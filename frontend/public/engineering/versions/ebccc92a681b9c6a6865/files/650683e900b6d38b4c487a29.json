{"id":"650683e900b6d38b4c487a29","path":"trunk/AKRS.ZX2200/SupportFeature/Compensate/TemperatureCompensate/AirCooledController.cs","moduleId":"4bfb2af86705bab1cd13ce82","sha256":"9ff47651c5570a4afd5da340d804a77f0e5537ee28f14ea29d4829491be826b1","baselineSha256":"9ff47651c5570a4afd5da340d804a77f0e5537ee28f14ea29d4829491be826b1","current":true,"exists":true,"encoding":"utf-8","code":"using System;\r\nusing System.Collections.Generic;\r\nusing System.Linq;\r\nusing System.Text;\r\nusing System.Threading.Tasks;\r\n\r\nnamespace AKRS.ZX2200.SupportFeature.Compensate.TemperatureCompensate\r\n{\r\n    using System.Threading;\r\n    using System.Windows.Forms;\r\n\r\n    using AKRS.Galaxy2.Infrastructure;\r\n    using AKRS.Galaxy2.Infrastructure.CommonModel;\r\n    using AKRS.ZX2200.CalibSystem.Models;\r\n    using AKRS.ZX2200.Infrastructure.Models.Path;\r\n\r\n    using Newtonsoft.Json;\r\n\r\n    /// <summary>\r\n    /// 风冷控制器\r\n    /// </summary>\r\n    public class AirCooledController : Singleton<AirCooledController>\r\n    {\r\n        /// <summary>\r\n        /// 风冷存储参数\r\n        /// </summary>\r\n        public AirCooledController()\r\n        {\r\n            Singleton<AirCooledController>.FilePath = ZX2200PathConfig.AirCooledControllerPath;\r\n        }\r\n\r\n        /// <summary>\r\n        /// 比例\r\n        /// </summary>\r\n        public double Kp { get; set; }\r\n\r\n        /// <summary>\r\n        /// 积分\r\n        /// </summary>\r\n        public double Ki { get; set; }\r\n\r\n        /// <summary>\r\n        /// 微分\r\n        /// </summary>\r\n        public double Kd { get; set; }\r\n\r\n        /// <summary>\r\n        /// 反馈量\r\n        /// </summary>\r\n        private double prevError, integralError;\r\n\r\n        /// <summary>\r\n        /// 最小值\r\n        /// </summary>\r\n        public double OutputMin { get; set; }\r\n\r\n        /// <summary>\r\n        /// 最大值\r\n        /// </summary>\r\n        public double OutputMax { get; set; }\r\n\r\n        /// <summary>\r\n        /// 间隔时间\r\n        /// </summary>\r\n        public int IntervalTime { get; set; } = 100;\r\n\r\n        /// <summary>\r\n        /// 目标值\r\n        /// </summary>\r\n        public double TargetValue { get; set; }\r\n\r\n        /// <summary>\r\n        /// 暂停\r\n        /// </summary>\r\n        [JsonIgnore]\r\n        public bool IsWorking { get; set; }\r\n\r\n        /// <summary>\r\n        /// 计算输出值\r\n        /// </summary>\r\n        /// <param name=\"target\">目标值</param>\r\n        /// <param name=\"feedback\">返回值</param>\r\n        /// <param name=\"deltaTime\">时间</param>\r\n        /// <returns>结果</returns>\r\n        public double Calculate(double target, double feedback, double deltaTime)\r\n        {\r\n            double error = target - feedback;\r\n            double derivativeError = (error - this.prevError) / deltaTime;\r\n            double output = this.Kp * error + this.Ki * this.integralError + this.Kd * derivativeError;\r\n\r\n            // 输出限制\r\n            if (output > this.OutputMax)\r\n            {\r\n                output = this.OutputMax;\r\n            }\r\n            else if (output < this.OutputMin)\r\n            {\r\n                output = this.OutputMin;\r\n            }\r\n\r\n            // 更新反馈变量\r\n            this.prevError = error;\r\n            this.integralError += error * deltaTime;\r\n            return output;\r\n        }\r\n\r\n        /// <summary>\r\n        /// 重置PID控制器\r\n        /// </summary>\r\n        public void Reset()\r\n        {\r\n            this.prevError = 0;\r\n            this.integralError = 0;\r\n        }\r\n\r\n        /// <summary>\r\n        /// 开始\r\n        /// </summary>\r\n        public void Start()\r\n        {\r\n            // 获取轴温度传感器的值\r\n            double feedback = 0;\r\n\r\n            CommonUtil.SetCurrentThreadName(\"风冷控温线程\");\r\n\r\n            while (this.IsWorking)\r\n            {\r\n                // 计算PID计算后的参数\r\n                double output = this.Calculate(this.TargetValue, feedback, this.IntervalTime);\r\n\r\n                feedback += output;\r\n\r\n                // 输入给风冷模拟量\r\n                Thread.Sleep(this.IntervalTime);\r\n            }\r\n\r\n            this.prevError = 0;\r\n            this.integralError = 0;\r\n        }\r\n    }\r\n}\r\n","lineCount":142,"compileIncluded":true,"assemblies":["AKRS.ZX2200"],"declarations":[{"symbolId":"add80f0e4bbcefed9256d1c2","fileId":"650683e900b6d38b4c487a29","start":22,"end":140,"syntaxKind":"ClassDeclaration","label":"AKRS.ZX2200.SupportFeature.Compensate.TemperatureCompensate.AirCooledController","name":"AirCooledController","kind":"NamedType"},{"symbolId":"e374a314d4655a032c11ab29","fileId":"650683e900b6d38b4c487a29","start":27,"end":30,"syntaxKind":"ConstructorDeclaration","label":"AKRS.ZX2200.SupportFeature.Compensate.TemperatureCompensate.AirCooledController.#ctor","name":".ctor","kind":"Method"},{"symbolId":"b6997a09d664d355bc5a99a1","fileId":"650683e900b6d38b4c487a29","start":35,"end":35,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.SupportFeature.Compensate.TemperatureCompensate.AirCooledController.Kp","name":"Kp","kind":"Property"},{"symbolId":"b00641538a89ce12f846bce3","fileId":"650683e900b6d38b4c487a29","start":35,"end":35,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.ZX2200.SupportFeature.Compensate.TemperatureCompensate.AirCooledController.get_Kp","name":"get_Kp","kind":"Method"},{"symbolId":"97dbbc45ce3d1b038f058fac","fileId":"650683e900b6d38b4c487a29","start":35,"end":35,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.ZX2200.SupportFeature.Compensate.TemperatureCompensate.AirCooledController.set_Kp(System.Double)","name":"set_Kp","kind":"Method"},{"symbolId":"f6d789871cf13491b88eb9d9","fileId":"650683e900b6d38b4c487a29","start":40,"end":40,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.SupportFeature.Compensate.TemperatureCompensate.AirCooledController.Ki","name":"Ki","kind":"Property"},{"symbolId":"9e3b95f5123da15fab040928","fileId":"650683e900b6d38b4c487a29","start":40,"end":40,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.ZX2200.SupportFeature.Compensate.TemperatureCompensate.AirCooledController.get_Ki","name":"get_Ki","kind":"Method"},{"symbolId":"b8738f851e92ac811020601d","fileId":"650683e900b6d38b4c487a29","start":40,"end":40,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.ZX2200.SupportFeature.Compensate.TemperatureCompensate.AirCooledController.set_Ki(System.Double)","name":"set_Ki","kind":"Method"},{"symbolId":"2ce6537ca56b27aac9edbaa3","fileId":"650683e900b6d38b4c487a29","start":45,"end":45,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.SupportFeature.Compensate.TemperatureCompensate.AirCooledController.Kd","name":"Kd","kind":"Property"},{"symbolId":"30a06db61b2e9212c0dd9d30","fileId":"650683e900b6d38b4c487a29","start":45,"end":45,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.ZX2200.SupportFeature.Compensate.TemperatureCompensate.AirCooledController.get_Kd","name":"get_Kd","kind":"Method"},{"symbolId":"e530d76f2449ffb4444fe992","fileId":"650683e900b6d38b4c487a29","start":45,"end":45,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.ZX2200.SupportFeature.Compensate.TemperatureCompensate.AirCooledController.set_Kd(System.Double)","name":"set_Kd","kind":"Method"},{"symbolId":"e6b8cae604433853f0a35a62","fileId":"650683e900b6d38b4c487a29","start":50,"end":50,"syntaxKind":"VariableDeclarator","label":"AKRS.ZX2200.SupportFeature.Compensate.TemperatureCompensate.AirCooledController.prevError","name":"prevError","kind":"Field"},{"symbolId":"22fab3cf08487d5e92e36c55","fileId":"650683e900b6d38b4c487a29","start":50,"end":50,"syntaxKind":"VariableDeclarator","label":"AKRS.ZX2200.SupportFeature.Compensate.TemperatureCompensate.AirCooledController.integralError","name":"integralError","kind":"Field"},{"symbolId":"d38454a0cb29773496aa342c","fileId":"650683e900b6d38b4c487a29","start":55,"end":55,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.SupportFeature.Compensate.TemperatureCompensate.AirCooledController.OutputMin","name":"OutputMin","kind":"Property"},{"symbolId":"2fa1472e4e2e8e54064a115c","fileId":"650683e900b6d38b4c487a29","start":55,"end":55,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.ZX2200.SupportFeature.Compensate.TemperatureCompensate.AirCooledController.get_OutputMin","name":"get_OutputMin","kind":"Method"},{"symbolId":"6937439822171072af094015","fileId":"650683e900b6d38b4c487a29","start":55,"end":55,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.ZX2200.SupportFeature.Compensate.TemperatureCompensate.AirCooledController.set_OutputMin(System.Double)","name":"set_OutputMin","kind":"Method"},{"symbolId":"7a814834dec1fee22141b3a1","fileId":"650683e900b6d38b4c487a29","start":60,"end":60,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.SupportFeature.Compensate.TemperatureCompensate.AirCooledController.OutputMax","name":"OutputMax","kind":"Property"},{"symbolId":"bdd319cc9d068076c9ff8ecc","fileId":"650683e900b6d38b4c487a29","start":60,"end":60,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.ZX2200.SupportFeature.Compensate.TemperatureCompensate.AirCooledController.get_OutputMax","name":"get_OutputMax","kind":"Method"},{"symbolId":"03fe2c342868f23e8a7909b8","fileId":"650683e900b6d38b4c487a29","start":60,"end":60,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.ZX2200.SupportFeature.Compensate.TemperatureCompensate.AirCooledController.set_OutputMax(System.Double)","name":"set_OutputMax","kind":"Method"},{"symbolId":"78b6a9224cde2c2839ad782d","fileId":"650683e900b6d38b4c487a29","start":65,"end":65,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.SupportFeature.Compensate.TemperatureCompensate.AirCooledController.IntervalTime","name":"IntervalTime","kind":"Property"},{"symbolId":"75b756be3dff341f2d0ab244","fileId":"650683e900b6d38b4c487a29","start":65,"end":65,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.ZX2200.SupportFeature.Compensate.TemperatureCompensate.AirCooledController.get_IntervalTime","name":"get_IntervalTime","kind":"Method"},{"symbolId":"2a48353dbc6bf1c612e4e1bd","fileId":"650683e900b6d38b4c487a29","start":65,"end":65,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.ZX2200.SupportFeature.Compensate.TemperatureCompensate.AirCooledController.set_IntervalTime(System.Int32)","name":"set_IntervalTime","kind":"Method"},{"symbolId":"6c6a210137203b16cb359d71","fileId":"650683e900b6d38b4c487a29","start":70,"end":70,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.SupportFeature.Compensate.TemperatureCompensate.AirCooledController.TargetValue","name":"TargetValue","kind":"Property"},{"symbolId":"c8c702e7c05246d454110e41","fileId":"650683e900b6d38b4c487a29","start":70,"end":70,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.ZX2200.SupportFeature.Compensate.TemperatureCompensate.AirCooledController.get_TargetValue","name":"get_TargetValue","kind":"Method"},{"symbolId":"6c1a4f9df475d49b158fb84e","fileId":"650683e900b6d38b4c487a29","start":70,"end":70,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.ZX2200.SupportFeature.Compensate.TemperatureCompensate.AirCooledController.set_TargetValue(System.Double)","name":"set_TargetValue","kind":"Method"},{"symbolId":"93821499fdf099a1e55cc708","fileId":"650683e900b6d38b4c487a29","start":75,"end":76,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.SupportFeature.Compensate.TemperatureCompensate.AirCooledController.IsWorking","name":"IsWorking","kind":"Property"},{"symbolId":"defd90e018360edbb65bc64e","fileId":"650683e900b6d38b4c487a29","start":76,"end":76,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.ZX2200.SupportFeature.Compensate.TemperatureCompensate.AirCooledController.get_IsWorking","name":"get_IsWorking","kind":"Method"},{"symbolId":"33ddc1ac58ee66480e51a2b4","fileId":"650683e900b6d38b4c487a29","start":76,"end":76,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.ZX2200.SupportFeature.Compensate.TemperatureCompensate.AirCooledController.set_IsWorking(System.Boolean)","name":"set_IsWorking","kind":"Method"},{"symbolId":"5f3e93107a3120c5c1efe349","fileId":"650683e900b6d38b4c487a29","start":85,"end":105,"syntaxKind":"MethodDeclaration","label":"AKRS.ZX2200.SupportFeature.Compensate.TemperatureCompensate.AirCooledController.Calculate(System.Double,System.Double,System.Double)","name":"Calculate","kind":"Method"},{"symbolId":"9e6c6603a5d566eb1f99ed2c","fileId":"650683e900b6d38b4c487a29","start":110,"end":114,"syntaxKind":"MethodDeclaration","label":"AKRS.ZX2200.SupportFeature.Compensate.TemperatureCompensate.AirCooledController.Reset","name":"Reset","kind":"Method"},{"symbolId":"74c0f733355dbedd5c208e7b","fileId":"650683e900b6d38b4c487a29","start":119,"end":139,"syntaxKind":"MethodDeclaration","label":"AKRS.ZX2200.SupportFeature.Compensate.TemperatureCompensate.AirCooledController.Start","name":"Start","kind":"Method"}]}