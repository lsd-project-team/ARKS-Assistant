{"id":"5efb3d8392efa279cb0cfd1b","path":"trunk/AKRS.ZX2200/Infrastructure/Models/CommonModels/ActionNode.cs","moduleId":"de5078170b4c83a0204ab5a5","sha256":"cdad52ca31f21d4b3454e597c90e1615e889ea22abbb270c8291915d1169fa5f","baselineSha256":"cdad52ca31f21d4b3454e597c90e1615e889ea22abbb270c8291915d1169fa5f","current":true,"exists":true,"encoding":"utf-8","code":"namespace AKRS.ZX2200.Infrastructure.Models.CommonModels\r\n{\r\n    using System;\r\n\r\n    using AKRS.Galaxy2.Infrastructure.Enums;\r\n    using AKRS.ZX2200.Models;\r\n\r\n    using Newtonsoft.Json;\r\n\r\n    /// <summary>\r\n    /// 动作节点\r\n    /// </summary>\r\n    [Serializable]\r\n    public abstract class ActionNode\r\n    {\r\n        /// <summary>\r\n        /// 无参构造函数\r\n        /// </summary>\r\n        protected ActionNode()\r\n        {\r\n        }\r\n\r\n        /// <summary>\r\n        /// 动作节点名字\r\n        /// </summary>\r\n        public virtual string Name { get; set; }\r\n\r\n        /// <summary>\r\n        /// 动作层级\r\n        /// </summary>\r\n        public ActionLevelEnum ActionLevel { get; set; }\r\n\r\n        /// <summary>\r\n        /// 排序使用\r\n        /// </summary>\r\n        public ActionTypeEnum ActionSortType { get; set; }\r\n\r\n        /// <summary>\r\n        /// 动作所在的系统\r\n        /// </summary>\r\n        public ActionNodeSystemEnum System { get; set; }\r\n\r\n        /// <summary>\r\n        /// 动作开始事件\r\n        /// </summary>\r\n        [JsonIgnore]\r\n        public Action WorkStart { get; set; }\r\n\r\n        /// <summary>\r\n        /// 运行过程中的信息\r\n        /// </summary>\r\n        public ActionNodeInformation Info { get; set; }\r\n\r\n        /// <summary>\r\n        /// 是否去完成这个动作\r\n        /// 这里面主要包涵去完成这个动作的条件\r\n        /// </summary>\r\n        /// <returns>结果</returns>\r\n        public virtual bool IsDoWork()\r\n        {\r\n            return true;\r\n        }\r\n\r\n        /// <summary>\r\n        /// 是否去完成这个动作\r\n        /// 这里面主要包涵对空指针已经逻辑完全有问题的判断\r\n        /// </summary>\r\n        /// <returns>结果</returns>\r\n        public virtual bool IsAlarm()\r\n        {\r\n            return true;\r\n        }\r\n\r\n        /// <summary>\r\n        /// 动作停止事件\r\n        /// </summary>\r\n        [JsonIgnore]\r\n        public Action WorkStop { get; set; }\r\n\r\n        /// <summary>\r\n        /// 动作节点状态\r\n        /// </summary>\r\n        [JsonIgnore]\r\n        public RunStateEnum State { get; set; } = RunStateEnum.Idle;\r\n\r\n        /// <summary>\r\n        /// 是否关闭气缸\r\n        /// </summary>\r\n        public bool IsCloseCylinder { get; set; } = false;\r\n\r\n        /// <summary>\r\n        /// 动作内容\r\n        /// </summary>\r\n        public ActionNodeStyle Style { get; set; } = ActionNodeStyle.Other;\r\n\r\n        /// <summary>\r\n        /// 是否为拍照动作\r\n        /// </summary>\r\n        public bool IsVisionAction { get; set; } = false;\r\n\r\n        /// <summary>\r\n        /// 执行节点动作\r\n        /// </summary>\r\n        /// <returns>执行结果</returns>\r\n        public virtual ExcuteResult DoWork()\r\n        {\r\n            this.WorkStart?.Invoke();\r\n            this.State = RunStateEnum.Running;\r\n            try\r\n            {\r\n                return ExcuteResult.Success;\r\n            }\r\n            finally\r\n            {\r\n                this.State = RunStateEnum.Stop;\r\n                this.WorkStop?.Invoke();\r\n            }\r\n        }\r\n    }\r\n\r\n    /// <summary>\r\n    /// 动作的层级\r\n    /// </summary>\r\n    public enum ActionLevelEnum\r\n    {\r\n        /// <summary>\r\n        /// 载具\r\n        /// </summary>\r\n        Carrier,\r\n\r\n        /// <summary>\r\n        /// 基板\r\n        /// </summary>\r\n        Substrate,\r\n\r\n        /// <summary>\r\n        /// 模组\r\n        /// </summary>\r\n        Module,\r\n\r\n        /// <summary>\r\n        /// 焊点\r\n        /// </summary>\r\n        BondPosition,\r\n\r\n        /// <summary>\r\n        /// 其他\r\n        /// </summary>\r\n        Other\r\n    }\r\n\r\n    /// <summary>\r\n    /// 执行这个动作的系统\r\n    /// </summary>\r\n    public enum ActionNodeSystemEnum\r\n    {\r\n        /// <summary>\r\n        /// 系统1\r\n        /// </summary>\r\n        System1,\r\n\r\n        /// <summary>\r\n        /// 系统2\r\n        /// </summary>\r\n        System2,\r\n    }\r\n\r\n    /// <summary>\r\n    /// 动作类型\r\n    /// </summary>\r\n    public enum ActionNodeStyle\r\n    {\r\n        /// <summary>\r\n        /// 拍照\r\n        /// </summary>\r\n        Vision,\r\n\r\n        /// <summary>\r\n        /// 测高\r\n        /// </summary>\r\n        MeasureHeight,\r\n\r\n        /// <summary>\r\n        /// 其他\r\n        /// </summary>\r\n        Other\r\n    }\r\n}\r\n","lineCount":189,"compileIncluded":true,"assemblies":["AKRS.ZX2200"],"declarations":[{"symbolId":"88e90ad3f26a4eb8cd7885f1","fileId":"5efb3d8392efa279cb0cfd1b","start":13,"end":119,"syntaxKind":"ClassDeclaration","label":"AKRS.ZX2200.Infrastructure.Models.CommonModels.ActionNode","name":"ActionNode","kind":"NamedType"},{"symbolId":"7e74a71fb807b4d976998a31","fileId":"5efb3d8392efa279cb0cfd1b","start":19,"end":21,"syntaxKind":"ConstructorDeclaration","label":"AKRS.ZX2200.Infrastructure.Models.CommonModels.ActionNode.#ctor","name":".ctor","kind":"Method"},{"symbolId":"70b10ffa4e9bb8ddf3d05f06","fileId":"5efb3d8392efa279cb0cfd1b","start":26,"end":26,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.Infrastructure.Models.CommonModels.ActionNode.Name","name":"Name","kind":"Property"},{"symbolId":"216363445818a9b0b89da030","fileId":"5efb3d8392efa279cb0cfd1b","start":26,"end":26,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.ZX2200.Infrastructure.Models.CommonModels.ActionNode.get_Name","name":"get_Name","kind":"Method"},{"symbolId":"cafd5a55dceacb1d7d7ae02c","fileId":"5efb3d8392efa279cb0cfd1b","start":26,"end":26,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.ZX2200.Infrastructure.Models.CommonModels.ActionNode.set_Name(Syst