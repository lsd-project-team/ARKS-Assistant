mary>\r\n        /// 矩形区域 \r\n        /// </summary>\r\n        [JsonIgnore]\r\n        public RectangleF Rect { get; set; }\r\n\r\n        /// <summary>\r\n        ///  Get brush with state\r\n        /// </summary>\r\n        /// <returns>Brush</returns>\r\n        internal (string Description, Brush brush) GetColorBrushDescription()\r\n        {\r\n            AcupointAttribute cb = (AcupointAttribute)EnumHelper.GetCustomAttributes<AcupointAttribute>(this.SlotState);\r\n            Brush brush = new SolidBrush(Color.FromName(cb.StateColor));\r\n\r\n            return (cb.StateDescription, brush);\r\n        }\r\n    }\r\n}\r\n","lineCount":79,"compileIncluded":true,"assemblies":["AKRS.ZX2200"],"declarations":[{"symbolId":"d65fd8fb0fe567127969c19f","fileId":"60d0887a22455f93929086a9","start":20,"end":77,"syntaxKind":"ClassDeclaration","label":"AKRS.ZX2200.WaferSubSystem.Models.Entities.AcupointEntity","name":"AcupointEntity","kind":"NamedType"},{"symbolId":"535c75ecd2c94d2a7b84fd18","fileId":"60d0887a22455f93929086a9","start":26,"end":26,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.WaferSubSystem.Models.Entities.AcupointEntity.Index","name":"Index","kind":"Property"},{"symbolId":"ab085d0bfe13ea2cca0a45b1","fileId":"60d0887a22455f93929086a9","start":26,"end":26,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.ZX2200.WaferSubSystem.Models.Entities.AcupointEntity.get_Index","name":"get_Index","kind":"Method"},{"symbolId":"c822ca6b14676738d6de8dfb","fileId":"60d0887a22455f93929086a9","start":26,"end":26,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.ZX2200.WaferSubSystem.Models.Entities.AcupointEntity.set_Index(System.Int32)","name":"set_Index","kind":"Method"},{"symbolId":"0df8c5e8c788c8845671338b","fileId":"60d0887a22455f93929086a9","start":31,"end":32,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.WaferSubSystem.Models.Entities.AcupointEntity.SlotNum","name":"SlotNum","kind":"Property"},{"symbolId":"86459d5caf1cfcb7d67a80c5","fileId":"60