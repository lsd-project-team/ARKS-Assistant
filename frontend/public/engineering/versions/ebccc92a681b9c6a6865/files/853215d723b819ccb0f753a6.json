{"id":"853215d723b819ccb0f753a6","path":"trunk/AKRS.ZX2200/BondSystem/Models/DeviceParams/S2DispenseDevicePara.cs","moduleId":"a0a224c4ebd2e1afce11fca5","sha256":"3792a21f1f8778468545daea2bd5432b089621dd5851763648b7ccb10cb80d3f","baselineSha256":"3792a21f1f8778468545daea2bd5432b089621dd5851763648b7ccb10cb80d3f","current":true,"exists":true,"encoding":"utf-8","code":"using AKRS.Galaxy2.Infrastructure.CommonModel;\r\nusing AKRS.ZX2200.BondSystem.Models.Parameter;\r\nusing AKRS.ZX2200.Infrastructure.AOP.Module;\r\nusing AKRS.ZX2200.SupportFeature.Parameters.Model;\r\nusing PropertyChanged;\r\nusing System;\r\nusing System.Collections.Generic;\r\nusing System.Linq;\r\nusing System.Text;\r\nusing System.Threading.Tasks;\r\n\r\nnamespace AKRS.ZX2200.BondSystem.Models.DeviceParams\r\n{\r\n    /// <summary>\r\n    /// 系统2点胶参数\r\n    /// </summary>\r\n    [Serializable]\r\n    [AddINotifyPropertyChangedInterface]\r\n    public class S2DispenseDevicePara : PropertyChangeAop\r\n    {\r\n        /// <summary>\r\n        /// 换胶水位置\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"换胶水的位置\", (string)null)]\r\n        public AKRSPoint3D ReplaceGluePosition { get; set; } = new AKRSPoint3D();\r\n\r\n        /// <summary>\r\n        /// 挤胶水位置\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"挤胶的位置\", (string)null)]\r\n        public AKRSPoint3D ThrustPosition { get; set; } = new AKRSPoint3D();\r\n\r\n        /// <summary>\r\n        /// 挤胶水位置\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"擦胶的位置\", (string)null)]\r\n        public AKRSPoint3D ErasePosition { get; set; } = new AKRSPoint3D();\r\n\r\n        /// <summary>\r\n        /// 标定相机中心和点胶头中心的差值的相机位\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"相机寻找点胶点的位置\", (string)null)]\r\n        public AKRSPoint3D VisionPosForCalibration { get; set; } = new AKRSPoint3D();\r\n\r\n        /// <summary>\r\n        /// 标定相机中心和点胶头中心的差值的挤胶和测高位\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"示教点胶头时的测高位置\", (string)null)]\r\n        public AKRSPoint3D DispenserMeasureHeightPos { get; set; } = new AKRSPoint3D();\r\n\r\n        /// <summary>\r\n        /// 在示教点胶针的时候，点胶针在预点胶板上的出胶出胶时间\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"在示教点胶针时的挤胶时间\", (string)null)]\r\n        public double AssistanceOpenDripTime { get; set; } = 500;\r\n\r\n        /// <summary>\r\n        /// 预点胶板参数\r\n        /// </summary>\r\n        public S2PreDispensePlatePara S2PreDispensePlatePara { get; set; } = new S2PreDispensePlatePara();\r\n\r\n        /// <summary>\r\n        /// 测高针和焊头之间的距离\r\n        /// </summary>\r\n        public AKRSPoint3D DistanceByMhToBh { get; set; } = new AKRSPoint3D();\r\n\r\n        /// <summary>\r\n        /// 激光测高到位等待时间\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"激光测高到位等待时间\", null, 0, 5000, \"ms\")]\r\n        public int LaserMhDelayTime { get; set; } = 50;\r\n\r\n        /// <summary>\r\n        /// 测高报警距离\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"测高距离误差报警阈值\", null, 0, 5, \"mm\")]\r\n        public double MeasureHeightAlarmDistance { get; set; } = 1;\r\n\r\n        /// <summary>\r\n        /// 蘸胶位置\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"蘸胶位置\", (string)null)]\r\n        public AKRSPoint3D DippingPosition { get; set; }\r\n    }\r\n}\r\n","lineCount":86,"compileIncluded":true,"assemblies":["AKRS.ZX2200"],"declarations":[{"symbolId":"3c56a3b195ec066b486277cf","fileId":"853215d723b819ccb0f753a6","start":17,"end":84,"syntaxKind":"ClassDeclaration","label":"AKRS.ZX2200.BondSystem.Models.DeviceParams.S2DispenseDevicePara","name":"S2DispenseDevicePara","kind":"NamedType"},{"symbolId":"8ebabe9d5e7b8c59cdb2e9bc","fileId":"853215d723b819ccb0f753a6","start":24,"end":25,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.BondSystem.Models.DeviceParams.S2DispenseDevicePara.ReplaceGluePosition","name":"ReplaceGluePosition","kind":"Property"},{"symbolId":"df2e5caca79e306afa67f58b","fileId":"85