{"id":"4f7b14495c032991d8733505","path":"trunk/AKRS.ZX2200/SupportFeature/Consumables/BaseConsumable.cs","moduleId":"4bfb2af86705bab1cd13ce82","sha256":"4f151951db4504859f2d2af0c0fd87f13b2794774710a80a95e9e01bbc240500","baselineSha256":"4f151951db4504859f2d2af0c0fd87f13b2794774710a80a95e9e01bbc240500","current":true,"exists":true,"encoding":"utf-8","code":"namespace AKRS.ZX2200.SupportFeature.Consumables\r\n{\r\n    using System;\r\n\r\n    /// <summary>\r\n    /// 基础耗材类\r\n    /// </summary>\r\n    [Serializable]\r\n    public abstract class BaseConsumable\r\n    {\r\n        /// <summary>\r\n        /// 耗材名称\r\n        /// </summary>\r\n        public string Name { get; set; }\r\n\r\n        /// <summary>\r\n        /// 是否启用\r\n        /// </summary>\r\n        public bool Enable { get; set; } = false;\r\n\r\n        /// <summary>\r\n        /// 是否已经提醒过了\r\n        /// </summary>\r\n        public bool IsReminded { get; set; } = false;\r\n\r\n        /// <summary>\r\n        /// 耗材是否使用完成或者耗材是否过期\r\n        /// </summary>\r\n        /// <returns>结果</returns>\r\n        public abstract bool IsExpired();\r\n\r\n        /// <summary>\r\n        /// 是否应该提醒\r\n        /// </summary>\r\n        /// <returns>结果</returns>\r\n        public abstract bool IsRemind();\r\n\r\n        /// <summary>\r\n        /// 清空当前记录\r\n        /// </summary>\r\n        public abstract void Clear();\r\n\r\n        /// <summary>\r\n        /// 最近一次报警的时间\r\n        /// 10分钟之内不会再报警\r\n        /// </summary>\r\n        public DateTime LastAlarmTime { get; set; } = DateTime.Now;\r\n\r\n        /// <summary>\r\n        /// 距离上次报警是否有10分钟，如果超过10分钟就再次报警\r\n        /// </summary>\r\n        /// <returns>结果</returns>\r\n        public bool IsEnableTimeToAlarm()\r\n        {\r\n            if (this.IsAlarmed)\r\n            {\r\n                return (DateTime.Now - this.LastAlarmTime).TotalMinutes > 10;\r\n            }\r\n\r\n            this.IsAlarmed = true;\r\n            return true;\r\n        }\r\n\r\n        /// <summary>\r\n        /// 是否已经报过警\r\n        /// </summary>\r\n        public bool IsAlarmed { get; set; } = false;\r\n    }\r\n}\r\n","lineCount":70,"compileIncluded":true,"assemblies":["AKRS.ZX2200"],"declarations":[{"symbolId":"de0d7a907dfe583249136918","fileId":"4f7b14495c032991d8733505","start":8,"end":68,"syntaxKind":"ClassDeclaration","label":"AKRS.ZX2200.SupportFeature.Consumables.BaseConsumable","name":"BaseConsumable","kind":"NamedType"},{"symbolId":"d1acf9f7ae4c8ee709018ab6","fileId":"4f7b14495c032991d8733505","start":14,"end":14,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.SupportFeature.Consumables.BaseConsumable.Name","name":"Name","kind":"Property"},{"symbolId":"10f47bcddeb3baee16fdb781","fileId":"4f7b14495c032991d8733505","start":14,"end":14,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.ZX2200.SupportFeature.Consumables.BaseConsumable.get_Name","name":"get_Name","kind":"Method"},{"symbolId":"bce249cad0c5b83844ac010d","fileId":"4f7b14495c032991d8733505","start":14,"end":14,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.ZX2200.SupportFeature.Consumables.BaseConsumable.set_Name(System.String)","name":"set_Name","kind":"Method"},{"symbolId":"ae8042e3a4ea629e4d3fbeda","fileId":"4f7b14495c032991d8733505","start":19,"end":19,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.SupportFeature.Consumables.BaseConsumable.Enable","name":"Enable","kind":"Property"},{"symbolId":"7e9e74cb654b8c55e5c2b746","fileId":"4f7b14495c032991d8733505","start":19,"end":19,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.ZX2200.SupportFeature.Consumables.BaseConsumable.get_Enable","name":"get_Enable","kind":"Method"},{"symbolId":"bd3d8025bb0a608cf97371c9","fileId":"4f7b14495c032991d8733505","start":19,"end":19,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.ZX2200.SupportFeature.Consumables.BaseConsumable.set_Enable(System.Boolean)","name":"set_Enable","kind":"Method"},{"symbolId":"39676266de49d64a98d9e6df","fileId":"4f7b14495