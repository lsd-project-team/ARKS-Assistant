\n\r\n        /// <summary>\r\n        /// 创建时间\r\n        /// </summary>\r\n        public DateTime CreateTime { get; set; } = System.DateTime.Now;\r\n\r\n        /// <summary>\r\n        /// 所属RecipeID 列表\r\n        /// </summary>\r\n        public List<Guid> RecipeIDList { get; set; } = new List<Guid>();\r\n\r\n        /// <summary>\r\n        /// 添加到所属Recipe里\r\n        /// </summary>\r\n        public void AddBelongRecipeIds()\r\n        {\r\n            Guid recipeID = MachineConfigContext.GetInstance().RecipeID;\r\n            if (this.RecipeIDList.Contains(recipeID) == false)\r\n            {\r\n                this.RecipeIDList.Add(recipeID);\r\n            }\r\n        }\r\n\r\n        /// <summary>\r\n        /// 从所属Recipe里删除\r\n        /// </summary>\r\n        public void RemoveFromBelongRecipeIds()\r\n        {\r\n            Guid recipeID = MachineConfigContext.GetInstance().RecipeID;\r\n            if (this.RecipeIDList.Contains(recipeID))\r\n            {\r\n                this.RecipeIDList.Remove(recipeID);\r\n            }\r\n        }\r\n    }\r\n\r\n    /// <summary>\r\n    /// 编辑状态枚举\r\n    /// </summary>\r\n    public enum EditStateEnum\r\n    {\r\n        /// <summary>\r\n        /// 新建\r\n        /// </summary>\r\n        NewCreate = 0,\r\n\r\n        /// <summary>\r\n        /// 未完成\r\n        /// </summary>\r\n        NotYetFinished = 1,\r\n\r\n        /// <summary>\r\n        /// 外部修改\r\n        /// </summary>\r\n        ChangedOutside = 2,\r\n\r\n        /// <summary>\r\n        /// 完成\r\n        /// </summary>\r\n        Completely = 3\r\n    }\r\n}\r\n","lineCount":123,"compileIncluded":true,"assemblies":["AKRS.ZX2200"],"declarations":[{"symbolId":"93fbc41a02da109db9baf391","fileId":"4aa3ae2e78f9ef7806e62962","start":33,"end":95,"syntaxKind":"ClassDeclaration","label":"AKRS.ZX2200.Infrastructure.Models.BaseModels.BaseDsSetting","name":"BaseDsSetting","kind":"NamedType"},{"symbolId":"da4825ad4b90dee96db90edb","fileId":"4aa3ae2e78f9ef78