ic Action NextAction { get; set; }\r\n\r\n        /// <summary>\r\n        /// Done 按钮事件\r\n        /// </summary>\r\n        public Action DoneAction { get; set; }\r\n\r\n        /// <summary>\r\n        /// 构造函数\r\n        /// </summary>\r\n        /// <param name=\"index\">索引</param>\r\n        /// <param name=\"descritpion\">描述</param>\r\n        /// <param name=\"isShowTitle\">是否显示</param>\r\n        /// <param name=\"isShowBack\">是否显示Back按钮</param>\r\n        /// <param name=\"isShowNext\">是否显示Next按钮</param>\r\n        /// <param name=\"isShowDone\">是否显示Done按钮</param>\r\n        /// <param name=\"backAction\">next 按钮点击事件</param>\r\n        /// <param name=\"nextAction\">next 按钮点击事件</param>\r\n        /// <param name=\"doneAction\">done 按钮点击事件</param>\r\n        public AssistantConfig(int index, string descritpion, bool isShowTitle, bool isShowBack, bool isShowNext, bool isShowDone, Action backAction, Action nextAction, Action doneAction)\r\n        {\r\n            this.Index = index;\r\n            this.Descritpion = descritpion;\r\n            this.IsShowTitle = isShowTitle;\r\n            this.IsShowBack = isShowBack;\r\n            this.IsShowNext = isShowNext;\r\n            this.IsShowDone = isShowDone;\r\n            this.BackAction = backAction;\r\n            this.NextAction = nextAction;\r\n            this.DoneAction = doneAction;\r\n        }\r\n    }\r\n}\r\n","lineCount":101,"compileIncluded":true,"assemblies":["AKRS.Galaxy2.TeachTest"],"declarations":[{"symbolId":"b77c51b29105ee5d856f9639","fileId":"d6729328ea3d15af0aedcd1a","start":28,"end":99,"syntaxKind":"ClassDeclaration","label":"AKRS.ZX2200.Models.CommonModels.AssistantConfig","name":"AssistantConfig","kind":"NamedType"},{"symbolId":"2db4824cc83db26903cbf826","fileId":"d6729328ea3d15af0aedcd1a","start":33,"end":33,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.Models.CommonModels.AssistantConfig.Index","name":"Index","kind":"Property"},{"symbolId":"ac45138ca7d0563622cff8a0","fileI