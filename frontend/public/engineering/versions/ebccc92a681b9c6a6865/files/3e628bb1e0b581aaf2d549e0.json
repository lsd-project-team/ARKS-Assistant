{"id":"3e628bb1e0b581aaf2d549e0","path":"trunk/AKRS.ZX2200/TransportUnitSystem/Module/Information/BondPositionInfo.cs","moduleId":"b629c57892dad9b04315dc8b","sha256":"6bd63b789cffdd7231e03a0ebaaa70e618dff79518b4c8e199ebae578d297828","baselineSha256":"6bd63b789cffdd7231e03a0ebaaa70e618dff79518b4c8e199ebae578d297828","current":true,"exists":true,"encoding":"utf-8","code":"using AKRS.Galaxy2.Infrastructure.CommonModel;\r\nusing AKRS.ZX2200.TransportUnitSystem.Model;\r\nusing System;\r\nusing System.Collections.Generic;\r\nusing System.Linq;\r\nusing System.Text;\r\nusing System.Threading.Tasks;\r\n\r\nnamespace AKRS.ZX2200.TransportUnitSystem.Module.Information\r\n{\r\n    using AKRS.Galaxy2.PR.Models.MatchResults;\r\n    using DevExpress.Office.Utils;\r\n    using LanguageExt.TypeClasses;\r\n\r\n    /// <summary>\r\n    ///  焊点信息\r\n    /// </summary>\r\n    public class BondPositionInfo : BaseInformation\r\n    {\r\n        /// <summary>\r\n        ///  上视定位结果第一次\r\n        /// </summary>\r\n        public MatchResult UpLookMatchResult1 { get; set; } = new MatchResult();\r\n\r\n        /// <summary>\r\n        ///  上视定位结果第二次\r\n        /// </summary>\r\n        public MatchResult UpLookMatchResult2 { get; set; } = new MatchResult();\r\n\r\n        /// <summary>\r\n        /// 焊点定位之后的真实位置\r\n        /// </summary>\r\n        public AKRSPoint3D RealBondPoint3D { get; set; } = new AKRSPoint3D();\r\n\r\n        /// <summary>\r\n        /// 实际贴片位\r\n        /// </summary>\r\n        public AKRSPoint3D RealBondPos { get; set; } = new AKRSPoint3D();\r\n\r\n        /// <summary>\r\n        /// 温漂Mark补偿\r\n        /// </summary>\r\n        public AKRSPoint3D TpMarkCompensate { get; set; } = new AKRSPoint3D();\r\n\r\n        /// <summary>\r\n        /// 焊后补偿\r\n        /// </summary>\r\n        public AKRSPoint3D DefectCompensate { get; set; } = new AKRSPoint3D();\r\n\r\n        /// <summary>\r\n        /// 中转台拍照位置\r\n        /// </summary>\r\n        public AKRSPoint3D IPTVisionPos { get; set; }\r\n\r\n        /// <summary>\r\n        /// 中转台P2拍照位置\r\n        /// </summary>\r\n        public AKRSPoint3D IPTP2VisionPos { get; set; }\r\n\r\n        /// <summary>\r\n        /// 中转台取片位置\r\n        /// </summary>\r\n        public AKRSPoint3D IPTPickPos { get; set; }\r\n\r\n        /// <summary>\r\n        /// 芯片在晶圆/华府盒上的角度\r\n        /// </summary>\r\n        public double ComponentAngleOnWafer { get; set; } = 0;\r\n\r\n        /// <summary>\r\n        /// 最终取片力值\r\n        /// </summary>\r\n        public double ActualPickForce { get; set; } = 0;\r\n\r\n        /// <summary>\r\n        /// 最终贴片力值\r\n        /// </summary>\r\n        public double ActualBondForce { get; set; } = 0;\r\n\r\n        /// <summary>\r\n        /// 芯片二维码\r\n        /// </summary>\r\n        public string ComponentCode { get; set; } = string.Empty;\r\n\r\n        #region 视觉矫正的过程量\r\n\r\n        /// <summary>\r\n        /// 在贴片时，焊头还需要旋转的角度\r\n        /// </summary>\r\n        public double ComponentAngleOffSet { get; set; } = 0;\r\n\r\n        /// <summary>\r\n        /// 吸嘴上的芯片此时距离旋转中心的偏移值\r\n        /// </summary>\r\n        public AKRSPoint3D ComponentOffSet { get; set; } = new AKRSPoint3D();\r\n\r\n        /// <summary>\r\n        /// 中转台的补偿\r\n        /// </summary>\r\n        public AKRSPoint3D SubstrateCameraCompensate { get; set; } = new AKRSPoint3D();\r\n\r\n        #endregion\r\n\r\n        /// <summary>\r\n        /// 系统1剩余工作步骤\r\n        /// </summary>\r\n        public Dictionary<string, bool> S1RemainingSteps { get; set; } = new Dictionary<string, bool>();\r\n\r\n        /// <summary>\r\n        /// 系统2剩余工作步骤\r\n        /// </summary>\r\n        public Dictionary<string, bool> S2RemainingSteps { get; set; } = new Dictionary<string, bool>();\r\n\r\n        /// <summary>\r\n        /// 系统1是否完成\r\n        /// </summary>\r\n        /// <returns>结果</returns>\r\n        public bool IsFinishedInSystem1()\r\n        {\r\n            if (this.S1RemainingSteps.Count == 0)\r\n            {\r\n                return true;\r\n            }\r\n\r\n            if (this.S2RemainingSteps.Count == 0)\r\n            {\r\n                return false;\r\n            }\r\n\r\n            foreach (var item in this.S1RemainingSteps)\r\n            {\r\n                if (!item.Value)\r\n                {\r\n                    return false;\r\n                }\r\n            }\r\n\r\n            return true;\r\n        }\r\n\r\n        /// <summary>\r\n        /// 系统2是否完成\r\n        /// </summary>\r\n        /// <returns>结果</returns>\r\n        public bool IsFinishedInSystem2()\r\n        {\r\n            if (this.S2RemainingSteps.Count == 0)\r\n            {\r\n                return true;\r\n            }\r\n\r\n            foreach (var item in this.S2RemainingSteps)\r\n            {\r\n                if (!item.Value)\r\n                {\r\n                    return false;\r\n                }\r\n            }\r\n\r\n            return true;\r\n        }\r\n\r\n        /// <summary>\r\n        /// 设置系统1完成\r\n        /// </summary>\r\n        public void SetFinishedInSystem1()\r\n        {\r\n            List<string> steps = new List<string>();\r\n            foreach (var item in this.S1RemainingSteps)\r\n            {\r\n                steps.Add(item.Key);\r\n            }\r\n\r\n            foreach (var item in steps)\r\n            {\r\n                this.S1RemainingSteps[item] = true;\r\n            }\r\n        }\r\n\r\n        /// <summary>\r\n        /// 设置系统1未完成\r\n        /// </summary>\r\n        public void SetUnFinishedInSystem1()\r\n        {\r\n            List<string> steps = new List<string>();\r\n            foreach (var item in this.S1RemainingSteps)\r\n            {\r\n                steps.Add(item.Key);\r\n            }\r\n\r\n            foreach (var item in steps)\r\n            {\r\n                this.S1RemainingSteps[item] = false;\r\n            }\r\n        }\r\n\r\n        /// <summary>\r\n        /// 设置系统2完成\r\n        /// </summary>\r\n        public void SetFinishedInSystem2()\r\n        {\r\n            List<string> steps = new List<string>();\r\n            foreach (var item in this.S2RemainingSteps)\r\n            {\r\n                steps.Add(item.Key);\r\n            }\r\n\r\n            foreach (var item in steps)\r\n            {\r\n                this.S2RemainingSteps[item] = true;\r\n            }\r\n        }\r\n\r\n        /// <summary>\r\n        /// 设置系统2未完成\r\n        /// </summary>\r\n        public void SetUnFinishedInSystem2()\r\n        {\r\n            List<string> steps = new List<string>();\r\n            foreach (var item in this.S2RemainingSteps)\r\n            {\r\n                steps.Add(item.Key);\r\n            }\r\n\r\n            foreach (var item in steps)\r\n            {\r\n                this.S2RemainingSteps[item] = false;\r\n            }\r\n        }\r\n    }\r\n}\r\n","lineCount":232,"compileIncluded":true,"assemblies":["AKRS.ZX2200"],"declarations":[{"symbolId":"c18b829388b0fff3ad7c908d","fileId":"3e628bb1e0b581aaf2d549e0","start":18,"end":230,"syntaxKind":"ClassDeclaration","label":"AKRS.ZX2200.TransportUnitSystem.Module.Information.BondPositionInfo","name":"BondPositionInfo","kind":"NamedType"},{"symbolId":"fcaf436bbb87c77762e22053","fileId":"3e628bb1e0b581aaf2d549e0","start":23,"end":23,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.TransportUnitSystem.Module.Information.BondPositionInfo.UpLookMatchResult1","name":"UpLookMatchResult1","kind":"Property"},{"symbolId":"48a594ea8c05b56238bd41db","fileId":"3e628bb1e0b581aaf2d549e0","start":23,"end":23,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.ZX2200.TransportUnitSystem.Module.Information.BondPositionInfo.get_UpLookMatchResult1","name":"get_UpLookMatchResult1","kind":"Method"},{"symbolId":"bdc4966cf63ab9291ce6abf5","fileId":"3e628bb1e0b581aaf2d549e0","start":23,"end":23,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.ZX2200.TransportUnitSystem