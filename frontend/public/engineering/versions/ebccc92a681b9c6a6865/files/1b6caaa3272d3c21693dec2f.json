KRSPoint3D();\r\n\r\n        /// <summary>\r\n        /// 槽位位置\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"槽位位置\", \"顶针设备参数\", UnitHelper.mm)]\r\n        public AKRSPoint3D[] SlotPosition { get; set; } = new AKRSPoint3D[5];\r\n\r\n        /// <summary>\r\n        /// 安全位置\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"顶针台安全位置\", \"顶针设备参数\", UnitHelper.mm)]\r\n        public AKRSPoint3D UpDownSafePosition { get; set; } = new AKRSPoint3D();\r\n\r\n        /// <summary>\r\n        /// 顶针座不剥离位置，弃用\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"顶针座不剥离位置（G0）\", \"顶针设备参数\", UnitHelper.mm)]\r\n        public AKRSPoint3D EjectionInseparablePos { get; set; } = new AKRSPoint3D(0, 0, 55);\r\n\r\n        /// <summary>\r\n        /// 气缸动作位置\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"固定气缸动作位置\", \"顶针设备参数\", UnitHelper.mm)]\r\n        public AKRSPoint3D CycActionPosition { get; set; } = new AKRSPoint3D();\r\n\r\n        /// <summary>\r\n        /// 顶针台mark位置\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"顶针台mark位置\", \"顶针设备参数\", UnitHelper.mm)]\r\n        public AKRSPoint3D UpDownMarkPosition { get; set; } = new AKRSPoint3D();\r\n\r\n        #endregion\r\n\r\n        /// <summary>\r\n        /// 是否使用顶针固定气缸\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"是否使用顶针固定气缸\", \"\")]\r\n        public bool IsUseEjectFixedCylinder { get; set; } = false;\r\n\r\n        /// <summary>\r\n        /// 是否使用硬件编辑器顶针轴设置参数\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"是否使用硬件编辑器顶针轴设置参数\", \"\")]\r\n        public bool IsUseEjectHardwarePara { get; set; } = false;\r\n\r\n        /// <summary>\r\n        /// 是否需要顶针回零\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"是否需要顶针回零\", \"\")]\r\n        public bool IsNeedEjectZero { get; set; } = false;\r\n\r\n        /// <summary>\r\n        /// 是否需要顶针台回零\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"是否需要顶针台回零\", \"\")]\r\n        public bool IsNeedEjectTableZero { get; set; } = false;\r\n\r\n        /// <summary>\r\n        /// 是否屏蔽顶针模组\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"是否屏蔽顶针模组\", \"\")]\r\n        public bool IsShieldEjectModule { get; set; } = false;\r\n\r\n        /// <summary>\r\n        /// 是否使用晶圆相机示教顶针中心\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"是否使用晶圆相机示教顶针中心\", \"\")]\r\n        public bool IsUseWaferCameraAssistantEjectCenter { get; set; } = true;\r\n    }\r\n}\r\n","lineCount":180,"compileIncluded":true,"assemblies":["AKRS.ZX2200"],"declarations":[{"symbolId":"6ae694f1f4595cf9d26aac97","fileId":"1b6caaa3272d3c21693dec2f","start":23,"end":178,"syntaxKind":"ClassDeclaration","label":"AKRS.ZX2200.WaferSubSystem.Models.DeviceParams.EjectDevicePara","name":"EjectDevicePara","kind":"NamedType"},{"symbolId":"5b9a3b812a0c589138570972","fileId":"1b6caaa3272d3c21693dec2f","start":32,"end":33,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.WaferSubSystem.Models.DeviceParams.EjectDevicePara.DelayFixedCycActionAfter","name":"DelayFixedCycActionAfter","kind":"Property"},{"symbolId":"abf1badbadc1e5ed17b2a5b0","fileId":"1b6caaa3272d3c21693dec2f","start":33,"end":33,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.ZX2200.WaferSubSystem.Models.DeviceParams.EjectDevicePara.get_DelayFixedCycActionAfter","name":"get_DelayFixedCycActionAfter","kind":"Method"},{"symbolId":"0aa51fb519bcc563be8097e0","fileId":"1b6caaa3272d3c21693dec2f","start":33,"end":33,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.ZX2200.WaferSubSystem.Models.DeviceParams.EjectDevicePara.set_DelayFixedCycActionAfter(System.Int32)","name":"set_DelayFixedCycActionAfter","kind":"Method"},{"symbolId":"4394566cbad82b9cce7a126f","fileId":"1b6caaa3272d3c21693dec2f","start":38,"end":39,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.WaferSubSystem.Models.DeviceParams.EjectDevicePara.DelayOpenEjectInhaleAfter","name":"DelayOpenEjectInhaleAfter","kind":"Property"},{"symbolId":"edda3d5cadf