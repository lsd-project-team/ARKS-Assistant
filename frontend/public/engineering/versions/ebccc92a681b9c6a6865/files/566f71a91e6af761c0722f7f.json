{"id":"566f71a91e6af761c0722f7f","path":"trunk/AKRS.ZX2200/TransportSystem/Models/DatasetModels/StockBin/LoaderBin.cs","moduleId":"f5d98dcbed588b315dfd7f6b","sha256":"efee13f34e0e0fb02ea488764223675fbebe75b3b10bba96d4f18914a06bc5dd","baselineSha256":"efee13f34e0e0fb02ea488764223675fbebe75b3b10bba96d4f18914a06bc5dd","current":true,"exists":true,"encoding":"utf-8","code":"using AKRS.ZX2200.Models;\r\n\r\nusing Newtonsoft.Json;\r\nusing System.Collections.Generic;\r\n\r\nnamespace AKRS.ZX2200.TransportSystem.Models.DatasetModels.StockBin\r\n{\r\n    using System;\r\n\r\n    using AKRS.ZX2200.Infrastructure.Models.BaseModels;\r\n    using AKRS.ZX2200.Infrastructure.Models.CommonModels;\r\n    using AKRS.ZX2200.Infrastructure.Models.Enums;\r\n    using AKRS.ZX2200.SupportFeature.Parameters.Model;\r\n    using System;\r\n\r\n    /// <summary>\r\n    /// 上料盒\r\n    /// </summary>\r\n    [Serializable]\r\n    public class LoaderBin : BaseDsSetting\r\n    {\r\n        /// <summary>\r\n        /// 构造函数\r\n        /// </summary>\r\n        public LoaderBin()\r\n        {\r\n           this.ResetAssistantStates();\r\n        }\r\n\r\n        /// <summary>\r\n        /// 第一层料片高度\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"第一层料片高度\", (string)null, false, \"mm\")]\r\n        public double FirstTabletLevel { get; set; }\r\n\r\n        /// <summary>\r\n        /// 最后一层料片高度\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"最后一层料片高度\", (string)null, false, \"mm\")]\r\n        public double LastTabletLevel { get; set; }\r\n\r\n        /// <summary>\r\n        /// 层数\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"层数\", (string)null, false, \"mm\")]\r\n        public double LayerNum { get; set; }\r\n\r\n        /// <summary>\r\n        /// 料片间距\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"料片间距\", (string)null, false, \"mm\")]\r\n        public double TabletPitch { get; set; } = 0;\r\n\r\n        /// <summary>\r\n        /// A料盒位置(Y向)\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"A料盒位置(Y向)\", (string)null, -10000, 10000, \"mm\")]\r\n        public double BinAPosY { get; set; }\r\n\r\n        /// <summary>\r\n        /// B料盒位置(Y向)\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"B料盒位置(Y向)\", (string)null, -10000, 10000, \"mm\")]\r\n        public double BinBPosY { get; set; }\r\n\r\n        /// <summary>\r\n        /// 推杆退料位(X向)\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"推杆退料位(X向)\", (string)null, -10000, 10000, \"mm\")]\r\n        public double PushPos { get; set; }\r\n\r\n        /// <summary>\r\n        /// Loader\r\n        /// </summary>\r\n        public AssistantState Loader { get; set; } =\r\n            new AssistantState() { Name = \"Loader\", State = AssistantStateEnum.UnAble };\r\n\r\n    /// <summary>\r\n    /// Loader是否示教完成\r\n    /// </summary>\r\n    [JsonIgnore]\r\n        public bool IsAssistantSucceed => this.GetAssistantResult();\r\n\r\n        /// <summary>\r\n        /// Loader是否示教完成\r\n        /// </summary>\r\n        /// <returns>return</returns>\r\n        private bool GetAssistantResult()\r\n        {\r\n            List<AssistantState> list = this.GetAssistantStates();\r\n            foreach (var item in list)\r\n            {\r\n                if (item.State == AssistantStateEnum.UnAble)\r\n                {\r\n                    return false;\r\n                }\r\n            }\r\n\r\n            return true;\r\n        }\r\n\r\n        /// <summary>\r\n        /// 获取Loader所有示教的状态\r\n        /// </summary>\r\n        /// <returns>return</returns>\r\n        public List<AssistantState> GetAssistantStates()\r\n        {\r\n            List<AssistantState> list = new List<AssistantState>();\r\n            list.Add(this.Loader);\r\n\r\n            return list;\r\n        }\r\n\r\n        /// <summary>\r\n        /// 初始化Loader示教状态\r\n        /// </summary>\r\n        public void ResetAssistantStates()\r\n        {\r\n            this.Loader = new AssistantState() { Name = \"Loader\", State = AssistantStateEnum.UnAble };\r\n        }\r\n    }\r\n}\r\n","lineCount":123,"compileIncluded":true,"assemblies":["AKRS.ZX2200"],"declarations":[{"symbolId":"b9fec97aa326f92b7a77b25a","fileId":"566f71a91e6af761c0722f7f","start":19,"end":121,"syntaxKind":"ClassDeclaration","label":"AKRS.ZX2200.TransportSystem.Models.DatasetModels.StockBin.LoaderBin","name":"LoaderBin","kind":"NamedType"},{"symbolId":"c06dda957edb66e80ab43cfb","fileId":"566f71a91e6af761c0722f7f","start":25,"end":28,"syntaxKind":"ConstructorDeclaration","label":"AKRS.ZX2200.TransportSystem.Models.DatasetModels.StockBin.LoaderBin.#ctor","name":".ctor","kind":"Method"},{"symbolId":"5d9f5ddcab9a5ff770971227","fileId":"566f71a91e6af761c0722f7f","start":33,"end":34,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.TransportSystem.Models.DatasetModels.StockBin.LoaderBin.FirstTabletLevel","name":"FirstTabletLevel","kind":"Property"},{"symbolId":"a973cdfb6b4adad9c43fe716","fileId":"566f71a91e6af761c0722f7f","start":34,"end":34,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.ZX2200.TransportSystem.Models.DatasetModels.StockBin.LoaderBin.get_FirstTabletLevel","name":"get_FirstTabletLevel","kind":"Method"},{"symbolId":"d741f4f208099d37d7654ac0","fileId":"566f71a91e6af761c0722f7f","start":34,"end":34,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.ZX2200.TransportSystem.Models.DatasetModels.StockBin.LoaderBin.set_FirstTabletLevel(System.Double)","name":"set_FirstTabletLevel","kind":"Method"},{"symbolId":"b9b6bb5863343e6ff278f6d4","fileId":"566f71a91e6af761c0722f7f","start":39,"end":40,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.TransportSystem.Models.DatasetModels.StockBin.LoaderBin.LastTabletLevel","name":"LastTabletLevel","kind":"Property"},{"symbolId":"e1d23d9a9711d4890ccabafe","fileId":"566f71a91e6af761c0722f7f","start":40,"end":40,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.ZX2200.TransportSystem.Models.Dataset