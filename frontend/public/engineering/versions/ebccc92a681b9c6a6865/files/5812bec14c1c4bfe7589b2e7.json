{"id":"5812bec14c1c4bfe7589b2e7","path":"trunk/AKRS.ZX2200/DispenseSystem/Models/DeviceParams/DispenseModulePara.cs","moduleId":"a3696dc5340b17ca1e9eb76c","sha256":"a9ceb5633959550ae803f3b963be4ec56927b86e216def91d4bd8d3dfa263529","baselineSha256":"a9ceb5633959550ae803f3b963be4ec56927b86e216def91d4bd8d3dfa263529","current":true,"exists":true,"encoding":"utf-8","code":"using System;\r\nusing System.Collections.Generic;\r\nusing System.Linq;\r\nusing System.Text;\r\nusing System.Threading.Tasks;\r\n\r\nnamespace AKRS.ZX2200.DispenseSystem.Models.DeviceParams\r\n{\r\n    using AKRS.Galaxy2.Infrastructure.CommonModel;\r\n    using AKRS.ZX2200.Infrastructure.AOP.Module;\r\n    using AKRS.ZX2200.SupportFeature.Parameters.Model;\r\n    using PropertyChanged;\r\n    using System.ComponentModel;\r\n\r\n    /// <summary>\r\n    /// 点胶模组参数\r\n    /// </summary>\r\n    [AddINotifyPropertyChangedInterface]\r\n    public class DispenseModulePara : PropertyChangeAop\r\n    {\r\n        /// <summary>\r\n        /// 到位之后的拍照延迟\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"拍照延迟\", null, 0, 10000, \"ms\")]\r\n        public int VisionDelay { get; set; } = 100;\r\n\r\n        /// <summary>\r\n        /// 气缸到位延迟\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"气缸未到位检测时间\", null, 0, 10000, \"ms\")]\r\n        public int CylinderDelay { get; set; } = 500;\r\n\r\n        /// <summary>\r\n        /// 激光测高到位后工作延时\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"激光测高到位后工作延时\", null, 0, 10000, \"ms\")]\r\n        public int LaserMhDelayTime { get; set; } = 200;\r\n\r\n        /// <summary>\r\n        /// 测高速度\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"测高速度\", null, 0, 500, \"mm/s\")]\r\n        public int MeasureHeightSpeed { get; set; } = 20;\r\n\r\n        /// <summary>\r\n        /// 测高距离平面开始距离\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"测高距离平面开始距离\", null, 0, 10, \"mm\")]\r\n        public double MeasureHeightDistance { get; set; } = 5;\r\n\r\n        /// <summary>\r\n        /// 缓慢下探的终点\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"测高下探行程\", null, 0, 10, \"mm\")]\r\n        public double MeasureHeightDownDistance { get; set; } = 3;\r\n\r\n        /// <summary>\r\n        /// 点胶测高跨越高度\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"点胶测高时跨越高度\", null, 0, 20, \"mm\")]\r\n        public double MeasureHeightCrossingHeights { get; set; } = 10;\r\n\r\n        /// <summary>\r\n        /// 测高报警距离\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"测高距离误差报警阈值\", null, 0, 5, \"mm\")]\r\n        public double MeasureHeightAlarmDistance { get; set; } = 1;\r\n\r\n        /// <summary>\r\n        /// 系统1的安全位置\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"系统1的安全位置(机械坐标)\", (string)null)]\r\n        public AKRSPoint3D SafePoint3D { get; set; } = new AKRSPoint3D(10, -10, 0);\r\n\r\n        /// <summary>\r\n        /// 蘸胶旋转速度\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"蘸胶旋转速度\", (string)null,\"转/分钟\")]\r\n        public double PrintSpinSpeed { get; set; } = 10;\r\n\r\n        /// <summary>\r\n        /// 系统1点胶胶压补偿\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"系统1点胶胶压补偿\", null, -100, 100, \"千帕\")]\r\n        public int GluePressCompensation { get; set; } = 0;\r\n\r\n        /// <summary>\r\n        /// 是否链接点胶器\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"点胶器通讯\", (string)null)]\r\n        public bool IsLinkDispenser { get; set; } = true;\r\n\r\n        /// <summary>\r\n        /// 点胶器最大胶压\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"点胶器最大胶压\", null, 200, 500, \"千帕\")]\r\n        public int DispenserMaxValue { get; set; } = 200;\r\n\r\n        /// <summary>\r\n        /// 点胶整体偏移量\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"点胶整体偏移量(单位为mm)\", (string)null)]\r\n        public AKRSPoint3D DispenseOffset { get; set; } = new AKRSPoint3D();\r\n\r\n        /// <summary>\r\n        /// 第一次点胶延迟\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"第一次点胶延迟\", null, 0, 100000, \"ms\")]\r\n        public int FisrtDispenseDelay { get; set; } = 0;\r\n    }\r\n}\r\n","lineCount":112,"compileIncluded":true,"assemblies":["AKRS.ZX2200"],"declarations":[{"symbolId":"b1ac19a3ad8bf0b94f26fe71","fileId":"5812bec14c1c4bfe7589b2e7","start":18,"end":110,"syntaxKind":"ClassDeclaration","label":"AKRS.ZX2200.DispenseSystem.Models.DeviceParams.DispenseModulePara","name":"DispenseModulePara","kind":"NamedType"},{"symbolId":"e62a49c83847cad9919054ae","fileId":"5812bec14c1c4bfe7589b2e7","start":24,"end":25,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.DispenseSystem.Models.DeviceParams.DispenseModulePara.VisionDelay","name":"VisionDelay","kind":"Property"},{"symbolId":"9e5eea925e14b9665d0801b4","fileId":"5812bec14c1c4bfe7589b2e7","start":25,"end":25,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.ZX2200.DispenseSystem.Models.DeviceParams.DispenseModulePara.get_VisionDelay","name":"get_VisionDelay","kind":"Method"},{"symbolId":"9ba058f5b111c94db4bdbf7e","fileId":"5812bec14c1c4bfe7589b2e7","start":25,"end":25,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.ZX2200.DispenseSystem.Models.DeviceParams.DispenseModulePara.set_VisionDelay(System.Int32)","name":"set_VisionDelay","kind":"Method"},{"symbolId":"a9fd6d2cc8ede1595fe291ea","fileId":"5812bec14c1c4bfe7589b2e7","start":30,"end":31,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.DispenseSystem.Models.DeviceParams.DispenseModulePara.CylinderDelay","name":"CylinderDelay","kind":"Property"},{"symbolId":"5942097f2a8f768631efbce1","fileId":"5812bec14c1c4bfe7589b2e7","start":31,"end":31,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.ZX2200.DispenseSystem.Models.DeviceParams.DispenseModulePara.get_CylinderDelay","name":"get_CylinderDelay","kind":"Method"},{"symbolId":"048f49c315afcdac9c77ba97","fileId":"5812bec14c1c4bfe7589b2e7","start":31,"end":31,"syntaxKind":"SetAccessorDeclaration","label":"AK