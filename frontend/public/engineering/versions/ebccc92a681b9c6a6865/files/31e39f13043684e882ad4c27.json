{"id":"31e39f13043684e882ad4c27","path":"trunk/AKRS.ZX2200/TransportUnitSystem/Module/Config/OppositeSex.cs","moduleId":"b629c57892dad9b04315dc8b","sha256":"578f6280ca830bd0ce1e67c2145dcebc77d9e63252d2cab9225db4d3587831a9","baselineSha256":"578f6280ca830bd0ce1e67c2145dcebc77d9e63252d2cab9225db4d3587831a9","current":true,"exists":true,"encoding":"utf-8","code":"using AKRS.Galaxy2.CoordinateSystems.CoordinateSystems;\r\nusing AKRS.ZX2200.TransportUnitSystem.Module.Matter;\r\nusing System;\r\nusing System.Collections.Generic;\r\nusing System.Linq;\r\nusing System.Text;\r\nusing System.Threading.Tasks;\r\n\r\nnamespace AKRS.ZX2200.TransportUnitSystem.Module.Config\r\n{\r\n    using AKRS.Galaxy2.Infrastructure.CommonModel;\r\n    using AKRS.ZX2200.TransportUnitSystem.Model;\r\n\r\n    using Newtonsoft.Json;\r\n\r\n    /// <summary>\r\n    /// 异性配置\r\n    /// </summary>\r\n    [Serializable]\r\n    public class OppositeSex\r\n    {\r\n        /// <summary>\r\n        /// 基板索引\r\n        /// </summary>\r\n        public int SubstrateId { get; set; }\r\n\r\n        /// <summary>\r\n        /// 基岛索引\r\n        /// </summary>\r\n        public int ModuleId { get; set; }\r\n\r\n         /// <summary>\r\n        /// 焊点索引\r\n        /// </summary>\r\n        public int BondPositionId { get; set; }\r\n\r\n        /// <summary>\r\n        /// 自己的索引\r\n        /// </summary>\r\n        public int Id { get; set; }\r\n\r\n        /// <summary>\r\n        /// 父类的索引\r\n        /// </summary>\r\n        public int ParentId { get; set; }\r\n\r\n        /// <summary>\r\n        /// 名称\r\n        /// </summary>\r\n        public string Name { get; set; }\r\n\r\n        /// <summary>\r\n        /// 配置文件的名称\r\n        /// </summary>\r\n        public string ConfigName { get; set; }\r\n\r\n        /// <summary>\r\n        /// 大小X\r\n        /// </summary>\r\n        public double SizeX { get; set; }\r\n\r\n        /// <summary>\r\n        /// 大小Y\r\n        /// </summary>\r\n        public double SizeY { get; set; }\r\n\r\n        /// <summary>\r\n        /// 中心对于参考点的偏移X\r\n        /// </summary>\r\n        public double CenterOffsetX { get; set; }\r\n\r\n        /// <summary>\r\n        /// 是否示教了位置\r\n        /// </summary>\r\n        public bool AssistantPos { get; set; } = false;\r\n\r\n        /// <summary>\r\n        /// 中心对于参考点的偏移Y\r\n        /// </summary>\r\n        public double CenterOffsetY { get; set; }\r\n\r\n        /// <summary>\r\n        /// 是否锁住\r\n        /// </summary>\r\n        public bool IsLock { get; set; } = true;\r\n\r\n        /// <summary>\r\n        /// 对上一层坐标系的偏移量\r\n        /// </summary>\r\n        public ElementCoordinate ElementCoordinate { get; set; } = new ElementCoordinate();\r\n\r\n        /// <summary>\r\n        /// 相对于上一层参考点的绝对位置\r\n        /// </summary>\r\n        public ElementCoordinate AbsoluteCoordinate { get; set; } = new ElementCoordinate();\r\n\r\n        /// <summary>\r\n        /// 相对于上一层中心点的绝对位置\r\n        /// </summary>\r\n        public ElementCoordinate AbsoluteCenterCoordinate { get; set; } = new ElementCoordinate();\r\n\r\n        /// <summary>\r\n        /// 下层配置文件\r\n        /// </summary>\r\n        public List<OppositeSex> DownConfigs { get; set; } = new List<OppositeSex>();\r\n\r\n        /// <summary>\r\n        /// 类型\r\n        /// </summary>\r\n        public EntityTypeEnum MatterTypeEnum { get; set; }\r\n\r\n        /// <summary>\r\n        /// 实体状态\r\n        /// </summary>\r\n        public MatterProductState MatterProductState { get; set; }\r\n\r\n        /// <summary>\r\n        /// 配置文件\r\n        /// </summary>\r\n        [JsonIgnore]\r\n        public OppositeSexConfig Config =>\r\n            this.GetConfig();\r\n\r\n        /// <summary>\r\n        /// 创建配置文件\r\n        /// </summary>\r\n        /// <returns>结果</returns>\r\n        private OppositeSexConfig GetConfig()\r\n        {\r\n            OppositeSexConfig oppositeSexConfig = ProductConfiguration.GetInstance().OppositeSexConfiguration.BaseConfigs.Find(it => it.Name == this.ConfigName);\r\n\r\n            if (oppositeSexConfig == null)\r\n            {\r\n                oppositeSexConfig = new OppositeSexConfig() { Name = this.ConfigName, EntityType = this.MatterTypeEnum };\r\n                ProductConfiguration.GetInstance().OppositeSexConfiguration.BaseConfigs.Add(oppositeSexConfig);\r\n                ProductConfiguration.GetInstance().Save();\r\n            }\r\n\r\n            return oppositeSexConfig;\r\n        }\r\n\r\n        /// <summary>\r\n        /// 获取默认名称\r\n        /// </summary>\r\n        /// <param name=\"name\">名称</param>\r\n        /// <returns>结果</returns>\r\n        public static string GetDefaultName(string name)\r\n        {\r\n            List<string> listName = ProductConfiguration.GetInstance().OppositeSexConfiguration.GetOppositeSexConfigs()\r\n                .Select(it => it.Name).ToList();\r\n            for (int i = 1; i < int.MaxValue; i++)\r\n            {\r\n                string newName = name + i.ToString();\r\n                if (listName.Exists(it => it == newName))\r\n                {\r\n                    continue;\r\n                }\r\n\r\n                return newName;\r\n            }\r\n\r\n            throw new Exception(\"名称超范围\");\r\n        }\r\n\r\n        /// <summary>\r\n        /// 是否存在名称\r\n        /// </summary>\r\n        /// <param name=\"name\">名称</param>\r\n        /// <returns>结果</returns>\r\n        public static bool IsExistName(string name)\r\n        {\r\n            return ProductConfiguration.GetInstance().OppositeSexConfiguration.GetOppositeSexConfigs()\r\n                .Exists(it => it.Name == name);\r\n        }\r\n\r\n        /// <summary>\r\n        /// 是否示教完成\r\n        /// </summary>\r\n        /// <returns>事件源</returns>\r\n        public bool AssistantSuccess()\r\n        {\r\n            if (this.MatterTypeEnum == EntityTypeEnum.BondPosition)\r\n            {\r\n                return this.Config.IsAfterBondAssistant && this.Config.IsEpoxyCheckAssistant\r\n                                                        && this.Config.IsMeasureHeightAssistant\r\n                                                        && this.Config.IsPrAssistant\r\n                                                        && this.AssistantPos;\r\n            }\r\n            else\r\n            {\r\n                if (this.DownConfigs.Count == 0)\r\n                {\r\n                    return false;\r\n                }\r\n\r\n                return !this.DownConfigs.Exists(it => !it.AssistantSuccess());\r\n            }\r\n        }\r\n\r\n        /// <summary>\r\n        /// 获取实体状态\r\n        /// </summary>\r\n        /// <returns>结果</returns>\r\n        public MatterProductState GetMatterProductState()\r\n        {\r\n            List<OppositeSex> list = this.GetOppositeSexList(this);\r\n\r\n            if (list.Exists(it => it.MatterTypeEnum == EntityTypeEnum.BondPosition && it.MatterProductState == MatterProductState.Enable))\r\n            {\r\n                return MatterProductState.Enable;\r\n            }\r\n            else\r\n            {\r\n                return MatterProductState.Disable;\r\n            }\r\n        }\r\n\r\n        /// <summary>\r\n        /// 设置实体状态\r\n        /// </summary>\r\n        /// <param name=\"matterProductState\">名称</param>\r\n        public void SetMatterProductState(MatterProductState matterProductState)\r\n        {\r\n            List<OppositeSex> list = this.GetOppositeSexList(this);\r\n\r\n            foreach (OppositeSex oppositeSex in list)\r\n            {\r\n                oppositeSex.MatterProductState = matterProductState;\r\n            }\r\n        }\r\n\r\n        /// <summary>\r\n        /// 获取集合\r\n        /// </summary>\r\n        /// <param name=\"oppositeSex\">配置对象</param>\r\n        /// <returns>结果</returns>\r\n        private List<OppositeSex> GetOppositeSexList(OppositeSex oppositeSex)\r\n        {\r\n            List<OppositeSex> list = new List<OppositeSex>();\r\n            list.Add(oppositeSex);\r\n            foreach (OppositeSex opposite in oppositeSex.DownConfigs)\r\n            {\r\n                list.AddRange(this.GetOppositeSexList(opposite));\r\n            }\r\n\r\n            return list;\r\n        }\r\n    }\r\n}\r\n","lineCount":250,"compileIncluded":true,"assemblies":["AKRS.ZX2200"],"declarations":[{"symbolId":"9a2754060ad9134979324229","fileId":"31e39f13043684e882ad4c27","start":19,"end":248,"syntaxKind":"ClassDeclaration","label":"AKRS.ZX2200.TransportUnitSystem.Module.Config.OppositeSex","name":"OppositeSex","kind":"NamedType"},{"symbolId":"33c4509410d2fb4589e29997","fileId":"31e39f13043684e882ad4c27","start":25,"end":25,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.TransportUnitSystem.Module.Config.OppositeSex.SubstrateId","name":"SubstrateId","kind":"Property"},{"symbolId":"1a49150ff1c6d313cd56fc11","fileId":"31e39f13043684e882ad4c27","start":25,"end":25,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.ZX2200.TransportUnitSystem.Module.Config.OppositeSex.get_SubstrateId","name":"get_SubstrateId","kind":"Method"},{"symbolId":"e4d133864537ee408b9b6215","fileId":"31e39f13043684e882ad4c27","start":25,"end":25,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.ZX2200.TransportUnitSystem.Module.Config.OppositeSex.set_SubstrateId(System.Int32)","name":"set_SubstrateId","kind":"Method"},{"symbolId":"54011b9bdaeab606fa64c147","fileId":"31e39f13043684e882ad4c27","start":30,"end":30,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.TransportUnitSystem.Module.Config.OppositeSex.ModuleId","name":"ModuleId","kind":"Property"},{"symbolId":"5422e2b9a9606ae84e1f84e5","fileId":"31e39f13043684e882ad4c27","start":30,"end":30,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.ZX2200.TransportUnitSystem.Module.Config.OppositeSex.get_ModuleId","name":"get_ModuleId","kind":"Method"},{"symbolId":"64fd170062aa77d7e0bee054","fileId":"31e39f13043684e882a