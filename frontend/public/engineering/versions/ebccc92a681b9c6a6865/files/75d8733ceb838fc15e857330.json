{"id":"75d8733ceb838fc15e857330","path":"trunk/AKRS.ZX2200/DispenseSystem/Models/DeviceParams/DispenserPara.cs","moduleId":"a3696dc5340b17ca1e9eb76c","sha256":"0c8c3fe7f3e133452f1562ab35c8d7f1d9d83b175c3b2736defa3fc6b90b0fa3","baselineSha256":"0c8c3fe7f3e133452f1562ab35c8d7f1d9d83b175c3b2736defa3fc6b90b0fa3","current":true,"exists":true,"encoding":"utf-8","code":"namespace AKRS.ZX2200.DispenseSystem.Models.DeviceParams\r\n{\r\n    using AKRS.Galaxy2.Infrastructure.CommonModel;\r\n    using AKRS.ZX2200.BondSystem.Models.Parameter;\r\n    using AKRS.ZX2200.Infrastructure.AOP.Module;\r\n    using AKRS.ZX2200.SupportFeature.Parameters.Model;\r\n    using PropertyChanged;\r\n\r\n    /// <summary>\r\n    /// 点胶头模块参数\r\n    /// </summary>\r\n    [AddINotifyPropertyChangedInterface]\r\n    public class DispenserPara : PropertyChangeAop\r\n    {\r\n        /// <summary>\r\n        /// 换胶水位置\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"换胶水的位置\", (string)null)]\r\n        public AKRSPoint3D ReplaceGluePosition { get; set; } = new AKRSPoint3D();\r\n\r\n        /// <summary>\r\n        /// 挤胶水位置\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"挤胶的位置\", (string)null)]\r\n        public AKRSPoint3D ThrustPosition { get; set; } = new AKRSPoint3D();\r\n\r\n        /// <summary>\r\n        /// 擦胶的位置\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"擦胶的位置\", (string)null)]\r\n        public AKRSPoint3D ErasePosition { get; set; } = new AKRSPoint3D();\r\n\r\n        /// <summary>\r\n        /// 标定相机中心和点胶头中心的差值的相机位\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"相机寻找点胶点的位置\", (string)null)]\r\n        public AKRSPoint3D VisionPosForCalibration { get; set; } = new AKRSPoint3D();\r\n\r\n        /// <summary>\r\n        /// 标定相机中心和点胶头中心的差值的挤胶和测高位\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"示教点胶头时的测高位置\", (string)null)]\r\n        public AKRSPoint3D DispenserMeasureHeightPos { get; set; } = new AKRSPoint3D();\r\n\r\n        /// <summary>\r\n        /// 蘸胶位置\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"蘸胶位置\", (string)null)]\r\n        public AKRSPoint3D PrintingToolPos { get; set; } = new AKRSPoint3D();\r\n\r\n        /// <summary>\r\n        /// 在示教点胶针的时候，点胶针在预点胶板上的出胶出胶时间\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"在示教点胶针时的挤胶时间\", (string)null, 0, 10000, \"ms\")]\r\n        public int AssistanceOpenDispenseTime { get; set; } = 500;\r\n\r\n        /// <summary>\r\n        /// 挤胶时的气压\r\n        /// </summary>\r\n        [TreeProgramListArgs(\"挤胶时的气压\", (string)null, 30, 500, \"千帕\")]\r\n        public int AssistanceOpenDispenseVacuum { get; set; } = 100;\r\n    }\r\n}\r\n","lineCount":64,"compileIncluded":true,"assemblies":["AKRS.ZX2200"],"declarations":[{"symbolId":"e680bf6e9d01b350ecf9681d","fileId":"75d8733ceb838fc15e857330","start":12,"end":62,"syntaxKind":"ClassDeclaration","label":"AKRS.ZX2200.DispenseSystem.Models.DeviceParams.DispenserPara","name":"DispenserPara","kind":"NamedType"},{"symbolId":"0904c341359b0a30b7378cac","fileId":"75d8733ceb838fc15e857330","start":18,"end":19,"syntaxKind":"PropertyDeclaration","label":"AKRS.ZX2200.DispenseSystem.Models.DeviceParams.DispenserPara.ReplaceGluePosition","name":"ReplaceGluePosition","kind":"Property"},{"symbolId":"6b44b4017540537b9306fac9","fileId":"75d8733ceb838fc15e857330","start":19,"end":19,"syntaxKind":"GetAccessorDeclaration","label":"AKRS.ZX2200.DispenseSystem.Models.DeviceParams.DispenserPara.get_ReplaceGluePosition","name":"get_ReplaceGluePosition","kind":"Method"},{"symbolId":"0846cef32cafba0c2563bb31","fileId":"75d8733ceb838fc15e857330","start":19,"end":19,"syntaxKind":"SetAccessorDeclaration","label":"AKRS.ZX2200.DispenseSystem.Models.DeviceParams.DispenserPara.set_ReplaceGluePosition(AKRS.Galaxy2.Infrastructure.CommonModel.AKRSPoint3D)","name":"set_ReplaceGluePosition","kind":"Method"},{"symbolId":"8350f57fa19c3ff7b4cd18e9","fileId":"75d8733ceb838fc15e857330","start":24,"end":25,"syntaxKind":"