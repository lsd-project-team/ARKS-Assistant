    private static void AddRow(TableLayoutPanel form, int row, string label, Control input, string unit)
    {
        var caption = new Label
        {
            Text = label,
            AutoSize = true,
            ForeColor = UiTheme.TextMain,
            Anchor = AnchorStyles.Left,
            Margin = new Padding(0, 8, 0, 0),
        };
        input.Anchor = AnchorStyles.Left;
        input.Width = 120;
        form.Controls.Add(caption, 0, row);
        form.Controls.Add(input, 1, row);
        if (!string.IsNullOrEmpty(unit))
        {
            form.Controls.Add(
                new Label
                {
                    Text = unit,
                    AutoSize = true,
                    ForeColor = UiTheme.TextMuted,
                    Anchor = AnchorStyles.Left,
                    Margin = new Padding(8, 8, 0, 0),
                },
                2,
                row);
        }
    }

    private Control BuildLogArea()
    {
        var frame = new FramePanel
        {
            Caption = "通信日志",
            Dock = DockStyle.Fill,
            Padding = new Padding(10, 24, 10, 10),
            Margin = Padding.Empty,
        };
        var host = new TableLayoutPanel
        {
            Dock = DockStyle.Fill,
            ColumnCount = 1,
            RowCount = 2,
            BackColor = UiTheme.CardBack,
        };
        host.RowStyles.Add(new RowStyle(SizeType.Percent, 100));
        host.RowStyles.Add(new RowStyle(SizeType.Absolute, 30));

        LogBox.Dock = DockStyle.Fill;
        LogBox.ReadOnly = true;
        LogBox.BorderStyle = BorderStyle.None;
        LogBox.BackColor = Color.White;
        LogBox.ForeColor = UiTheme.TextMain;
        LogBox.Font = new Font("Consolas", 9f);
        LogBox.ScrollBars = RichTextBoxScrollBars.Vertical;
        host.Controls.Add(LogBox, 0, 0);

        var toolbar = new FlowLayoutPanel
        {
            Dock = DockStyle.Fill,
            FlowDirection = FlowDirection.LeftToRight,
            WrapContents = false,
            BackColor = UiTheme.CardBack,
        };
        var clear = new Button { Text = "清空", Width = 60, Height = 24 };
        clear.Click += (_, _) => LogBox.Clear();
        var copy = new Button { Text = "复制", Width = 60, Height = 24 };
        copy.Click += (_, _) =>
        {
            if (LogBox.TextLength > 0)
            {
                Clipboard.SetText(LogBox.Text);
            }
        };
        var save = new Button { Text = "保存", Width = 60, Height = 24 };
        save.Click += (_, _) => SaveLog();
        var legend = new Label
        {
            Text = "发送 = 深蓝   接收 = 深绿   错误 = 深红",
            AutoSize = true,
            ForeColor = UiTheme.TextMuted,
            Margin = new Padding(16, 6, 0, 0),
        };
        toolbar.Controls.AddRange(new Control[] { clear, copy, save, legend });
        host.Controls.Add(toolbar, 0, 1);
        frame.Controls.Add(host);
        return frame;
    }

    private void SaveLog()
    {
        using var dialog = new SaveFileDialog
        {
            Filter = "文本文件 (*.txt)|*.txt",
            FileName = $"sp900-log-{DateTime.Now:yyyyMMdd-HHmmss}.txt",
        };
        if (dialog.ShowDialog(this) == DialogResult.OK)
        {
            File.WriteAllText(dialog.FileName, LogBox.Text, Encoding.UTF8);
        }
    }

    private void RebuildActions()
    {
        _actionHost.SuspendLayout();
        _actionHost.Controls.Clear();
        AddAction("connect", "连接", RibbonKind.Connect);
        if (Tabs.SelectedTab == _pageParams)
        {
            AddAction("test", "测试通信", RibbonKind.Test);
            AddAction("read", "读取参数", RibbonKind.Read);
            AddAction("set", "设置参数", RibbonKind.Write);
            AddAction("play", "执行点胶", RibbonKind.Play);
            AddAction("info", "设备信息", RibbonKind.Info);
        }
        else
        {
            AddAction("test", "测试通信", RibbonKind.Test);
            AddAction("alarm", "读报警", RibbonKind.Alarm);
            AddAction("standby", "写待机设置", RibbonKind.Standby);
            AddAction("zero", "计数清零", RibbonKind.Zero);
            AddAction("calibrate", "传感器校准", RibbonKind.Calibrate);
            AddAction("info", "设备信息", RibbonKind.Info);
        }
        _actionHost.ResumeLayout();
    }

    private void AddAction(string key, string text, RibbonKind kind)
    {
        var button = new RibbonButton { Name = key, Text = text, Kind = kind };
        button.Click += (_, _) => OnAction(key);
        _actionHost.Controls.Add(button);
    }

    /// <summary>业务动作入口：协议层实现后在这里接入对应指令。</summary>
    private void OnAction(string key)
    {
        HandleAction(key);
    }

    /// <summary>由 Actions.cs 实现：协议与按钮交互放在那里，布局保持骨架。</summary>
    partial void HandleAction(string key);

    internal void WriteLog(string text, Color color) => Log(text, color);

    internal void SetStatus(string text, Color color)
    {
        StatusLabel.Text = text;
        StatusLabel.ForeColor = color;
    }

    private void RefreshPorts()
    {
        PortBox.Items.Clear();
        string[] ports;
        try
        {
            ports = SerialPort.GetPortNames();
        }
        catch (Exception)
        {
            ports = Array.Empty<string>();
        }
        foreach (var port in ports)
        {
            PortBox.Items.Add(port);
        }
        if (PortBox.Items.Count == 0)
        {
            PortBox.Items.Add("无可用串口");
        }
        PortBox.SelectedIndex = 0;
        Log($"已刷新串口列表：{(ports.Length == 0 ? "无" : string.Join(", ", ports))}。", UiTheme.Grey);
    }

    private void Log(string text, Color color)
    {
        if (LogBox.IsDisposed)
        {
            return;
        }
        LogBox.SelectionStart = LogBox.TextLength;
        LogBox.SelectionColor = color;
        LogBox.AppendText($"[{DateTime.Now:HH:mm:ss.fff}] {text}\r\n");
        LogBox.SelectionColor = UiTheme.TextMain;
        LogBox.ScrollToCaret();
    }
}
